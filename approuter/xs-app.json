{
    "welcomeFile": "/index.html",
    "authenticationMethod": "none",
    "routes": [
        {
            "source": "^/[^/]+/resources/(.*)$",
            "target": "/resources/$1",
            "destination": "ui5cdn",
            "authenticationType": "none"
        },
        {
            "source": "^/resources/(.*)$",
            "target": "/resources/$1",
            "destination": "ui5cdn",
            "authenticationType": "none"
        },
        {
            "source": "^/sap/opu/odata/(.*)$",
            "target": "/sap/opu/odata/$1",
            "destination": "virtual-hr7-destination",
            "authenticationType": "none",
            "csrfProtection": false
        },
        {
            "source": "^(.*)$",
            "target": "$1",
            "service": "html5-apps-repo-rt",
            "authenticationType": "none"
        }
    ]
}
