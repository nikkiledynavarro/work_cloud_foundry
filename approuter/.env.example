# Sample environment file for approuter/hr7-proxy.js and approuter/server.js
# Copy this to approuter/.env (gitignored) and fill in your credentials.

# --- HR7 backend (default) ---
HR7_USER=your_hr7_user
HR7_PASS=your_hr7_password

# Optional HR7 overrides:
# HR7_HOST=10.10.1.76
# HR7_PORT=8001
# HR7_PROXY_PORT=5001
# HR7_PROXY_ALLOWED_ORIGIN=http://localhost:5000

# --- Local approuter (server.js) per-backend routing ---
# server.js publishes /hr7, /sls, /hd6 OData prefixes. Each prefix maps to a
# destination that points at a local proxy URL. By default all three point at
# the HR7 proxy on :5001 — override here to wire SLS and HD6 to their own
# proxies (run separate hr7-proxy-style processes on different ports, with
# matching SLS_*/HD6_* credentials).
#
# Set BACKEND to choose which destination handles the *unprefixed*
# /sap/opu/odata/... path (legacy bundles that don't include a prefix).
# Allowed values: hr7 | sls | hd6 — defaults to hr7.

BACKEND=hr7
# HR7_PROXY_URL=http://localhost:5001
# SLS_PROXY_URL=http://localhost:5002
# HD6_PROXY_URL=http://localhost:5003

# Credentials for separate proxies (only needed if you actually run them):
# SLS_USER=your_sls_user
# SLS_PASS=your_sls_password
# SLS_HOST=erps4sales.erp-is.com
# SLS_PORT=50000

# HD6_USER=your_hd6_user
# HD6_PASS=your_hd6_password
# HD6_HOST=s4hd6.erp-is.com
# HD6_PORT=8001
