{
    "version": "2.0.0",
    "tasks": [
        {
            "problemMatcher": [],
            "label": "Start HR7 Auth Proxy (port 5001)",
            "isBackground": true,
            "command": "node",
            "args": [
                "approuter/hr7-proxy.js"
            ],
            "type": "shell",
            "presentation": {
                "group": "ShipERP",
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "problemMatcher": [],
            "label": "Start Local Approuter (port 5000)",
            "isBackground": true,
            "command": "npm",
            "args": [
                "start"
            ],
            "type": "shell",
            "presentation": {
                "group": "ShipERP",
                "reveal": "always",
                "panel": "dedicated"
            },
            "options": {
                "cwd": "${workspaceFolder}/approuter"
            }
        },
        {
            "label": "🚀 Start ShipERP (Proxy + Approuter)",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "Start HR7 Auth Proxy (port 5001)",
                "Start Local Approuter (port 5000)"
            ],
            "problemMatcher": []
        },
        {
            "label": "Stop All (Windows)",
            "problemMatcher": [],
            "command": "for /f \"tokens=5\" %p in ('netstat -ano ^| findstr /R \":500[01][^0-9]\"') do @taskkill /F /PID %p 2>nul & echo Stopped listeners on :5000 and :5001",
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "type": "shell"
        },
        {
            "label": "Stop All (BAS/Linux)",
            "problemMatcher": [],
            "command": "sh",
            "args": [
                "-c",
                "for p in 5000 5001; do pid=$(lsof -ti tcp:$p 2>/dev/null); [ -n \"$pid\" ] && kill -9 $pid && echo \"Stopped :$p ($pid)\" || echo \":$p free\"; done"
            ],
            "type": "shell"
        },
