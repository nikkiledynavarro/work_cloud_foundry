<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
	<Dialog title="{/dialogTitle}">
		<Table class="sapUiTinyMargin border_lightgray_nobottom" width="500px" items="{/}">
			<columns>
				<Column hAlign="Center">
					<Text text="{i18n>APInvoiceNumber}" wrapping="false"/>
				</Column>
				<Column hAlign="Center">
					<Text text="{i18n>PostingDate}" wrapping="false"/>
				</Column>
				<Column hAlign="Center">
					<Text text="{i18n>Preview}" wrapping="false"/>
				</Column>
			</columns>
			<items>
				<ColumnListItem type="Inactive">
					<cells>
						<Text text="{path: 'ObjectKey', formatter: '.formatter.formatAPInvoiceNumberOnInvoiceListView'}"/>
					</cells>
					<cells>
						<Text text="{path: 'PostingDate', formatter: '.formatter.formatDateString'}"/>
					</cells>
					<cells>
						<Button icon="sap-icon://BusinessSuiteInAppSymbols/icon-segment-preview-reference-objects" tooltip="Preview" press="onPreviewAPInvoice"/>
					</cells>
				</ColumnListItem>
			</items>
		</Table>
		<beginButton>
			<Button text="{i18n>close}" press="onCloseDialogAPInvoiceNumber"/>
		</beginButton>
	</Dialog>
</core:FragmentDefinition>