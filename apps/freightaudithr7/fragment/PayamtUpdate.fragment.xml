<core:FragmentDefinition xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core">
	<Dialog title="{i18n>detailDialogPayamtTitle}" beforeClose="fnBeforeCloseDialog">
		<l:Grid defaultSpan="L12 M12 S12" width="auto">
			<l:content>
				<f:SimpleForm >
					<f:content>
						<Label text="{parts:['i18n>detailDialogPayamtLabel', 'local>/selectedInvoiceDetail/Currency'], formatter: 'jQuery.sap.formatMessage'}"/>
						<FlexBox direction="Column">
							<Input id="idPaymentAmountInput" liveChange="fnValidateNumberic" value="{local>/selectedInvoiceDetail/PayAmount}" required="true" type="Number"
								submit="onPayamtSave"/>
							<TextArea id="txtRemark" width="100%" rows="5" placeholder="{i18n>Remarks}" submit="onPayamtSave"></TextArea>
							<CheckBox editable="false" text="{i18n>Manual}" id="cbManual" selected="{local>/selectedInvoiceDetail/ManualPay}"/>
						</FlexBox>
					</f:content>
				</f:SimpleForm>
			</l:content>
		</l:Grid>
		<buttons>
			<Button text="{i18n>Reset}" press="onPayamtClear"/>
			<Button text="{i18n>Save}" press="onPayamtSave" type="Accept"/>
			<Button text="{i18n>Cancel}" press="onPayamtClose" type="Reject"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>