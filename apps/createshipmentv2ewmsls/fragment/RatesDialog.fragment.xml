<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:form="sap.ui.layout.form" xmlns:fiori="sap.f">
	<Dialog title="Carrier Rates" class="sapUiContentPadding" stretch="true">
		<content>
			<IconTabBar class="border_lightgray_nobottom sapUiNoContentPadding">
				<items>
					<IconTabFilter text="Rates">
						<ScrollContainer horizontal="true">
							<Table id="tableRates" items="{path: 'local>/Rates', sorter: { path: 'carrierid', descending: true } }" mode="SingleSelectLeft">
								<headerToolbar>
									<Toolbar>
										<Button icon="sap-icon://paid-leave" text="Pricing" tooltip="Pricing" press="onShowPricingDetail"/>
										<Button icon="sap-icon://restart" text="Analysis" tooltip="Analysis" press="onShowAnalysisDetail"/>
										<Button icon="sap-icon://detail-view" text="Details" tooltip="Details" press="onShowRateDetail"/>
									</Toolbar>
								</headerToolbar>
								<columns>
									<Column width="3rem">
										<Text text="Carrier"/>
									</Column>
									<Column width="8rem">
										<Text text="Name"/>
									</Column>
									<Column width="10rem">
										<Text text="Service"/>
									</Column>
									<Column width="10rem">
										<Text text="Name"/>
									</Column>
									<Column width="4rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
										<Text text="Rate"/>
									</Column>
									<Column width="4rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
										<Text text="List Rate"/>
									</Column>
									<Column width="4rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
										<Text text="Bill Rate"/>
									</Column>
									<Column width="4rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
										<Text text="Curr"/>
									</Column>
									<Column width="6rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
										<Text text="Transit Time"/>
									</Column>
									<Column width="6rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
										<Text text="Delivery Date"/>
									</Column>
									<Column width="3rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
										<Text text="Priority"/>
									</Column>
									<Column width="3rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
										<Text text="Zone"/>
									</Column>
									<Column width="4rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
										<Text text="Trans ID"/>
									</Column>
								</columns>
								<items>
									<ColumnListItem>
										<cells>
											<Text text="{local>carrierid}" wrapping="false" tooltip="{local>carrierid}"/>
											<Text text="{local>carriername}" wrapping="false" tooltip="{local>carriername}"/>
											<Text text="{local>serviceid}" wrapping="false" tooltip="{local>serviceid}"/>
											<Text text="{local>servicename}" wrapping="false" tooltip="{local>servicename}"/>
											<ObjectNumber number="{local>rate}" state="Success"/>
											<ObjectNumber number="{local>listrate}" state="Warning"/>
											<ObjectNumber number="{local>billablerate}" state="None"/>
											<Text text="{local>currency}"/>
											<Text text="{local>timeintransit}"/>
											<Text text="{path:'local>deliverydate', formatter: '.formatter.formatDateString'}"/>
											<Text text="{= parseInt(${local>priority})}" textAlign="Center"/>
											<Text text="{local>zone}"/>
											<Text text="{local>transactionid}"/>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</ScrollContainer>
					</IconTabFilter>
					<IconTabFilter text="Freight Units">
						<Table id="tableFreightUnits" items="{path: 'local>/RateFreightUnits'}" mode="None">
							<columns>
								<Column>
									<Text text="Weight" wrapping="false" tooltip="Weight"/>
								</Column>
								<Column>
									<Text text="Total Weight" wrapping="false" tooltip="Total Weight"/>
								</Column>
								<Column>
									<Text text="Total Dim Wght" wrapping="false" tooltip="Total Dim Weight"/>
								</Column>
								<Column>
									<Text text="Dim Weight" wrapping="false" tooltip="Dim Weight"/>
								</Column>
								<Column>
									<Text text="UoM" wrapping="false" tooltip="Weight UoM"/>
								</Column>
								<Column>
									<Text text="Length" wrapping="false" tooltip="Length"/>
								</Column>
								<Column>
									<Text text="Width" wrapping="false" tooltip="Width"/>
								</Column>
								<Column>
									<Text text="Height" wrapping="false" tooltip="Height"/>
								</Column>
								<Column>
									<Text text="UoM" wrapping="false" tooltip="Dimension UoM"/>
								</Column>
								<Column>
									<Text text="Quantity" wrapping="false" tooltip="Quantity"/>
								</Column>
								<Column>
									<Text text="Base UoM" wrapping="false" tooltip="Base UoM"/>
								</Column>
								<Column>
									<Text text="Net Value" wrapping="false" tooltip="Net Value"/>
								</Column>
								<Column>
									<Text text="Unit Price" wrapping="false" tooltip="Unit Price"/>
								</Column>
								<Column>
									<Text text="Currency" wrapping="false" tooltip="Currency"/>
								</Column>
								<Column>
									<Text text="HU No" wrapping="false" tooltip="Currency"/>
								</Column>
							</columns>
							<items>
								<ColumnListItem>
									<cells>
										<Text text="{local>Weight}" wrapping="false" tooltip="{local>Weight}"/>
										<Text text="{local>Totalweight}" wrapping="false" tooltip="{local>Totalweight}"/>
										<Text text="{local>Totaldimweight}" wrapping="false" tooltip="{local>Totaldimweight}"/>
										<Text text="{local>Dimweight}" wrapping="false" tooltip="{local>Dimweight}"/>
										<Text text="{local>Weightunit}" wrapping="false" tooltip="{local>Weightunit}"/>
										<Text text="{local>Laeng}" wrapping="false" tooltip="{local>Laeng}"/>
										<Text text="{local>Breit}" wrapping="false" tooltip="{local>Breit}"/>
										<Text text="{local>Hoehe}" wrapping="false" tooltip="{local>Hoehe}"/>
										<Text text="{local>Meabm}" wrapping="false" tooltip="{local>Meabm}"/>
										<Text text="{local>Qty}" wrapping="false" tooltip="{local>Qty}"/>
										<Text text="{local>Uom}" wrapping="false" tooltip="{local>Uom}"/>
										<Text text="{local>Netvalue}" wrapping="false" tooltip="{local>Netvalue}"/>
										<Text text="{local>Unitprice}" wrapping="false" tooltip="{local>Unitprice}"/>
										<Text text="{local>Currency}" wrapping="false" tooltip="{local>Currency}"/>
										<Text text="{path:'local>Freightunitkey', formatter: '.formatter.removeLeadingZero'}" wrapping="false" tooltip="{local>Freightunitkey}"/>
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</IconTabFilter>
					<IconTabFilter text="Errors ({local>/RateErrors/length})">
						<Table id="tableRateErrors" items="{path: 'local>/RateErrors'}" mode="None">
							<columns>
								<Column width="3rem">
									<Text text="Type"/>
								</Column>
								<Column width="6rem">
									<Text text="ID"/>
								</Column>
								<Column width="4rem">
									<Text text="Msg.No"/>
								</Column>
								<Column>
									<Text text="Text"/>
								</Column>
							</columns>
							<items>
								<ColumnListItem>
									<cells>
										<ObjectStatus text="{local>Type}" state="{= ${local>Type} === 'E' ? 'Error' : 'Warning' }" tooltip="{local>Type}"/>
										<Text text="{local>Id}" wrapping="false" tooltip="{local>Id}"/>
										<Text text="{local>Number}" wrapping="false" tooltip="{local>Number}"/>
										<Text text="{local>Message}" wrapping="false" tooltip="{local>Message}"/>
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</IconTabFilter>
				</items>
			</IconTabBar>
		</content>
		<beginButton>
			<Button text="{i18n>OK}" type="Emphasized" press="onRateSelected"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>Cancel}" press="onCloseRateDialog"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>