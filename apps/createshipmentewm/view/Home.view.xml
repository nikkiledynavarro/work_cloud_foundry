<mvc:View controllerName="com.erpis.shiperp.createshipmentewm.controller.Home" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core"
	xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Page showHeader="false">
		<FlexBox width="auto" height="100%" wrap="Wrap" justifyContent="Center" alignItems="Center"
			class="sapUiSmallMarginBegin sapUiSmallMarginEnd">
			<FlexBox direction="Column" wrap="Wrap" width="auto" height="auto" class="sapUiTinyMargin" justifyContent="Start" alignItems="Start">
				<f:SimpleForm backgroundDesign="Solid" editable="false" layout="ResponsiveGridLayout" title="Shipping Information" class="custom_login">
					<f:content>
						<Label text="Warehouse Number"/>
						<Input showValueHelp="true" id="txtWarehouseNumber" valueHelpRequest="onWarehouseNumberRequested" submit="onLogin"/>
						<Label text="Station"/>
						<Input showValueHelp="true" id="txtStation" valueHelpRequest="onShippingStationRequested" submit="onLogin"/>
						<Label text="Profile"/>
						<Input showValueHelp="true" id="txtProfile" valueHelpRequest="onShippingProfileRequested" submit="onLogin"/>
						<Button icon="sap-icon://visits" width="50%" text="LOGIN" class="sapUiSmallMarginTop" press="onLogin"></Button>
					</f:content>
				</f:SimpleForm>
			</FlexBox>
		</FlexBox>
	</Page>
</mvc:View>
