<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form"
	xmlns:table="sap.ui.table">
	<Dialog title="Packing Overview" class="sapUiContentPadding" stretch="false">
		<table:TreeTable selectionMode="MultiToggle" id="idPackOverViewTab"
			rows="{path:'local>/PackingOverviewList', parameters: {arrayNames:['Children'], numberOfExpandedLevels: 4} }" enableSelectAll="false"
			visibleRowCountMode="Interactive">
			<table:columns>
				<table:Column width="15rem">
					<Label text="Identification"/>
					<table:template>
						<FlexBox direction="Column">
							<Label text="{parts:['local>handlingUnit', 'local>itemNumber'], formatter: '.formatter.displayAndRemoveLeadingZero'}"
									design="{= ${local>state} !== undefined ? ${local>state} : 'Standard' }" visible="{= ${local>outermost} !== 'Success' ? true : false }"/>
							<ObjectStatus text="{parts:['local>handlingUnit', 'local>itemNumber'], formatter: '.formatter.displayAndRemoveLeadingZero'}"
									state="{local>outermost}" visible="{= ${local>outermost} === 'Success' ? true : false }" icon="sap-icon://product"/>
						</FlexBox>
					</table:template>
				</table:Column>
				<table:Column>
					<Label text="Material"/>
					<table:template>
						<Text text="{path: 'local>material', formatter: '.formatter.removeLeadingZero'}" wrapping="false" tooltip="{path: 'local>material'}"/>
					</table:template>
				</table:Column>
				<table:Column width="10rem">
					<Label text="Material Desc"/>
					<table:template>
						<Text text="{local>materialDescription}" tooltip="{local>materialDescription}"/>
					</table:template>
				</table:Column>
				<table:Column>
					<Label text="Delivery"/>
					<table:template>
						<Text text="{local>documentNumber}" tooltip="{local>documentNumber}"/>
					</table:template>
				</table:Column>
				<table:Column>
					<Label text="Delivery Item"/>
					<table:template>
						<Text text="{path: 'local>itemNumber', formatter: '.formatter.displayEmptyIfZero'}" tooltip="{local>itemNumber}"/>
					</table:template>
				</table:Column>
				<table:Column width="5rem">
					<Label text="Quantity"/>
					<table:template>
						<Text text="{path: 'local>quantity', formatter: '.formatter.displayEmptyIfZeroInt'}" tooltip="{local>quantity}"/>
					</table:template>
				</table:Column>
				<table:Column>
					<Label text="Unit"/>
					<table:template>
						<Text text="{local>unit}" tooltip="{local>unit}"/>
					</table:template>
				</table:Column>
				<table:Column>
					<Label text="NMFC Code"/>
					<table:template>
						<!--<Text text="{local>nmfc_code}" tooltip="{local>nmfc_code}"/>-->
						<Input id="idNMFCCode" value="{local>nmfcCode}"/>
					</table:template>
				</table:Column>
				<table:Column>
					<Label text="Freight Class"/>
					<table:template>
						<!--<Text text="{local>unit}" tooltip="{local>unit}"/>-->
						<Input id="idFreightClass" value="{local>freightClass}"/>
					</table:template>
				</table:Column>
			</table:columns>
		</table:TreeTable>
		<beginButton>
			<Button id= "btnUnpackItem" press="onUnpackItemPackingOverviewDialog" text="Unpack"/>
		</beginButton>
		<endButton>
			<Button press="onClosePackingOverviewDialog" text="Close"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>