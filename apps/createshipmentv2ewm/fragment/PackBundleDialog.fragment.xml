<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:form="sap.ui.layout.form">
	<Dialog title="Pack Bundle">
		<content>
			<form:Form width="100%" editable="true" visible="true">
				<form:formContainers>
					<form:FormContainer visible="true">
						<form:formElements>
							<form:FormElement visible="true">
								<form:label>
									<Label text="{i18n>PackMat}"/>
								</form:label>
								<form:fields>
									<Input id="txtPackMatBundle" submit="onPackBundleConfirm" showValueHelp="true" valueHelpRequest="onPackMatValueRequested"/>
								</form:fields>
							</form:FormElement>
							<form:FormElement visible="true">
								<form:label>
									<Label text="Storage Bin"/>
								</form:label>
								<form:fields>
									<Input id="txtStorageBinBundle" value="GI-ZONE" submit="onPackBundleConfirm"/>
								</form:fields>
							</form:FormElement>
						    <form:FormElement visible="true">
								<form:label>
									<Label text="Cons.Grp"/>
								</form:label>
								<form:fields>
									<Input id="txtConsGrpBundle" submit="onPackBundleConfirm"/>
								</form:fields>
							</form:FormElement>
							<!--<form:FormElement visible="true">-->
							<!--	<form:label>-->
							<!--		<Label text="{i18n>NoHus}"/>-->
							<!--	</form:label>-->
							<!--	<form:fields>-->
							<!--		<Input id="txtHUNoBundle" type="Number" submit="onPackBundleConfirm"/>-->
							<!--	</form:fields>-->
							<!--</form:FormElement>-->
						</form:formElements>
						<form:title/>
					</form:FormContainer>
				</form:formContainers>
				<form:layout>
					<form:ResponsiveGridLayout adjustLabelSpan="false" columnsL="2" labelSpanL="3" columnsM="1" labelSpanM="2" labelSpanS="12"/>
				</form:layout>
			</form:Form>
		</content>
		<beginButton>
			<Button text="{i18n>OK}" type="Emphasized" press="onPackBundleConfirm"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>Cancel}" press="onClosePackBundleDialog"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>