<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Dialog title="{i18n>hazmatDialogTitle}" class="sapUiContentPadding" contentWidth="70%" beforeClose="onHazmatDialogBeforeClose">
		<content>
			<Table id="hazmatTab" fixedLayout="false" mode="None" class="border_lightgray_nobottom" showSeparators="All" growing="false"
				items="{local>/FreightunitHazmats}">
				<headerToolbar>
					<Toolbar>
						<content>
							<Title text="{i18n>hazmatDialogTitle}" level="H2"/>
							<ToolbarSpacer/>
							<Button text="Add" press="onAddHazmatShowDialogPress"/>
						</content>
					</Toolbar>
				</headerToolbar>
				<columns>
					<Column width="2rem" hAlign="Center">
						<Text tooltip="{i18n>Status}"/>
					</Column>
					<Column width="2rem" hAlign="Center">
						<core:Icon tooltip="{i18n>Shipped}" src="sap-icon://shipping-status" color="green"/>
					</Column>
					<Column width="2rem" hAlign="Center">
						<core:Icon tooltip="{i18n>updatedColTitle}" src="sap-icon://activate" color="green"/>
					</Column>
					<Column width="2rem" hAlign="Center">
						<core:Icon tooltip="{i18n>selectedColTitle}" src="sap-icon://multi-select" color="green"/>
					</Column>
					<Column width="6rem" hAlign="Center">
						<Text tooltip="{i18n>Idnumber}" text="{i18n>Idnumber}"/>
					</Column>
					<Column width="6rem" hAlign="Center">
						<Text tooltip="{i18n>HUNumber}" text="{i18n>HUNumber}"/>
					</Column>
					<Column width="6rem" hAlign="Center">
						<Text tooltip="{i18n>DocumentId}" text="{i18n>DocumentId}"/>
					</Column>
					<Column width="6rem" hAlign="Center">
						<Text tooltip="{i18n>DocumentItemId}" text="{i18n>DocumentItemId}"/>
					</Column>
					<Column>
						<Text tooltip="{i18n>ShippingName}" text="{i18n>ShippingName}"/>
					</Column>
					<Column width="5rem" hAlign="Center">
						<Text tooltip="{i18n>HazClass}" text="{i18n>Class}"/>
					</Column>
					<Column width="5rem" hAlign="Center">
						<Text tooltip="{i18n>hazsubColTitleTooltip}" text="{i18n>hazsubColTitle}"/>
					</Column>
					<Column width="6rem" hAlign="Center">
						<Text tooltip="{i18n>packgroupColTitleTooltip}" text="{i18n>packgroupColTitle}"/>
					</Column>
					<Column width="6rem" hAlign="Center">
						<Text tooltip="{i18n>dgregulationColTitleTooltip}" text="{i18n>regulationColTitle}"/>
					</Column>
				</columns>
				<items >
					<ColumnListItem type="Inactive">
						<cells>
							<core:Icon color="{= (${local>Selected} === 'X' &amp;&amp; ${local>Icon} === '@08@')? 'green': 'orange'}"
								visible="{= (${local>Selected} === '' &amp;&amp; ${local>Updated} === '') ? false : true}"
								src="{= (${local>Selected} === 'X' &amp;&amp; ${local>Icon} === '@08@')? 'sap-icon://accept': 'sap-icon://warning'}"/>
							<!--<core:Icon color="{= (${local>Icon} === '@08@')? 'green': 'orange'}"-->
							<!--	visible="{= (${local>Icon} === '@08@') ? false : true}"-->
							<!--	src="{= (${local>Icon} === '@08@')? 'sap-icon://accept': 'sap-icon://warning'}"/>-->
							<CheckBox editable="false" selected="{= ${local>Shipped} === 'X' ? true : false}"/>
							<CheckBox editable="false" selected="{= ${local>Updated} === 'X' ? true : false}"/>
							<CheckBox selected="{= ${local>Selected} === 'X' ? true: false}" select="onHazmatSelectedChangePress"/>
							<Link text="{local>Idnumber}" press="onDotIDNumberLinkPress"/>
							<Text text="{path:'local>Exidv', formatter: '.formatter.removeLeadingZero'}"/>
							<Text text="{path:'local>DocumentId', formatter: '.formatter.removeLeadingZero'}"/>
							<Text text="{path:'local>DocumentItemId', formatter: '.formatter.removeLeadingZero'}"/>
							<Text text="{local>Propershipnam}" wrapping="false" tooltip="{local>Propershipnam}"/>
							<Text text="{local>Hazmatclass}"/>
							<Text text="{local>Hazmatsubclass}"/>
							<Text text="{local>Packinggroup}"/>
							<Text text="{local>Dgregulation}"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
			<VBox class="sapUiSmallMarginTop" id="hazmatDetailContainer">
				<FlexBox alignItems="End" justifyContent="SpaceBetween">
					<FlexBox direction="Column" class="sapUiTinyMarginEnd">
						<Label text="Actual Quantity"/>
						<Input value="{local>Actualqty}" liveChange="onCalculatResult" type="Number" id="actualqtyId"/>
					</FlexBox>
					<Label text="X" class="sapUiTinyMarginEnd"></Label>
					<FlexBox direction="Column" class="sapUiTinyMarginEnd">
						<Label text="No.of Container"/>
						<Input value="{local>Innercontainer}" liveChange="onCalculatResult" type="Number" id="noOfContainerId"/>
					</FlexBox>
					<Label text="=" class="sapUiTinyMarginEnd"></Label>
					<FlexBox direction="Column" class="sapUiTinyMarginEnd">
						<Label text="Result"/>
						<Input value="{local>Result}" editable="false" id="resultId"/>
					</FlexBox>
					<FlexBox direction="Column" class="sapUiTinyMarginEnd">
						<Label text="Act.UoM"/>
						<Input width="3rem" value="{local>Actualuom}" liveChange="onCheckHazmatChange"/>
					</FlexBox>
					<FlexBox direction="Column">
						<Label text="UoM Ind"/>
						<Input width="3rem" value="{local>Uomindicator}" liveChange="onCheckHazmatChange"/>
					</FlexBox>
				</FlexBox>
				<Panel expanded="true" expandAnimation="false" headerText="General Information"
					class="sapUiTinyMarginTop sapUiNoContentPadding border_lightgray_nobottom" expandable="true">
					<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="4"
						adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1"
						singleContainerFullSize="false">
						<f:content>
							<Label text="N.E.W / UoM"/>
							<Input value="{local>Dgnew}" id="cbDgnew" liveChange="onCheckHazmatChange"/>
							<Input value="{local>Dgnewuom}" id="cbDgnewuom" liveChange="onCheckHazmatChange"/>
							<Label text="Inner Pack Type"/>
							<ComboBox selectedKey="{local>Innerpackagetype}" items="{/xSERPERPxI_INNER_PACKAGE_TYP}" id="cbInnerPackType" change="onCheckHazmatChange">
								<core:Item key="{ValueKey}" text="{ValueKey}"/>
							</ComboBox>
							<Label text="Ship Type"/>
							<ComboBox selectedKey="{local>Dgshiptype}"
								items="{path: '/DomainTextSet', filters: [ {path: 'Domain', operator: 'EQ', value1: '/ERPIS/DOTSHIPTYPEDOM'} ]}" id="cbDgshiptype"
								change="onCheckHazmatChange">
								<core:Item key="{Key}" text="{Description}"/>
							</ComboBox>
							<Label text="Pack Qty"/>
							<Input value="{local>Packqty}" id="cbPackqty" liveChange="onCheckHazmatChange"/>
							<Label text="Authorization"/>
							<ComboBox selectedKey="{local>Auth}" items="{/xSERPERPxI_PCDGAUTH}" id="cbAuth" change="onAuthorizationChange">
								<core:Item key="{Auth}" text="{Auth} - {Bezei}"/>
							</ComboBox>
							<Label text="Proper Shipname"/>
							<Input value="{local>Propershipnam}" id="cbPropershipnam" liveChange="onCheckHazmatChange"/>
							<Label text="Technical Name"/>
							<Input value="{local>Propershipna2}" id="cbPropershipna2" liveChange="onCheckHazmatChange"/>
							<Label text="Label Text"/>
							<Input value="{local>Labeltext}" id="cbLabeltext" liveChange="onCheckHazmatChange"/>
							<Label text="Pack Type"/>
							<ComboBox selectedKey="{local>Packagetype}" items="{/xSERPERPxI_PCDGPACKTYP}" id="cbPackType" change="onCheckHazmatChange">
								<core:Item key="{Packagingtype}" text="{Packagingtype} - {Description}"/>
							</ComboBox>
							<Label text="Gross Weight"/>
							<Input value="{local>Packweight}" id="cbPackweight" liveChange="onCheckHazmatChange"/>
							<Input value="{local>Packuom}" id="cbPackuom" liveChange="onCheckHazmatChange"/>
							<Label text="Net Weight"/>
							<Input value="{local>Packnetweight}" id="cbPacknetweight" liveChange="onCheckHazmatChange"/>
							<Label text="Air Services"/>
							<ComboBox selectedKey="{local>Airservices}" change="onAuthorizationChange" id="cbAirservices"
								items="{path: '/DomainTextSet', filters: [ {path: 'Domain', operator: 'EQ', value1: '/ERPIS/HAZAIRSERVICES'} ]}">
								<core:Item key="{path: 'Key', formatter: '.formatter.removeLeadingZero'}" text="{Description}"/>
							</ComboBox>
							<Label text="Additional Handling"/>
							<Input value="{local>Hazaddhandling}" id="cbHazaddhandling" liveChange="onCheckHazmatChange"/>
							<Label text="Packing Group"/>
							<ComboBox selectedKey="{local>Packinggroup}" change="onCheckHazmatChange" id="cbPackinggroup"
								items="{path: '/DomainTextSet', filters: [ {path: 'Domain', operator: 'EQ', value1: '/ERPIS/DOM_PACKINGGROUP'} ]}">
								<core:Item key="{Key}" text="{Description}"/>
							</ComboBox>
							<Button text="Update" type="Emphasized" press="onHazmatUpdatePress"/>
							<Button text="Update Multiple" type="Emphasized" press="onUpdateMultiplePress"/>
						</f:content>
					</f:SimpleForm>
				</Panel>
				<!--<Panel headerText="{local>/Bindingcarriername} Hazmat Options " class="sapUiTinyMarginTop sapUiNoContentPadding border_lightgray_nobottom"-->
				<!--	expandable="true">-->
				<!--	<f:SimpleForm editable="true" layout="ResponsiveGridLayout" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1"-->
				<!--		singleContainerFullSize="false">-->
				<!--		<f:content>-->
				<!--			<List items="{ path: 'local>/BindingHazmatOpt', templateShareable: false, parameters: { expand: 'value_list/results' }}">-->
				<!--				<CustomListItem>-->
				<!--					<HBox>-->
				<!--						<Label text="{local>field_desc}" class="sapUiTinyMarginEnd"/>-->
				<!--						<ComboBox selectedKey="{local>field_value}" change="onHazmatOptionChange"-->
				<!--							items="{path: 'local>value_list/results', templateShareable: false}">-->
				<!--							<core:Item key="{local>Key}" text="{local>Value}"/>-->
				<!--						</ComboBox>-->
				<!--					</HBox>-->
				<!--				</CustomListItem>-->
				<!--			</List>-->
				<!--		</f:content>-->
				<!--	</f:SimpleForm>-->
				<!--</Panel>-->
				<Panel headerText="{local>/Bindingcarriername} Hazmat Options " id="idRenderFormHazmat"
					class="sapUiTinyMarginTop sapUiNoContentPadding border_lightgray_nobottom" expandable="true"></Panel>
				<Panel headerText="More Data" class="sapUiTinyMarginTop sapUiNoContentPadding border_lightgray_nobottom" expandable="true">
					<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="4"
						adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1"
						singleContainerFullSize="false">
						<f:content>
							<Label text="Hazmat Class"/>
							<Input value="{local>Hazmatclass}" liveChange="onCheckHazmatChange"/>
							<Label text="SubClass"/>
							<Input value="{local>Hazmatsubclass}" liveChange="onCheckHazmatChange"/>
							<Label text="Max Net qty/ pkg cargo/UoM"/>
							<Input value="{local>Maxcargoqty}"/>
							<Input value="{local>Maxcargouom}"/>
							<Label text="Packing Instructions"/>
							<Input value="{local>Packinstr}" liveChange="onCheckHazmatChange"/>
							<Label text="Max Net qty/ pkg Pas/Cargo/UoM"/>
							<Input value="{local>Maxpascargoqty}" liveChange="onCheckHazmatChange"/>
							<Input value="{local>Maxpascargouom}" liveChange="onCheckHazmatChange"/>
							<Label text="Max Limited Qty/UoM "/>
							<Input value="{local>Maxltdqty}" liveChange="onCheckHazmatChange"/>
							<Input value="{local>Maxltduom}" liveChange="onCheckHazmatChange"/>
							<Label text="Max Ground Qty/UoM"/>
							<Input value="{local>Maxgroundqty}" liveChange="onCheckHazmatChange"/>
							<Input value="{local>Maxgrounduom}" liveChange="onCheckHazmatChange"/>
							<Label text="Expected Qty Code"/>
							<Input value="{local>Eqcode}" liveChange="onCheckHazmatChange"/>
							<Label text="EQ Mass"/>
							<Input value="{local>eq_mass}" liveChange="onCheckHazmatChange"/>
							<Label text="EQ Volume"/>
							<Input value="{local>eq_volume}" liveChange="onCheckHazmatChange"/>
							<Label text="EQ Mass UoM"/>
							<Input value="{local>eq_massuom}" liveChange="onCheckHazmatChange"/>
							<Label text="EQ Volume UoM"/>
							<Input value="{local>eq_volumeuom}" liveChange="onCheckHazmatChange"/>
						</f:content>
					</f:SimpleForm>
				</Panel>
			</VBox>
		</content>
		<buttons>
			<Button text="Continue" type="Emphasized" press="onHazmatContinuePress"/>
			<Button press="onHazardousClose" text="{i18n>Cancel}"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>