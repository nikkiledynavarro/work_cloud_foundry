<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Dialog title="Request Routing" class="sapUiContentPadding">
		<content>
			<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="4"
				adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1"
				singleContainerFullSize="false">
				<f:content>
					<Label text="Email Address"/>
					<Input type="Text" value=""/>
					<Label text="Phone/Fax Number"/>
					<Input type="Tel" value=""/>
					<Input type="Text" value=""/>
					<Label text="URL"/>
					<Input type="Text" value=""/>
					<Label text="EDI"/>
					<CheckBox selected="true"/>
					<Label text="Early Pickup date"/>
					<DatePicker valueFormat="yyyy-MM-dd" displayFormat="long" displayFormatType="Islamic" change="handleChange"
						class="sapUiSmallMarginBottom"/>
					<Label text="Routing text"/>
					<Input type="Text" value=""/>
				</f:content>
			</f:SimpleForm>
		</content>
		<beginButton>
			<Button text="Create" type="Emphasized" press="onCreateFreightOrder"/>
		</beginButton>
		<endButton>
			<Button text="Cancel" press="onUpdateRequestRoutingClose"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>