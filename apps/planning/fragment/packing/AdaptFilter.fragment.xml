<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Dialog title="Adapt Filter" class="sapUiContentPadding">
		<content>
			<IconTabBar select="handleIconTabBarSelect" class="sapUiResponsiveContentPadding">
				<items>
					<IconTabFilter showAll="true" count="General" key="All">
						<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="4"
							adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1"
							singleContainerFullSize="false">
							<f:content>
								<Label text="Shipping Profile"/>
								<ComboBox >
									<items>
										<core:Item text="" key=""/>
									</items>
								</ComboBox>
								<Label text="Shipping Station"/>
								<ComboBox >
									<items>
										<core:Item text="" key=""/>
									</items>
								</ComboBox>
								<Label text="Shipping Point"/>
								<ComboBox >
									<items>
										<core:Item text="" key=""/>
									</items>
								</ComboBox>
								<Label text="Requested Del.Date"/>
								<DatePicker valueFormat="yyyy-MM-dd" displayFormat="long" displayFormatType="Islamic" change="handleChange" class="sapUiSmallMarginBottom"/>
							</f:content>
						</f:SimpleForm>
					</IconTabFilter>
					<IconTabSeparator/>
					<IconTabFilter icon="sap-icon://begin" iconColor="Positive" text="Sales Order Data" key="SOData">
						<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="4"
							adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1"
							singleContainerFullSize="false">
							<f:content>
								<Label text="Sales Document"/>
								<Input type="Text" value=""/>
								<Label text="Sales Organization"/>
								<ComboBox >
									<items>
										<core:Item text="" key=""/>
									</items>
								</ComboBox>
								<Label text="Division"/>
								<Input type="Text" value=""/>
								<Label text="Sales Document Type"/>
								<ComboBox >
									<items>
										<core:Item text="" key=""/>
									</items>
								</ComboBox>
								<Label text="Sold to Party"/>
								<Input type="Text" value=""/>
								<Label text="Shipping Condition"/>
								<Input type="Text" value=""/>
								<Label text="Route"/>
								<Input type="Text" value=""/>
								<Label text="Customer Reference"/>
								<Input type="Text" value=""/>
							</f:content>
						</f:SimpleForm>
					</IconTabFilter>
					<IconTabFilter icon="sap-icon://compare" iconColor="Critical" text="Delivery Data" key="DELData">
						<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="4"
							adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1"
							singleContainerFullSize="false">
							<f:content>
								<Label text="Delivery Document"/>
								<Input type="Text" value=""/>
								<Label text="Ship to Party"/>
								<Input type="Text" value=""/>
								<Label text="Delivery Document Type"/>
								<ComboBox >
									<items>
										<core:Item text="" key=""/>
									</items>
								</ComboBox>
								<Label text="Route"/>
								<ComboBox >
									<items>
										<core:Item text="" key=""/>
									</items>
								</ComboBox>
								<Label text="Customer Reference"/>
								<DatePicker valueFormat="yyyy-MM-dd" displayFormat="long" displayFormatType="Islamic" change="handleChange" class="sapUiSmallMarginBottom"/>
							</f:content>
						</f:SimpleForm>
					</IconTabFilter>
					<IconTabFilter icon="sap-icon://inventory" iconColor="Negative" text="Purches Ordder (STO) Data" key="POData">
						<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="4"
							adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1"
							singleContainerFullSize="false">
							<f:content>
								<Label text="Purchasing Document"/>
								<Input type="Text" value=""/>
								<Label text="Supplying Plant"/>
								<ComboBox >
									<items>
										<core:Item text="" key=""/>
									</items>
								</ComboBox>
								<Label text="Purchase Order Type"/>
								<ComboBox >
									<items>
										<core:Item text="" key=""/>
									</items>
								</ComboBox>
								<Label text="Route"/>
								<ComboBox >
									<items>
										<core:Item text="" key=""/>
									</items>
								</ComboBox>
								<Label text="Material"/>
