								<Label text="Batch"/>
								<Input type="Text" value=""/>
								<Label text="Delivery Date"/>
								<DatePicker valueFormat="yyyy-MM-dd" displayFormat="long" displayFormatType="Islamic" change="handleChange" class="sapUiSmallMarginBottom"/>
							</f:content>
						</f:SimpleForm>
					</IconTabFilter>
					<IconTabFilter icon="sap-icon://inventory" iconColor="Negative" text="Freight Unit/Freight Order Data" key="POData">
						<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="4"
							adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1"
							singleContainerFullSize="false">
							<f:content>
								<Label text="Source Location"/>
								<ComboBox >
									<items>
										<core:Item text="" key=""/>
									</items>
								</ComboBox>
								<Label text="Destination Location"/>
								<ComboBox >
									<items>
										<core:Item text="" key=""/>
									</items>
								</ComboBox>
								<Label text="ERP Document"/>
								<Input type="Text" value=""/>
								<Label text="Execution Status"/>
								<ComboBox >
									<items>
										<core:Item text="" key=""/>
									</items>
								</ComboBox>
								<Label text="Planning Status"/>
								<ComboBox >
									<items>
										<core:Item text="" key=""/>
									</items>
								</ComboBox>
								<Label text="Forwarding Order"/>
								<Input type="Text" value=""/>
								<Label text="Freight Unit"/>
								<Input type="Text" value=""/>
								<Label text="Requested Pickup Date"/>
								<DatePicker valueFormat="yyyy-MM-dd" displayFormat="long" displayFormatType="Islamic" change="handleChange" class="sapUiSmallMarginBottom"/>
							</f:content>
						</f:SimpleForm>
					</IconTabFilter>
				</items>
			</IconTabBar>
		</content>
		<beginButton>
			<Button text="Create" type="Emphasized" press="onCreateFreightOrder"/>
		</beginButton>
		<endButton>
			<Button text="Cancel" press="onCloseAdaptFilter"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>