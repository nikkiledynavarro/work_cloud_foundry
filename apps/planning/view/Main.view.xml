<mvc:View xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:uxap="sap.uxap" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1" controllerName="com.erpis.shiperp.planning.controller.Main" height="100%">
	<uxap:ObjectPageLayout id="ObjectPageLayout" showTitleInHeaderContent="false" toggleHeaderOnTitleClick="false" showHeaderContent="true" preserveHeaderStateOnScroll="false" headerContentPinnable="false" enableLazyLoading="false" showFooter="true" selectedSection="iconTabPacking">
		<uxap:headerContent>
			<l:VerticalLayout class="sapUiMediumMarginTop">
				<VBox>
					<FlexBox alignItems="Center">
						<Image class="sapUiSmallMarginEnd" src="{path: '', formatter: '.formatter.getTransparentLogoLink' }" height="1.5rem"/>
						<Select id="cbInputType" width="auto" class="margin_right_5px sapUiTinyMarginEnd" change="onInputTypeChange">
							<layoutData>
								<OverflowToolbarLayoutData priority="NeverOverflow"/>
							</layoutData>
							<items>
								<core:Item/>
							</items>
						</Select>
						<Input class="sapUiTinyMarginEnd" width="auto"/>
						<Button icon="sap-icon://reset" tooltip="Reset Data" type="Emphasized" press="onResetData" class="margin_right_5px"/>
					</FlexBox>
				</VBox>
				<l:HorizontalLayout allowWrapping="true" id="groupmstrip" class="sapUiTinyMarginTop">
					<l:VerticalLayout class="sapUiMediumMarginEnd">
						<MessageStrip text="{local>/basic/carrier_data/CarrierName} - {local>/Header/ServiceName}" visible="{= ${local>/basic} ? true : false }" id="mstripCarrier" type="Warning"/>
					</l:VerticalLayout>
					<l:VerticalLayout class="sapUiMediumMarginEnd">
						<MessageStrip visible="{= ${local>/basic} ? true : false }" id="mstripBilling" type="Warning" text="{parts:['local>/basic/payment/billing_option', 'local&gt;/Header/BillingOption', 'local&gt;/basic/payment/thirdpartyacct/account', 'local&gt;/basic/payment/thirdpartyacct/zip'], formatter: '.formatter.formatBillingHeader'}"/>
					</l:VerticalLayout>
					<l:VerticalLayout class="sapUiMediumMarginEnd">
						<MessageStrip visible="{= ${local>/basic} ? true : false }" type="Warning" text="{local>/basic/partners/shipto/address/name1} - {local>/basic/partners/shipto/address/city} - {local>/Header/ShipToState} - {local>/basic/partners/shipto/address/postalcode} - {local>/Header/ShipToCountry}"/>
					</l:VerticalLayout>
				</l:HorizontalLayout>
			</l:VerticalLayout>
			<l:HorizontalLayout class="sapUiMediumMarginTop btn-btngroup">
				<OverflowToolbarButton class="sapUiTinyMarginEnd" icon="sap-icon://create" enabled="{= ${local>/basic} ? true : false }" press="onRateShopClick" tooltip="Rate Quote"/>
				<OverflowToolbarButton class="sapUiTinyMarginEnd" icon="sap-icon://product" enabled="{= ${local>/basic} ? true : false }" press="onOptimizationClick" tooltip="Pack"/>
				<OverflowToolbarButton class="sapUiTinyMarginEnd" id="idReprintBtn" press="onReprint" icon="sap-icon://wrench" tooltip="Consolidate"/>
				<OverflowToolbarButton icon="sap-icon://sys-cancel" tooltip="Cancel" type="Reject" press="onCrossNavigate" app:crossNavigate="#Cancel-display"/>
				<Button icon="sap-icon://filter" text="Adapt Filter" tooltip="Adapt Filter" type="Default" press="onFilter" class="sapUiTinyMarginBegin"/>
			</l:HorizontalLayout>
		</uxap:headerContent>
		<uxap:sections>
			<uxap:ObjectPageSection id="iconTabPacking">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="Planning">
						<uxap:blocks>
							<core:Fragment class="sapUiSizeCompact" fragmentName="com.erpis.shiperp.planning.fragment.packing.ItemsPacking" type="XML"/>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
		</uxap:sections>
		<uxap:footer>
			<OverflowToolbar id="otbFooter">
				<Button id="popoverButton" icon="sap-icon://message-popup" text="{messageModel>/messagesLength}" type="Emphasized" press="handleMessagePopoverPress"/>
				<ToolbarSpacer/>
				<Button id="idShipmentBtn" press="onExecute" icon="sap-icon://shipping-status" enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }" type="Accept" text="Ship"/>
			</OverflowToolbar>
		</uxap:footer>
	</uxap:ObjectPageLayout>
</mvc:View>