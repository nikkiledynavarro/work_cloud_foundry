<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
	<Dialog icon="sap-icon://information" class="sapUiContentPadding" contentWidth="500px">
		<content>
			<Table class="border_lightgray_nobottom" showSeparators="All" growing="false"
				items="{path: 'local>/ShipmentContans', templateShareable:false}">
				<columns>
					<Column width="5rem">
						<Text text="Shipment Contains Hazmat Material"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{local>Maktx}"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
			<Table class="border_lightgray_nobottom" showSeparators="All" growing="false"
				items="{path: 'local>/MessageDetail', templateShareable:false}">
				<columns>
					<Column width="5rem">
						<Text text=""/>
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{local>Message}"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<beginButton>
			<Button text="Display Report" press="onDisplayReport"/>
		</beginButton>
		<endButton>
			<Button text="Cancel" press="onCloseHazmatMaterial"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>