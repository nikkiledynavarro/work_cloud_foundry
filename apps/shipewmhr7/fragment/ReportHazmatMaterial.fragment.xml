<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form"
	xmlns:table="sap.ui.table">
	<Dialog title="DG Class and Subclass incompatibilitties found by law or carrier" class="sapUiContentPadding" stretch="false">
		<table:TreeTable title="By Shipment" selectionMode="MultiToggle" id="idPackOverVikkkewTab"
			rows="{path:'local>/BindingByShipment', parameters: {countMode: 'Inline', numberOfExpandedLevels: 1, arrayNames:['results']} }"
			enableSelectAll="false" visibleRowCountMode="Interactive">
			<table:columns>
				<table:Column width="10rem">
					<Label text="Material"/>
					<table:template>
						<FlexBox direction="Column">
							<Label text="{parts:['local>information', 'local>matnr'], formatter: '.formatter.displayAndRemoveLeadingZero'}"/>
							<!--<ObjectStatus text="{parts:['local>handling_unit', 'local>item_number'], formatter: '.formatter.displayAndRemoveLeadingZero'}"-->
							<!--	state="{local>outermost}" visible="{= ${local>outermost} === 'Success' ? true : false }" icon="sap-icon://product"/>-->
						</FlexBox>
					</table:template>
				</table:Column>
				<table:Column width="6rem">
					<Label text="Ship Name"/>
					<table:template>
						<Text text="{local>propershipnam}" wrapping="false" tooltip="{local>propershipnam}"/>
					</table:template>
				</table:Column>
				<table:Column width="6rem">
					<Label text="Haz class"/>
					<table:template>
						<Text text="{local>hazmatclass}" tooltip="{local>hazmatclass}"/>
					</table:template>
				</table:Column>
				<table:Column width="6rem">
					<Label text="DG Subcls"/>
					<table:template>
						<Text text="{local>hazmatsubclass}" tooltip="{local>hazmatsubclass}"/>
					</table:template>
				</table:Column>
				<table:Column width="6rem">
					<Label text="DG ID No"/>
					<table:template>
						<Text text="{local>idnumber}" tooltip="{local>idnumber}"/>
					</table:template>
				</table:Column>
				<table:Column width="6rem">
					<Label text="Pack Group"/>
					<table:template>
						<Text text="{local>packinggroup}" tooltip="{local>packinggroup}"/>
					</table:template>
				</table:Column>
				<table:Column width="4rem">
					<Label text="DG Reg."/>
					<table:template>
						<Text text="{local>dgregulation}" tooltip="{local>dgregulation}"/>
					</table:template>
				</table:Column>
			</table:columns>
		</table:TreeTable>
		<table:TreeTable title="By HU" selectionMode="MultiToggle" id="idPackpppOewTab"
			rows="{path:'local>/BindingHu', parameters: { countMode: 'Inline', numberOfExpandedLevels: 2, arrayNames:['results']}}"
			enableSelectAll="false" visibleRowCountMode="Interactive">
			<table:columns>
				<table:Column width="10rem">
					<Label text="Freight Units/Material"/>
					<table:template>
						<FlexBox direction="Column">
							<Label text="{parts:['local>information', 'local>matnr'], formatter: '.formatter.displayAndRemoveLeadingZero'}"/>
							<!--<ObjectStatus text="{parts:['local>freightunitkey', 'local>matnr'], formatter: '.formatter.displayAndRemoveLeadingZero'}"-->
							<!--	state="{local>outermost}" visible="{= ${local>outermost} === 'Success' ? true : false }" icon="sap-icon://product"/>-->
						</FlexBox>
					</table:template>
				</table:Column>
				<table:Column width="6rem">
					<Label text="Ship Name"/>
					<table:template>
						<Text text="{local>propershipnam}" wrapping="false" tooltip="{local>propershipnam}"/>
					</table:template>
				</table:Column>
				<table:Column width="6rem">
					<Label text="Haz class"/>
					<table:template>
						<Text text="{local>hazmatclass}" tooltip="{local>hazmatclass}"/>
					</table:template>
				</table:Column>
				<table:Column width="6rem">
					<Label text="DG Subcls"/>
					<table:template>
						<Text text="{local>hazmatsubclass}" tooltip="{local>hazmatsubclass}"/>
					</table:template>
				</table:Column>
				<table:Column width="6rem">
					<Label text="DG ID No"/>
					<table:template>
						<Text text="{local>idnumber}" tooltip="{local>idnumber}"/>
					</table:template>
				</table:Column>
				<table:Column width="6rem">
					<Label text="Pack Group"/>
					<table:template>
						<Text text="{local>packinggroup}" tooltip="{local>packinggroup}"/>
					</table:template>
				</table:Column>
				<table:Column width="4rem">
					<Label text="DG Reg."/>
					<table:template>
						<Text text="{local>dgregulation}" tooltip="{local>dgregulation}"/>
					</table:template>
				</table:Column>
			</table:columns>
		</table:TreeTable>
		<endButton>
			<Button press="onCloseReportHazmatDetail" text="Close"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>