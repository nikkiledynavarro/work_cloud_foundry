<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns:uxap="sap.uxap" xmlns:layout="sap.ui.layout" xmlns:form="sap.ui.layout.form"
	xmlns:core="sap.ui.core" xmlns="sap.m" controllerName="com.erpis.shiperp.freightorder.controller.RequestRouting"
	xmlns:html="http://www.w3.org/1999/xhtml" height="100%">
	<uxap:ObjectPageLayout id="ObjectPageLayout" showFooter="true" showTitleInHeaderContent="false" upperCaseAnchorBar="false">
		<uxap:headerTitle>
			<uxap:ObjectPageDynamicHeaderTitle>
				<uxap:expandedHeading>
					<FlexBox alignItems="Center" fitContainer="true">
						<Image class="sapUiSmallMarginEnd" src="{path: '', formatter: '.formatter.getTransparentLogoLink' }" height="1.5rem"/>
						<Title text="{i18n>requestRoutingTitle}" wrapping="true"/>
					</FlexBox>
				</uxap:expandedHeading>
				<uxap:snappedHeading>
					<FlexBox alignItems="Center" fitContainer="true">
						<Image class="sapUiSmallMarginEnd" src="{path: '', formatter: '.formatter.getTransparentLogoLink' }" height="1.5rem"/>
						<Title text="{i18n>requestRoutingTitle}" wrapping="true"/>
					</FlexBox>
				</uxap:snappedHeading>
			</uxap:ObjectPageDynamicHeaderTitle>
		</uxap:headerTitle>
		<uxap:headerContent>
			<VBox>
				<form:SimpleForm id="SimpleFormHeader" editable="true" layout="ResponsiveGridLayout" title="" labelSpanXL="4" labelSpanL="3" labelSpanM="4"
					labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1"
					singleContainerFullSize="false">
					<form:content>
						<core:Title text=""/>
						<Label text="{i18n>requestRoutingEmailAddress}"/>
						<Input value="{local>/RequestRoutingBasic/Email}"/>
						<Label text="{i18n>requestRoutingPhoneFax}"/>
						<Input value="{local>/RequestRoutingBasic/Phone}">
							<layoutData>
								<layout:GridData span="XL2 L1 M3 S4"/>
							</layoutData>
						</Input>
						<Input value="{local>/RequestRoutingBasic/Fax}"/>
						<Label text="{i18n>requestRoutingURL}"/>
						<Input value="{local>/RequestRoutingBasic/URL}"/>
						<Label text="{i18n>requestRoutingRoutingText}"/>
						<Input value="{local>/RequestRoutingBasic/Text}"/>
						<core:Title text=""/>
						<Label text="{i18n>requestRoutingEDI}"/>
						<CheckBox selected="{= ${local>/RequestRoutingBasic/EDI} === 'X' ? true : false}" select="onChangeEDI"/>
						<Label text="{i18n>requestRoutingEarlyPickupDate}"/>
						<DatePicker value="{local>/RequestRoutingBasic/PickupDate}" placeholder="{i18n>requestRoutingEnterDatePLaceHolder}"
							change="handleChange" class="sapUiSmallMarginBottom"/>
					</form:content>
				</form:SimpleForm>
			</VBox>
		</uxap:headerContent>
		<uxap:sections>
			<uxap:ObjectPageSection titleUppercase="false" title="Routing Request Details">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="Freight Order Header Details" titleUppercase="false">
						<uxap:blocks>
							<core:Fragment fragmentName="com.erpis.shiperp.freightorder.fragment.requestrouting.RequestRoutingFOHeaderDetails" type="XML"/>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection titleUppercase="false" title="Partners">
				<uxap:ObjectPageSubSection title="Partners" titleUppercase="false">
					<uxap:blocks>
						<core:Fragment fragmentName="com.erpis.shiperp.freightorder.fragment.requestrouting.RequestRoutingFOPartners" type="XML"/>
					</uxap:blocks>
				</uxap:ObjectPageSubSection>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection titleUppercase="false" title="Freight Order Content Details">
				<uxap:ObjectPageSubSection title="Freight Order Content Details" titleUppercase="false">
					<uxap:blocks>
						<core:Fragment fragmentName="com.erpis.shiperp.freightorder.fragment.requestrouting.RequestRoutingFOContentDetail" type="XML"/>
					</uxap:blocks>
				</uxap:ObjectPageSubSection>
			</uxap:ObjectPageSection>
		</uxap:sections>
		<!-- Footer-->
		<uxap:footer>
			<OverflowToolbar>
				<Button id="popoverButton" icon="sap-icon://message-popup" text="{messageModel>/messagesLength}" type="Emphasized"
					press="handleMessagePopoverPress"/>
				<ToolbarSpacer/>
				<Button text="{i18n>backToFOScreenButton}" press="onNavBackToFreightOrderScreen" type="Emphasized"/>
				<Button text="{i18n>sendMailButton}" icon="sap-icon://email" press="onSendEmailPressed" type="Emphasized"/>
			</OverflowToolbar>
		</uxap:footer>
	</uxap:ObjectPageLayout>
</mvc:View>