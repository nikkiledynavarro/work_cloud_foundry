<mvc:View controllerName="com.erpis.shiperp.freightorder.controller.FreightOrderDetail" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:layout="sap.ui.layout" xmlns:ui="sap.ui.table">
	<f:DynamicPage showFooter="true">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<FlexBox alignItems="Center" justifyContent="Center">
						<Title text="{i18n>freightOrderDetailTitle} {local>/FreightOrderNumber}"/>
					</FlexBox>
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<ui:TreeTable id="TreeTableBasic" rows="{path:'local>/FreightOrderItem', parameters: {arrayNames:['orderitems']}}" selectionMode="None"
				enableSelectAll="false" ariaLabelledBy="title">
				<ui:columns>
					<ui:Column width="25rem">
						<Label text="{i18n>freightOrderDetailIdenCol}"/>
						<ui:template>
							<ObjectStatus xmlns="sap.m" state="{path: 'local>ItemCat', formatter: '.formatter.formatFOItemCategoryState'}" text="{local>ItemId}"
								icon="{path: 'local>ItemCat', formatter: '.formatter.formatFOItemCategoryIcon'}"/>
						</ui:template>
					</ui:Column>
					<ui:Column>
						<Label text="{i18n>freightOrderDetailProdCol}"/>
						<ui:template>
							<Text text="{local>Product}" wrapping="false"/>
						</ui:template>
					</ui:Column>
					<ui:Column>
						<Label text="Desc"/>
						<ui:template>
							<Text text="{local>ProductDesc}" wrapping="false"/>
						</ui:template>
					</ui:Column>
					<ui:Column >
						<Label text="{i18n>freightOrderDetailQtyCol}"/>
						<ui:template>
							<Text text="{path: 'local>Quantity', formatter: '.formatter.formatAmountQty'}" wrapping="false"/>
						</ui:template>
					</ui:Column>
					<ui:Column>
						<Label text="{i18n>freightOrderDetailUoMCol}"/>
						<ui:template>
							<Text text="{local>UoM}" wrapping="false"/>
						</ui:template>
					</ui:Column>
					<ui:Column>
						<Label text="{i18n>freightOrderDetailGWCol}"/>
						<ui:template>
							<Text text="{path: 'local>GrossWeight', formatter: '.formatter.formatAmountQty'}" wrapping="false"/>
						</ui:template>
					</ui:Column>
					<ui:Column>
						<Label text="{i18n>freightOrderDetailGWUomCol}"/>
						<ui:template>
							<Text text="{local>GrossWeightUoM}" wrapping="false"/>
						</ui:template>
					</ui:Column>
				</ui:columns>
			</ui:TreeTable>
		</f:content>
		<f:footer>
			<OverflowToolbar>
				<Button id="popoverButton" icon="sap-icon://message-popup" text="{messageModel>/messagesLength}" type="Emphasized"
					press="handleMessagePopoverPress"/>
				<ToolbarSpacer/>
				<Button text="{i18n>freightOrderBacktoFOScreenBtn}" press="onNavBackToFreightOrderScreen"/>
			</OverflowToolbar>
		</f:footer>
	</f:DynamicPage>
</mvc:View>