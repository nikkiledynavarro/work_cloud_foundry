<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
	<Table inset="false" items="{ path: 'local>/RequestRoutingContents'}">
		<columns>
			<Column minScreenWidth="Tablet" demandPopin="true">
				<Text text="{i18n>requestRoutingTotalWeight}"/>
			</Column>
			<Column minScreenWidth="Tablet" demandPopin="true">
				<Text text="{i18n>requestRoutingTotalWeightUoM}"/>
			</Column>
			<Column minScreenWidth="Desktop" demandPopin="true" hAlign="End">
				<Text text="{i18n>requestRoutingVolume}"/>
			</Column>
			<Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center">
				<Text text="{i18n>requestRoutingVolumeUoM}"/>
			</Column>
			<Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center">
				<Text text="{i18n>requestRoutingIncoterm}"/>
			</Column>
			<Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center">
				<Text text="{i18n>requestRoutingPalletCount}"/>
			</Column>
			<Column minScreenWidth="Tablet" demandPopin="true">
				<Text text="{i18n>requestRoutingCartonCount}"/>
			</Column>
			<Column minScreenWidth="Desktop" demandPopin="true" hAlign="End">
				<Text text="{i18n>requestRoutingPieces}"/>
			</Column>
			<Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center">
				<Text text="{i18n>requestRoutingTenderStatus}"/>
			</Column>
			<Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center">
				<Text text="{i18n>requestRoutingNMFCCoder}"/>
			</Column>
			<Column hAlign="End">
				<Text text="{i18n>requestRoutingFreightClasses}"/>
			</Column>
		</columns>
		<items>
			<ColumnListItem>
				<cells>
					<Text text="{local>Weight}"/>
					<Text text="{local>WeightUnit}"/>
					<Text text="{local>Volume}"/>
					<Text text="{local>VolumeUnit}"/>
					<Text text="{local>Incoterm}"/>
					<Text text="{local>PalletCount}"/>
					<Text text="{local>CartonCount}"/>
					<Text text="{local>Pieces}"/>
					<Text text="{local>TenderStatus}"/>
					<Text text="{local>NMFCCode}"/>
					<Text text="{local>FreightClass}"/>
				</cells>
			</ColumnListItem>
		</items>
	</Table>
</core:FragmentDefinition>