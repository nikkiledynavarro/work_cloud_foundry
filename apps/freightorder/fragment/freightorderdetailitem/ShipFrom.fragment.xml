<core:FragmentDefinition xmlns:mvc="sap.ui.core.mvc" xmlns:uxap="sap.uxap" xmlns:layout="sap.ui.layout" xmlns:form="sap.ui.layout.form"
	xmlns:core="sap.ui.core" xmlns:table="sap.ui.table" xmlns:u="sap.ui.unified" xmlns="sap.m" xmlns:html="http://www.w3.org/1999/xhtml"
	xmlns:l="sap.ui.layout">
	<form:SimpleForm id="SimpleFormHeader3" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="12"
		labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="2"
		singleContainerFullSize="false">
		<form:content>
			<core:Title text="{i18n>foDetailItemShipFromGeneralInfo}"/>
			<Label text="{i18n>foDetailItemShipFromNameAttention}"/>
			<Input placeholder="Name" value="{local>/FODetailItemShipFrom/Name1}"/>
			<Input value="{local>/FODetailItemShipFrom/Name2}" placeholder="Attention">
				<layoutData>
					<l:GridData span="XL3 L4 M4 S5"/>
				</layoutData>
			</Input>
			<Label text="{i18n>foDetailItemShipFromAddress12}"/>
			<Input placeholder="Address 1" value="{local>/FODetailItemShipFrom/Street1}"/>
			<Input value="{local>/FODetailItemShipFrom/Street2}" placeholder="Address 2">
				<layoutData>
					<l:GridData span="XL3 L4 M4 S5"/>
				</layoutData>
			</Input>
			<Label text="{i18n>foDetailItemShipFromAddress34}"/>
			<Input placeholder="Address 3" value="{local>/FODetailItemShipFrom/Street3}"/>
			<Input value="{local>/FODetailItemShipFrom/Street4}" placeholder="Address 4">
				<layoutData>
					<l:GridData span="XL3 L4 M4 S5"/>
				</layoutData>
			</Input>
			<Label text="{i18n>foDetailItemShipFromPhoneFax}"/>
			<Input placeholder="Phone" value="{local>/FODetailItemShipFrom/Phone}"/>
			<Input value="{local>/FODetailItemShipFrom/Fax}" placeholder="Fax">
				<layoutData>
					<l:GridData span="XL3 L4 M4 S5"/>
				</layoutData>
			</Input>
			<Label text="{i18n>foDetailItemShipFromFedStateTaxID}"/>
			<Input placeholder="Fed TaxID" value="{local>/FODetailItemShipFrom/FedTaxID}"/>
			<Input value="{local>/FODetailItemShipFrom/StateTaxID}" placeholder="State TaxID">
				<layoutData>
					<l:GridData span="XL3 L4 M4 S5"/>
				</layoutData>
			</Input>
			<core:Title text="{i18n>foDetailItemShipFromOnline}"/>
			<Label text="{i18n>foDetailItemShipFromContry}"/>
			<ComboBox items="{ path: 'foCountry>/Countries', sorter: { path: 'Land1' }, templateShareable:false }"
				selectedKey="{local>/FODetailItemShipFrom/Country}" change="onCountryFromChange">
				<core:Item key="{foCountry>Land1}" text="{foCountry>Land1}"/>
			</ComboBox>
			<Label text="{i18n>foDetailItemShipFromRegion}"/>
			<ComboBox items="{path: 'local>/RegionFrom', sorter: { path: 'Bland'}, templateShareable:false }"
				selectedKey="{local>/FODetailItemShipFrom/State}">
				<core:Item key="{local>Bland}" text="{local>Bland}"/>
			</ComboBox>
			<Label text="{i18n>foDetailItemShipFromCity}"/>
			<Input value="{local>/FODetailItemShipFrom/City}" placeholder="City"/>
			<Label text="{i18n>foDetailItemShipFromPostal}"/>
			<Input value="{local>/FODetailItemShipFrom/PostalCode}" placeholder="Postal Code"/>
		</form:content>
	</form:SimpleForm>
</core:FragmentDefinition>