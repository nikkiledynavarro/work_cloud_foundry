<core:FragmentDefinition xmlns:mvc="sap.ui.core.mvc" xmlns:uxap="sap.uxap" xmlns:layout="sap.ui.layout" xmlns:form="sap.ui.layout.form"
	xmlns:core="sap.ui.core" xmlns:table="sap.ui.table" xmlns:u="sap.ui.unified" xmlns="sap.m" xmlns:html="http://www.w3.org/1999/xhtml"
	xmlns:l="sap.ui.layout">
	<form:SimpleForm id="SimpleFormHeader2" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4"
		labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1"
		singleContainerFullSize="false">
		<form:content>
			<Label text="{i18n>foDetailItemShipToNameAttention}"/>
			<Input placeholder="Declared Value" value="{local>/FODetailItemShipTo/Name1}"/>
			<Input value="{local>/FODetailItemShipTo/Name2}" placeholder="Attention">
				<layoutData>
					<l:GridData span="XL3 L4 M4 S5"/>
				</layoutData>
			</Input>
			<Label text="{i18n>foDetailItemShipToAddress12}"/>
			<Input placeholder="Address 1" value="{local>/FODetailItemShipTo/Street1}"/>
			<Input value="{local>/FODetailItemShipTo/Street2}" placeholder="Address 2">
				<layoutData>
					<l:GridData span="XL3 L4 M4 S5"/>
				</layoutData>
			</Input>
			<Label text="{i18n>foDetailItemShipToAddress34}"/>
			<Input placeholder="Address 3" value="{local>/FODetailItemShipTo/Street3}"/>
			<Input value="{local>/FODetailItemShipTo/Street4}" placeholder="Address 4">
				<layoutData>
					<l:GridData span="XL3 L4 M4 S5"/>
				</layoutData>
			</Input>
			<Label text="{i18n>foDetailItemShipToCustomer}"/>
			<Input placeholder="Customer ID" value="{local>/FODetailItemShipTo/CustomerID}"/>
			<Input value="{local>/FODetailItemShipTo/Email}" placeholder="Email">
				<layoutData>
					<l:GridData span="XL3 L4 M4 S5"/>
				</layoutData>
			</Input>
			<Label text="{i18n>foDetailItemShipToPhoneFax}"/>
			<Input placeholder="Phone" value="{local>/FODetailItemShipTo/Phone}"/>
			<Input value="{local>/FODetailItemShipTo/Fax}" placeholder="Fax">
				<layoutData>
					<l:GridData span="XL3 L4 M4 S5"/>
				</layoutData>
			</Input>
			<Label text="{i18n>foDetailItemShipToFedStatesTaxID}"/>
			<Input placeholder="Fed TaxID" value="{local>/FODetailItemShipTo/FedTaxID}"/>
			<Input value="{local>/FODetailItemShipTo/StateTaxID}" placeholder="States TaxID">
				<layoutData>
					<l:GridData span="XL3 L4 M4 S5"/>
				</layoutData>
			</Input>
			<Label text="{i18n>foDetailItemShipToCountryRegion}"/>
			<ComboBox items="{ path: 'foCountry>/Countries', sorter: { path: 'Land1' }, templateShareable:false }"
				selectedKey="{local>/FODetailItemShipTo/Country}" change="onCountryToChange">
				<core:Item key="{foCountry>Land1}" text="{foCountry>Land1}"/>
			</ComboBox>
			<ComboBox items="{path: 'local>/RegionTo', sorter: { path: 'Bland'}, templateShareable:false }"
				selectedKey="{local>/FODetailItemShipTo/State}">
				<core:Item key="{local>Bland}" text="{local>Bland}"/>
			</ComboBox>
			<Label text="{i18n>foDetailItemShipToCity}"/>
			<Input value="{local>/FODetailItemShipTo/City}" placeholder="City"/>
			<Label text="{i18n>foDetailItemShipToPostal}"/>
			<Input value="{local>/FODetailItemShipTo/PostalCode}" placeholder="Postal Code"/>
		</form:content>
	</form:SimpleForm>
</core:FragmentDefinition>