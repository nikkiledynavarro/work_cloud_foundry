<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<Table id="tblRateQuoteItem" class="border_lightgray_nobottom" width="100%" busyIndicatorDelay="99999"
		growingScrollToLoad="true" items="{path: 'local>/RateQuoteItems'}" growing="true" growingThreshold="100" fixedLayout="false">
		<columns>
			<Column hAlign="Center">
				<Text text="{i18n>foRateQuoteCarrierCol}" wrapping="false"/>
			</Column>
			<Column demandPopin="true" minScreenWidth="Tablet">
				<Text text="{i18n>foRateQuoteCarrierNameCol}" wrapping="false"/>
			</Column>
			<Column demandPopin="true" minScreenWidth="Tablet">
				<Text text="{i18n>foRateQuoteSerivceCol}" wrapping="false"/>
			</Column>
			<Column demandPopin="true" minScreenWidth="Tablet">
				<Text text="{i18n>foRateQuoteServiceNameCol}" wrapping="false"/>
			</Column>
			<Column demandPopin="true" minScreenWidth="Tablet">
				<Text text="{i18n>foRateQuoteRateCol}" wrapping="false"/>
			</Column>
			<Column demandPopin="true" minScreenWidth="Tablet">
				<Text text="{i18n>foRateQuoteListRateCol}" wrapping="false"/>
			</Column>
				<Column demandPopin="true" minScreenWidth="Tablet">
				<Text text="{i18n>foRateQuoteCurrencyCol}" wrapping="false"/>
			</Column>
			<Column demandPopin="true" minScreenWidth="Tablet">
				<Text text="{i18n>foRateQuoteTransitTimeCol}" wrapping="false"/>
			</Column>
			<Column demandPopin="true" minScreenWidth="Tablet">
				<Text text="{i18n>foRateQuoteDeliveryDateCol}" wrapping="false"/>
			</Column>
			<Column demandPopin="true" minScreenWidth="Tablet">
				<Text text="{i18n>foRateQuotePriorityCol}" wrapping="false"/>
			</Column>
			<Column demandPopin="true" minScreenWidth="Tablet">
				<Text text="{i18n>foRateQuoteZoneCol}" wrapping="false"/>
			</Column>
			<Column demandPopin="true" minScreenWidth="Tablet">
				<Text text="{i18n>foRateQuoteTransIDCol}" wrapping="false"/>
			</Column>
		</columns>
		<ColumnListItem type="Inactive">
			<cells>
				<Text text="{local>Code}"/>
				<Text text="{local>Name}"/>
				<Text text="{local>Service}"/>
				<Text text="{local>ServiceName}"/>
				<Text text="{local>Rate}"/>
				<Text text="{local>Listrate}"/>
				<Text text="{local>Currency}"/>
				<Text text="{local>Timeintransit}"/>
				<Text text="{local>Deliverydate}"/>
				<Text text="{local>Priority}"/>
				<Text text="{local>Zone}"/>
				<Text text="{local>TransID}"/>
			</cells>
		</ColumnListItem>
	</Table>
</core:FragmentDefinition>