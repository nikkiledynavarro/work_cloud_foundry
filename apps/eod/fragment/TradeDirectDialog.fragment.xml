<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:table="sap.ui.table">
	<Dialog title="Trade Direct" class="sapUiContentPadding" stretch="true">
		<content>
			<table:Table selectionMode="MultiToggle" enableCellFilter="true" rows="{loca>/TradeDirectSet}" id="idTradeDirectTabDlg">
				<table:columns>
					<table:Column filterProperty="ShippingPoint">
						<Label text="{i18n>shippingpointCol}"/>
						<table:template>
							<Text text="{ShippingPoint}" wrapping="false"/>
						</table:template>
					</table:Column>
					<table:Column filterProperty="CreateOn">
						<Label text="{i18n>createonCol}"/>
						<table:template>
							<Text text="{CreateOn}" wrapping="false"/>
						</table:template>
					</table:Column>
					<table:Column filterProperty="Weight">
						<Label text="{i18n>weightCol}"/>
						<table:template>
							<Text text="{Weight}" wrapping="false"/>
						</table:template>
					</table:Column>
					<table:Column filterProperty="Weightunit">
						<Label text="{i18n>weightunitCol}"/>
						<table:template>
							<Text text="{Weightunit}" wrapping="false"/>
						</table:template>
					</table:Column>
					<table:Column filterProperty="TrackingNo">
						<Label text="{i18n>trackingnoCol}"/>
						<table:template>
							<Text text="{TrackingNo}" wrapping="false"/>
						</table:template>
					</table:Column>
					<table:Column filterProperty="TradeDirectService">
						<Label text="{i18n>tradedirectServiceCol}"/>
						<table:template>
							<Text text="{TradeDirectService}" wrapping="false"/>
						</table:template>
					</table:Column>
					<table:Column filterProperty="PackageCount">
						<Label text="{i18n>packingcountCol}"/>
						<table:template>
							<Text text="{PackageCount}" wrapping="false"/>
						</table:template>
					</table:Column>
				</table:columns>
			</table:Table>
		</content>
		<beginButton>
			<Button press="onConfirmTradeDirectDialog" text="Confirm" type="Accept"/>
		</beginButton>
		<endButton>
			<Button press="onCloseTradeDirectDialog" text="Close"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>