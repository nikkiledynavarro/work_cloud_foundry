<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:form="sap.ui.layout.form">
	<Dialog title="Handling Unit Items">
		<content>
			<Table id="tableHUItems" mode="SingleSelectLeft" class="border_lightgray_nobottom" showSeparators="All" growing="false"
				selectionChange="onHUItemsSelectionChange" items="{path: 'local>/HUFinalPackDetails', templateShareable:false}">
				<headerToolbar>
					<Toolbar>
						<ToolbarSpacer/>
						<SearchField id="txtMaterialHUItem" liveChange="onSearchMaterialHUItem" width="8rem"
						    placeholder="Material"></SearchField>
					</Toolbar>
				</headerToolbar>
				<columns>
					<Column width="8rem">
						<Text text="Product"/>
					</Column>
					<Column width="8rem">
						<Text text="Product Description"/>
					</Column>
					<Column width="8rem">
						<Text text="Avail.Qty"/>
					</Column>
					<Column width="5rem">
						<Text text="BUn"/>
					</Column>
				</columns>
				<items >
					<ColumnListItem type="Active">
						<cells>
							<Text text="{local>Matnr}"/>
							<Text text="{local>Maktx}"/>
							<Text text="{local>Quan}"/>
							<Text text="{local>Unit}"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<beginButton>
			<Button text="OK" type="Emphasized" press="onRePackItems"/>
		</beginButton>
		<endButton>
			<Button text="Cancel" press="onCloseHUItemsDialog"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>