<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
	<Dialog title="Rate Details" class="sapUiContentPadding" contentWidth="1000px">
		<Table id="tblRateDetailList" mode="None" fixedLayout="false" class="border_lightgray_nobottom" showSeparators="All" growing="false">
			<columns>
				<Column>
					<Text text="Carrier"/>
				</Column>
				<Column>
					<Text text="Service"/>
				</Column>
				<Column>
					<Text text="Chrg.Typ"/>
				</Column>
				<Column>
					<Text text="Chrg.Cod"/>
				</Column>
				<Column>
					<Text text="Cond.Typ"/>
				</Column>
				<Column>
					<Text text="{i18n>Rate}"/>
				</Column>
				<Column>
					<Text text="%"/>
				</Column>
				<Column>
					<Text text="Curr"/>
				</Column>
				<Column>
					<Text text="{i18n>Per}"/>
				</Column>
				<Column>
					<Text text="{i18n>UoM}"/>
				</Column>
				<Column>
					<Text text="+/-"/>
				</Column>
				<Column>
					<Text text="Calc.Typ"/>
				</Column>
			</columns>
		</Table>
		<endButton>
			<Button press="onCloseRateDetailDialog" text="Close"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>