<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Dialog title="{i18n>hazmatDialogTitle}" class="sapUiContentPadding" contentWidth="600px">
		<content>
			<VBox class="sapUiSmallMargin">
				<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="4"
					adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1"
					singleContainerFullSize="false">
					<f:content>
						<Label text="HU"/>
						<ComboBox items="{ path: 'local>/BindingHU'}" change="onChangeHU" id="cbHuExidv">
							<core:Item key="{local>exidv}" text="{path:'local>exidv', formatter: '.formatter.removeLeadingZero'}"/>
						</ComboBox>
						<Label text="ID Number"/>
						<ComboBox items="{/xSERPERPxCDS_DGUN}" change="onPCDGunCBChange" required="true" id="cbDotnumber">
							<!--<core:Item key="{Dgnu}" text="{Tkui}{Dgnu}"/>-->
							<core:Item key="{Dgnu}" text="{Tkui}{Dgnu} - {Propershipnam} - {Hazmatclass} - {Hazmatsubclass} - {Packinggroup} - {Dgregulation}"/>
						</ComboBox>
						<!--change="onPCDGunCBChange"-->
						<Label text="Quantity / UoM"/>
						<Input value="{local>/NewHazMatItem/Actualqty}"/>
						<Input value="{local>/NewHazMatItem/Actualuom}"/>
						<Label text="Gross Weight / UoM"/>
						<Input value="{local>/NewHazMatItem/Packweight}"/>
						<Input value="{local>/NewHazMatItem/Packuom}"/>
						<Label text="Net Weight"/>
						<Input value="{local>/NewHazMatItem/Packnetweight}"/>
						<Label text="DotProperShippingName"/>
						<Input value="{local>/NewHazMatItem/Propershipnam}" editable="false"/>
						<Label text="Haz Class"/>
						<Input value="{local>/NewHazMatItem/Hazmatclass}" editable="false"/>
						<Label text="Haz SubCls"/>
						<Input value="{local>/NewHazMatItem/Hazmatsubclass}" editable="false"/>
						<Label text="Pack Group"/>
						<Input value="{local>/NewHazMatItem/Packinggroup}" editable="false"/>
						<Label text="DG Regulation"/>
						<Input value="{local>/NewHazMatItem/Dgregulation}" editable="false"/>
					</f:content>
				</f:SimpleForm>
			</VBox>
		</content>
		<beginButton>
			<Button text="Continue" type="Emphasized" press="onHazmatAddItemPress"/>
		</beginButton>
		<endButton>
			<Button press="onAddHazmatClose" text="Cancel"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>