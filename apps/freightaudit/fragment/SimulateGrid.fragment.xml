<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:chart="sap.suite.ui.microchart"
	xmlns:t="sap.ui.table" xmlns:fb="sap.ui.comp.filterbar" xmlns:f="sap.f" xmlns:vm="sap.ui.comp.variants">
	<Dialog title="Accounting Entries Simulation" contentWidth="100%">
		<Table width="auto" id="tabSimulateList" class="sapUiTinyMargin border_lightgray_nobottom"
			items="{ path: 'simulateModel>/results', sorter: { path: 'InvoiceNo', descending: false } }" noDataText="{local>/tableNoDataText}"
			growing="true" growingScrollToLoad="true">
			<columns>
				<Column popinDisplay="Inline" demandPopin="true" minScreenWidth="Tablet">
					<Text text="{i18n>tableBukrsColumnTitle}"/>
				</Column>
				<Column>
					<Text text="{i18n>tableInvnumColumnTitle}"/>
				</Column>
				<Column width="6rem" popinDisplay="Inline" demandPopin="true" minScreenWidth="Tablet">
					<Text text="{i18n>tableLifnrColumnTitle}"/>
				</Column>
				<Column width="6rem" popinDisplay="Inline" demandPopin="true" minScreenWidth="Tablet">
					<Text text="{i18n>tableGLAccountColumnTitle}"/>
				</Column>
				<Column popinDisplay="Inline" demandPopin="true" minScreenWidth="Tablet">
					<Text text="{i18n>tableBilledAmtColumnTitle}"/>
				</Column>
				<Column>
					<Text text="{i18n>tableTaxCodeColumnTitle}"/>
				</Column>
				<Column popinDisplay="Inline" demandPopin="true" minScreenWidth="Tablet">
					<Text text="{i18n>tableTaxJurisColumnTitle}"/>
				</Column>
				<Column popinDisplay="Inline" demandPopin="true" minScreenWidth="Tablet">
					<Text text="{i18n>tableTaxAmtColumnTitle}"/>
				</Column>
				<Column>
					<Text text="{i18n>tableCostCtrColumnTitle}"/>
				</Column>
				<Column popinDisplay="Inline" demandPopin="true" minScreenWidth="Tablet">
					<Text text="{i18n>tableProfitCtrColumnTitle}"/>
				</Column>
				<Column popinDisplay="Inline" demandPopin="true" minScreenWidth="Tablet">
					<Text text="{i18n>tableOrderNoColumnTitle}"/>
				</Column>
			</columns>
			<items>
				<ColumnListItem type="Inactive">
					<cells>
						<Text text="{simulateModel>CompanyCode}"/>
						<Text text="{simulateModel>InvoiceNo}"/>
						<Text text="{simulateModel>Vendor}"/>
						<Text text="{simulateModel>GLAcc}"/>
						<Text text="{simulateModel>Amount} {= ${simulateModel>Amount} !== '' ? ${simulateModel>Currency} : ''}"/>
						<Text text="{simulateModel>TaxCode}"/>
						<Text text="{simulateModel>TaxJuri}"/>
						<Text text="{simulateModel>Tax} {= ${simulateModel>Tax} !== '' ? ${simulateModel>Currency} : ''}"/>
						<Text text="{simulateModel>CostCenter}"/>
						<Text text="{simulateModel>ProfitCenter}"/>
						<Text text="{simulateModel>Order}"/>
					</cells>
				</ColumnListItem>
			</items>
		</Table>
		<buttons>
			<Button text="Close" press="onSimClose"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>