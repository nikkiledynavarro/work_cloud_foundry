<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
	<Dialog title="Deliveries">
		<Table class="sapUiTinyMargin border_lightgray_nobottom" width="400px" items="{local>/TrackingDeliveries}">
			<columns>
				<Column hAlign="Center">
					<Text text="{i18n>Delivery}" wrapping="false"/>
				</Column>
			</columns>
			<items>
				<ColumnListItem type="Inactive">
					<Text text="{local>Delivery}"/>
				</ColumnListItem>
			</items>
		</Table>
		<beginButton>
			<Button text="Close" press="onCloseTrackingDelivery"/>
		</beginButton>
	</Dialog>
</core:FragmentDefinition>