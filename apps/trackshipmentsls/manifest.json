{
  "_version": "1.12.0",
  "sap.app": {
    "id": "comerpisshiperptrackshipmentsls",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "cancelEWMService": {
        "uri": "sap/opu/odata/serperp/shipewm_srv/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/metadata.xml"
        }
      },
      "cancelECCService": {
        "uri": "/sap/opu/odata/serperp/track_shipment_srv/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/ECC/metadata.xml"
        }
      }
    },
    "sourceTemplate": {
      "id": "sap.ui.ui5-template-plugin.1worklist",
      "version": "1.52.7"
    },
    "crossNavigation": {
      "inbounds": {
        "trackshipmentslsDisplay": {
          "action": "display",
          "icon": "sap-icon://app",
          "signature": {
            "additionalParameters": "allowed",
            "parameters": {}
          },
          "semanticObject": "trackshipmentsls",
          "subTitle": "",
          "title": "{{appTitle}}"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://task",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    },
    "fullWidth": true
  },
  "sap.ui5": {
    "resources": {
      "css": [
        {
          "uri": "css/style.css",
          "id": "stylecss"
        }
      ]
    },
    "rootView": {
      "viewName": "com.erpis.shiperp.sls.trackshipmentsls.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.42.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.f": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.erpis.shiperp.sls.trackshipmentsls.i18n.i18n"
        }
      },
      "": {
        "dataSource": "cancelECCService",
        "settings": {
          "useBatch": true,
          "refreshAfterChange": false
        },
        "preload": true
      },
      "cancelEWMService": {
        "dataSource": "cancelEWMService",
        "settings": {
          "useBatch": true,
          "refreshAfterChange": false
        },
        "preload": true
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "com.erpis.shiperp.sls.trackshipmentsls.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "bypassed": {
          "target": [
            "notFound"
          ]
        },
        "async": true
      },
      "routes": [
        {
          "pattern": "",
          "name": "home",
          "target": [
            "home"
          ]
        },
        {
          "pattern": "Profile/{Station}/{Profile}",
          "name": "main",
          "target": [
            "main"
          ]
        },
        {
          "pattern": "Profile/{Station}/{Profile}/{WarehouseNumber}",
          "name": "mainEWM",
          "target": [
            "mainEWM"
          ]
        }
      ],
      "targets": {
        "home": {
          "viewName": "Home",
          "viewId": "home",
          "viewLevel": 1,
          "title": "{i18n>worklistViewTitle}"
        },
        "main": {
          "viewName": "ECC.Main",
          "viewId": "main",
          "viewLevel": 2,
          "title": "{i18n>objectViewTitle}"
        },
        "mainEWM": {
          "viewName": "EWM.Main",
          "viewId": "mainEWM",
          "viewLevel": 2,
          "title": "{i18n>objectViewTitle}"
        },
        "notFound": {
          "viewName": "NotFound",
          "viewId": "notFound"
        }
      }
    }
  },
  "sap.platform.hcp": {
    "uri": "",
    "_version": "1.1.0"
  },
  "sap.cloud": {
    "public": true,
    "service": "comerpisshiperptrackshipmentsls"
  }
}