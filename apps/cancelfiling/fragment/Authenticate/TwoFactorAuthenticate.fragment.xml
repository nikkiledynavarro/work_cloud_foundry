<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog contentWidth="400px" contentHeight="auto">
		<customHeader>
			<Bar>
				<contentMiddle>
					<Title class="sapUiSmallMarginBegin" text="Two Factor Authencattion"/>
				</contentMiddle>
				<contentRight>
					<Button icon="sap-icon://decline" press="onCancelAuthenticate" type="Reject"/>
				</contentRight>
			</Bar>
		</customHeader>
		<content>
			<Text class="sapUiSmallMarginLeft sapUiSmallMarginTop" text="Enter the Security Token that has been sent to:"/>
			<FlexBox class="sapUiSmallMarginTopBottom">
				<HBox alignItems="Center">
					<Label text="Token:" width="5rem" textAlign="End" class="sapUiSmallMarginEnd"/>
					<Input value="{local>/UserVerified/Authenticate/Token}" width="10rem"/>
				</HBox>
			</FlexBox>
		</content>
		<beginButton>
			<Button text="Verify" press="onVerifyPress" icon="sap-icon://accept" type="Success"/>
		</beginButton>
		<endButton>
			<Button text="Resend" press="onResendPress" icon="sap-icon://email" type="Default"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>