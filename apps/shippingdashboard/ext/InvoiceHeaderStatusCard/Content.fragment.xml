<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:ovp="sap.ovp.ui" xmlns:viz="sap.viz.ui5.controls"
	xmlns:viz.data="sap.viz.ui5.data" xmlns:common="sap.suite.ui.commons" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
	xmlns:template="http://schemas.sap.com/sapui5/extension/sap.ui.core.template/1">
	<Toolbar id="idToolBar" active="false" enabled="true" class="sapOvpDropDown" design="Auto" style="Standard">
		<Select id="idSelect" enabled="true" width="auto" maxWidth="100%" type="Default" autoAdjustWidth="false" textAlign="Initial"
			textDirection="Inherit" change="onSelectionChange" items="{Dropdown>/selections}" forceSelection="true">
			<items>
				<core:Item text="{Dropdown>text}" key="{Dropdown>key}"/>
			</items>
		</Select>
	</Toolbar>
	<viz:Popover id="idPopOver"></viz:Popover>
	<viz:VizFrame id="idVizFrame" uiConfig="{applicationSet:'fiori'}" height='400px' width="100%" vizType='donut' selectData="onSelectData">
		<viz:dataset>
			<viz.data:FlattenedDataset
				data="{ path : 'MainModel>/xSERPERPxI_SHDB_INV_STAT', parameters : { select : 'FAHeaderStatus,TotalOfHeaderStatus' }}">
				<viz.data:dimensions>
					<viz.data:DimensionDefinition name="FAHeaderStatus" value="{FAHeaderStatus}"/>
				</viz.data:dimensions>
				<viz.data:measures>
					<viz.data:MeasureDefinition name="Total of Status" value="{TotalOfHeaderStatus}"/>
				</viz.data:measures>
			</viz.data:FlattenedDataset>
		</viz:dataset>
		<viz:feeds>
			<viz.feeds:FeedItem uid="size" type="Measure" values="Total of Status"/>
			<viz.feeds:FeedItem uid="color" type="Dimension" values="FAHeaderStatus"/>
		</viz:feeds>
	</viz:VizFrame>
</core:FragmentDefinition>