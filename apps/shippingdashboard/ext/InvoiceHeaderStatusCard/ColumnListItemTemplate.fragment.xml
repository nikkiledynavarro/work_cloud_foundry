<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<ColumnListItem type="Navigation">
		<cells>
			<ObjectIdentifier title="{MainModel>InvoiceNo}"/>
			<Text text="{MainModel>Carrier}"/>
			<Text text="{path:'MainModel>InvoiceDate',formatter: '.formatDateString'}"/>
			<Text text="{path:'MainModel>InvoiceDueDate',formatter: '.formatDateString'}"/>
			<Text text="{MainModel>FAHeaderStatus}" visible="false"/>
		</cells>
	</ColumnListItem>
</core:FragmentDefinition>