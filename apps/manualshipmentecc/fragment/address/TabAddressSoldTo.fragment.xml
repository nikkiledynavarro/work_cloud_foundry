<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
		adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="3" columnsL="2" columnsM="2"
		singleContainerFullSize="false">
		<f:content>
			<core:Title text="Customer Info"></core:Title>
			<Label text="Name/Attention"/>
			<Input placeholder="Name" tooltip="Name" value="{local>/basic/partners/soldto/address/name1}"
				enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"></Input>
			<Input placeholder="Attention" tooltip="Attention" value="{local>/basic/partners/soldto/address/name2}"
				enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"></Input>
			<Label text="Address 1/2"/>
			<Input placeholder="Address 1" tooltip="Address 1" value="{local>/basic/partners/soldto/address/street1}"
				enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"></Input>
			<Input placeholder="Address 2" tooltip="Address 2" value="{local>/basic/partners/soldto/address/street2}"
				enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"></Input>
			<Label text="Address 3/4"/>
			<Input placeholder="Address 3" tooltip="Address 3" value="{local>/basic/partners/soldto/address/street3}"
				enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"></Input>
			<Input placeholder="Address 4" tooltip="Address 4" value="{local>/basic/partners/soldto/address/street4}"
				enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"></Input>
			<Label text="Phone/Fax"/>
			<Input placeholder="Phone" tooltip="Phone" value="{local>/basic/partners/soldto/address/telephone}"
				enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"></Input>
			<Input placeholder="Fax" tooltip="Fax" value="{local>/basic/partners/soldto/address/fax}"
				enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"></Input>
			<core:Title text="Location"></core:Title>
			<Label text="Country"/>
			<ComboBox selectedKey="{local>/basic/partners/soldto/address/country}" tooltip="Country" items="{path: '/xSERPERPxI_PCCNTR', length: 999}"
				app:nextUpdate="slSoldToState" enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }">
				<items>
					<core:Item text="{Name}" key="{Country}"/>
				</items>
			</ComboBox>
			<Label text="Region"></Label>
			<ComboBox id="slSoldToState" tooltip="State" change="onUpdateDomestic" selectedKey="{local>/basic/partners/soldto/address/state}"
				items="{path: '/xSERPERPxI_PCSTATE', length: 999}" enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }">
				<items>
					<core:Item text="{Description}" key="{Region}"/>
				</items>
			</ComboBox>
			<Label text="City"/>
			<Input placeholder="City" value="{local>/basic/partners/soldto/address/city}"
				enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"></Input>
			<Label text="Postal"/>
			<Input placeholder="Postal Code" value="{local>/basic/partners/soldto/address/postalcode}"
				enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"/>
		</f:content>
	</f:SimpleForm>
</core:FragmentDefinition>