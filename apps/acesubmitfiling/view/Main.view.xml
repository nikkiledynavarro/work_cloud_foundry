<mvc:View controllerName="com.erpis.shiperp.ACESubmitFiling.controller.Main" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" height="100%" xmlns:uxap="sap.uxap"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<l:DynamicSideContent id="dsc" showSideContent="false" sideContentPosition="Begin" sideContentVisibility="ShowAboveL">
		<App id="idAppControl">
			<uxap:ObjectPageLayout id="ObjectPageLayout" showTitleInHeaderContent="false" toggleHeaderOnTitleClick="false" showHeaderContent="false"
				preserveHeaderStateOnScroll="false" headerContentPinnable="false" enableLazyLoading="false" showFooter="true" selectedSection="idTabSection">
				<uxap:headerTitle>
					<uxap:ObjectPageDynamicHeaderTitle>
						<uxap:heading>
							<VBox>
								<FlexBox alignItems="Center">
									<Image class="sapUiSmallMarginEnd" src="{path: '', formatter: '.formatter.getTransparentLogoLink' }" height="1.5rem"/>
									<Select items="{path: 'local>/InputTypes'}" id="idInputType" width="12rem" class="margin_right_5px" change="onInputTypeChange">
										<layoutData>
											<OverflowToolbarLayoutData priority="NeverOverflow"/>
										</layoutData>
										<items>
											<core:Item text="{local>Description}" key="{local>Shiptypeinput}"></core:Item>
										</items>
									</Select>
									<MultiInput type="Number" submit="onScanNumber" id="txtId" width="12rem" placeholder="Enter Number" class="margin_right_5px"
										showValueHelp="false">
										<layoutData>
											<OverflowToolbarLayoutData priority="NeverOverflow"/>
										</layoutData>
									</MultiInput>
									<Button icon="sap-icon://add" tooltip="Add" press="onAddPress" class="margin_right_5px"/>
									<Button icon="sap-icon://refresh" tooltip="Refresh" press="onResetData" class="margin_right_5px"/>
								</FlexBox>
							</VBox>
						</uxap:heading>
						<uxap:actions>
							<VBox>
								<HBox justifyContent="End" alignItems="Center" width="100%">
									<Label text="Filter ID:" class="sapUiSmallMarginEnd" width="6rem" textAlign="End"/>
									<Input enabled="false" value="{local>/basic/general/additional_info/Fid}" width="9rem"/>
								</HBox >
							</VBox>
						</uxap:actions>
						<uxap:navigationActions>
							<OverflowToolbarButton icon="sap-icon://save" press="onSaveACEClick" tooltip="Save as Template" type="Emphasized"/>
							<OverflowToolbarButton enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }" icon="sap-icon://request"
								press="onLoadingTemplateDialog" tooltip="Load Template" type="Emphasized"/>
							<OverflowToolbarButton icon="sap-icon://pipeline-analysis" press="onAnalysisClick" tooltip="BRE Analysis" type="Emphasized"/>
							<OverflowToolbarButton enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }" icon="sap-icon://database"
								press="onRetrieveDatabase" tooltip="Retrieve from Database" type="Emphasized"/>
							<OverflowToolbarButton icon="sap-icon://sys-cancel" press="onCrossNavigate" tooltip="Cancel Request" type="Reject"
								app:crossNavigate="#cancelacehr7-Display"/>
							<OverflowToolbarButton icon="sap-icon://zoom-in" press="onCrossNavigate" tooltip="View ACE Filing" type="Emphasized"
								app:crossNavigate="#viewacefiling-Display"/>
						</uxap:navigationActions>
					</uxap:ObjectPageDynamicHeaderTitle>
				</uxap:headerTitle>
				<uxap:sections>
					<!-- Tab General -->
					<uxap:ObjectPageSection title="General" id="idTabGeneral">
						<uxap:subSections>
							<uxap:ObjectPageSubSection title="General">
								<uxap:blocks>
									<IconTabBar id="idTabBarGeneral" select="onSelectGeneralTab" class="sapUiResponsiveContentPadding">
										<items>
											<!--Sub Tab General -->
											<IconTabFilter text="{i18n>general}" key="General">
												<core:Fragment class="sapUiSizeCompact" fragmentName="com.erpis.shiperp.ACESubmitFiling.fragment.General.TabGeneral" type="XML"/>
											</IconTabFilter>
											<IconTabSeparator/>
											<!--Sub Tab Additinational Info-->
											<IconTabFilter text="{i18n>additionalInfo}" key="Additinational">
												<core:Fragment class="sapUiSizeCompact" fragmentName="com.erpis.shiperp.ACESubmitFiling.fragment.General.TabAdditinational" type="XML"/>
											</IconTabFilter>
										</items>
									</IconTabBar>
								</uxap:blocks>
							</uxap:ObjectPageSubSection>
						</uxap:subSections>
					</uxap:ObjectPageSection>
					<!-- Tab Partners -->
					<uxap:ObjectPageSection id="idTabPartners">
						<uxap:subSections>
							<uxap:ObjectPageSubSection title="Partners">
								<uxap:blocks>
									<IconTabBar id="idTabBarPartners" select="onSelectPartnersTab" class="sapUiResponsiveContentPadding">
										<items>
											<!--Sub Tab USPPI -->
											<IconTabFilter text="{i18n>usppi}" key="USPPI">
												<core:Fragment class="sapUiSizeCompact" fragmentName="com.erpis.shiperp.ACESubmitFiling.fragment.Partners.TabPartners" type="XML"/>
											</IconTabFilter>
											<IconTabSeparator/>
											<!--Sub Tab Ultimate Consignee-->
											<IconTabFilter text="{i18n>ultimateConsignee}" key="Ultimate">
												<core:Fragment class="sapUiSizeCompact" fragmentName="com.erpis.shiperp.ACESubmitFiling.fragment.Partners.UItimateConsignee" type="XML"/>
											</IconTabFilter>
											<IconTabSeparator/>
											<!--Sub Tab Int. Consignee-->
											<IconTabFilter text="{i18n>intConsignee}" key="Ultimate">
												<core:Fragment class="sapUiSizeCompact" fragmentName="com.erpis.shiperp.ACESubmitFiling.fragment.Partners.IntConsignee" type="XML"/>
											</IconTabFilter>
											<IconTabSeparator/>
											<!--Sub Tab Freight Forwarder-->
											<IconTabFilter text="{i18n>freightForwarder}" key="Ultimate">
												<core:Fragment class="sapUiSizeCompact" fragmentName="com.erpis.shiperp.ACESubmitFiling.fragment.Partners.FreightForwarder" type="XML"/>
											</IconTabFilter>
										</items>
									</IconTabBar>
								</uxap:blocks>
							</uxap:ObjectPageSubSection>
						</uxap:subSections>
					</uxap:ObjectPageSection>
					<!-- Tab Line Items -->
					<uxap:ObjectPageSection id="idTabLineItems">
						<uxap:subSections>
							<uxap:ObjectPageSubSection title="Line Items">
								<uxap:blocks>
									<core:Fragment fragmentName="com.erpis.shiperp.ACESubmitFiling.fragment.LineItems.TabLineItems" type="XML"/>
								</uxap:blocks>
							</uxap:ObjectPageSubSection>
						</uxap:subSections>
					</uxap:ObjectPageSection>
				</uxap:sections>
				<uxap:footer>
					<OverflowToolbar id="otbFooter">
						<Button id="popoverButton" icon="sap-icon://message-popup" text="{messageModel>/messagesLength}" type="Emphasized"
							press="handleMessagePopoverPress"/>
						<ToolbarSpacer/>
						<Button id="idShipmentBtn" press="onSubmit" icon="sap-icon://shipping-status"
							enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }" type="Accept" text="Submit"/>
					</OverflowToolbar>
				</uxap:footer>
			</uxap:ObjectPageLayout>
		</App>
	</l:DynamicSideContent>
</mvc:View>