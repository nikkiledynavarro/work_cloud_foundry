<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
	<Dialog title="{i18n>loadFioriAceTemplate}">
		<Text text="Select the template that you want to load" class="sapUiTinyMarginBegin"/>
		<Table class="sapUiTinyMargin" width="500px" id="idLoadTemplate" selectionChange="onSelectionTemplate" mode="SingleSelectLeft"
			items="{path:'/xSERPERPxCDS_TEMPLATE'}">
			<headerToolbar>
				<OverflowToolbar>
					<SearchField width="90%" showSearchButton="true" search="onSearchTemplate" class="sapUiTinyMarginBegin"/>
				</OverflowToolbar>
			</headerToolbar>
			<columns>
				<Column hAlign="Center"></Column>
			</columns>
			<items>
				<ColumnListItem type="Inactive">
					<cells>
						<Text text="{Template}"/>
					</cells>
				</ColumnListItem>
			</items>
		</Table>
		<buttons>
			<Button text="{i18n>loadTemplate}" press="onLoadTemplate" type="Emphasized"/>
			<Button text="{i18n>Cancel}" press="onCancelLoadTemplate" type="Reject"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>