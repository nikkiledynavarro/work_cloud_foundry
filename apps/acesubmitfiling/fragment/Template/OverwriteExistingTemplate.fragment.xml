<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog contentWidth="auto" contentHeight="auto">
		<customHeader>
			<Bar>
				<contentMiddle>
					<Title text="Save As Template"/>
				</contentMiddle>
				<contentRight>
					<Button icon="sap-icon://decline" press="onCloseTemplate" type="Reject"/>
				</contentRight>
			</Bar>
		</customHeader>
		<content>
			<VBox>
				<Text class="sapUiSmallMarginLeft sapUiSmallMarginTop" text="Template already exists:"/>
				<Text class="sapUiSmallMarginLeft sapUiSmallMarginTop sapUiSmallMarginRight" text="{i18n>OverwriteTemplate}"/>
			</VBox>
			<FlexBox class="sapUiSmallMarginTopBottom sapUiSmallMarginLeft sapUiSmallMarginRight">
				<ComboBox id="idTemplate" width="35.5rem" items="{path: 'local>/ListTemplate'}" selectedKey="{local>/template/Name}">
					<core:Item key="{local>Template}" text="{local>Template}"></core:Item>
				</ComboBox>
			</FlexBox>
		</content>
		<beginButton>
			<Button text="Yes" press="onSaveOverwriteTemplate" type="Emphasized"/>
		</beginButton>
		<endButton>
			<Button text="No" press="onCancelOverwriteTemplate" type="Default"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>