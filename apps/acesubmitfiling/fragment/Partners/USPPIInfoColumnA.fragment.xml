<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<!--Name-->
	<Label text="{i18n>name}"/>
	<Input value="{local>/basic/partners/usppi/Add1}" enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
	<!--Address 1-->
	<Label text="{i18n>address1}"/>
	<Input value="{local>/basic/partners/usppi/Add4}" enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
	<!--Address 2-->
	<Label text="{i18n>address2}"/>
	<Input value="{local>/basic/partners/usppi/Add5}" enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
	<!--*City/*State-->
	<Label text="{i18n>cityState}"/>
	<Input value="{local>/basic/partners/usppi/Add6}" enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
	<ComboBox id="idUsspiState" items="{path: 'local>/States'}" selectedKey="{local>/basic/partners/usppi/Add7}"
		enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }">
		<core:Item key="{local>Bland}" text="{local>Bland} - {local>Bezei}"></core:Item>
	</ComboBox>
	<!--Zip code-->
	<Label text="{i18n>zipCode}"/>
	<Input value="{local>/basic/partners/usppi/Add8}" enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
</core:FragmentDefinition>