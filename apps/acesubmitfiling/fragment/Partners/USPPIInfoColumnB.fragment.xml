<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<!--Id number-->
	<Label text="{i18n>idNumber}"/>
	<Input value="{local>/basic/partners/usppi/Add2}" enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
	<!--Id type-->
	<Label text="{i18n>idType}"/>
	<ComboBox id="idUsspiIdType" selectedKey="{local>/basic/partners/usppi/Add3}"
		enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }">
		<core:Item key="E" text="E - EIN"/>
		<core:Item key="D" text="D - DUNS"/>
	</ComboBox>
	<!--Contact First/Initial/*Last-->
	<Label text="{i18n>contactFirst}"/>
	<Input value="{local>/basic/partners/usppi/Add9}" enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
	<Input value="{local>/basic/partners/usppi/Add10}" enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
	<Input value="{local>/basic/partners/usppi/Add11}" enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
	<!--Contact phone-->
	<Label text="{i18n>contactPhone}"/>
	<Input value="{local>/basic/partners/usppi/Add12}" enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
	<!--Email address-->
	<Label text="{i18n>emailAddress}"/>
	<Input value="{local>/basic/partners/usppi/Email}" enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
</core:FragmentDefinition>