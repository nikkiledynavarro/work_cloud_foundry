<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<VBox>
		<Toolbar>
			<ToolbarSpacer/>
			<SearchField width="20%" showRefreshButton="true" id="searchInput" search="onSearchItem"/>
		</Toolbar>
		<Table id="LineItems" selectionChange="onSelectionChange" fixedLayout="true" items="{path: 'local>/LineItems'}" mode="{local>/Mode}"
			growing="true" keyboardMode="Edit" growingThreshold="99999" class="border_lightgray_nobottom">
			<headerToolbar>
				<Toolbar>
					<Title text="Item ({= ${local>/LineItems} ? ${local>/LineItems}.length : 0})"/>
					<ToolbarSpacer/>
					<!--<ToolbarSeparator/>-->
					<!--<Button enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }" icon="sap-icon://add" tooltip="Add"-->
					<!--	class="sapUiTinyMarginEnd" press="onAddLineItems"/>-->
					<Button enabled="{= (${local>/basic} &amp;&amp; ${local>/EnableEditButton} === true) ? true : false }" icon="sap-icon://edit" tooltip="Edit"
						class="sapUiTinyMarginEnd" press="onEditPress"/>
					<!--<Button enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }" icon="sap-icon://sort" tooltip="Sort"-->
					<!--	class="sapUiTinyMarginEnd" press="onSortPress"/>-->
					<!--<Button enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }" icon="sap-icon://filter" tooltip="Sort"-->
					<!--	class="sapUiTinyMarginEnd" press="onfilterPress"/>-->
					<!--<Button enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }" icon="sap-icon://delete" tooltip="Delete"-->
					<!--	class="sapUiTinyMarginEnd" press="onDeletePress"/>-->
				</Toolbar>
			</headerToolbar>
			<columns>
				<Column hAlign="Center" width="auto">
					<Text text="{i18n>filingRequired}"/>
				</Column>
				<!--Commodity Code-->
				<Column hAlign="Center" width="auto">
					<Text text="{i18n>commodityCode}"/>
				</Column>
				<!--Description-->
				<Column hAlign="Center" width="auto">
					<Text text="{i18n>description}"/>
				</Column>
				<!--Export Code-->
				<Column hAlign="Center" width="auto">
					<Text text="{i18n>exportCode}"/>
				</Column>
				<!--Value-->
				<Column hAlign="Center" width="auto">
					<Text text="{i18n>value}"/>
				</Column>
				<!--Currency-->
				<Column hAlign="Center" width="auto">
					<Text text="{i18n>currency}"/>
				</Column>
				<!--Fisrt Quantity-->
				<Column hAlign="Center" width="auto">
					<Text text="{i18n>firstQuantity}"/>
				</Column>
				<!--Fisrt UoM-->
				<Column hAlign="Center" width="auto">
					<Text text="{i18n>firstuom}"/>
				</Column>
			</columns>
			<items>
				<ColumnListItem>
					<cells>
						<CheckBox selected="{local>FillingRequired}" enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
						<!--Commodity Code-->
						<Link text="{local>Itx13}" press="handleCommodityCodePress"
							enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
						<!--Description-->
						<Text text="{local>Itx12}" wrapping="false"/>
						<!--Export Code-->
						<Text text="{local>Itx1}" wrapping="false"/>
						<!--Value-->
						<Text text="{local>Itx2}" wrapping="false"/>
						<!--Currency-->
						<Text text="{local>Currency}" wrapping="false"/>
						<!--Fisrt Quantity-->
						<Text text="{local>Itx4}" wrapping="false"/>
						<!--Fisrt UoM-->
						<Text text="{local>Itx3}" wrapping="false"/>
					</cells>
				</ColumnListItem>
			</items>
		</Table>
	</VBox>
</core:FragmentDefinition>