<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:form="sap.ui.layout.form">
	<Dialog title="Create Line Items">
		<content>
			<form:Form width="100%" editable="true" visible="true">
				<form:formContainers>
					<form:FormContainer visible="true">
						<form:formElements>
							<!--Commodity Code-->
							<form:FormElement visible="true">
								<form:label>
									<Label text="{i18n>commodityCode}"/>
								</form:label>
								<form:fields>
									<ComboBox id="idCommodityCode" selectedKey="{NewLineItems>/Itx13}" items="{ path: '/xSERPERPxCDS_COMMODITYCODE' }">
										<core:Item key="{Htscode}" text="{Htscode}"></core:Item>
									</ComboBox>
								</form:fields>
							</form:FormElement>
							<!--Description-->
							<form:FormElement visible="true">
								<form:label>
									<Label text="{i18n>description}"/>
								</form:label>
								<form:fields>
									<Input value="{NewLineItems>/Itx12}"/>
								</form:fields>
							</form:FormElement>
							<!--Export Code-->
							<form:FormElement visible="true">
								<form:label>
									<Label text="{i18n>exportCode}"/>
								</form:label>
								<form:fields>
									<ComboBox id="idExportCode" selectedKey="{NewLineItems>/Itx1}" items="{ path: '/xSERPERPxCDS_EXPORTCODE' }">
										<core:Item key="{ExportCode}" text="{ExportCode}"></core:Item>
									</ComboBox>
								</form:fields>
							</form:FormElement>
							<!--Value-->
							<form:FormElement visible="true">
								<form:label>
									<Label text="{i18n>value}"/>
								</form:label>
								<form:fields>
									<Input value="{NewLineItems>/Itx2}"/>
								</form:fields>
							</form:FormElement>
							<!--Currency-->
							<form:FormElement visible="true">
								<form:label>
									<Label text="{i18n>currency}"/>
								</form:label>
								<form:fields>
									<Input value="{NewLineItems>/Currency}"/>
								</form:fields>
							</form:FormElement>
							<!--Fisrt Quantity-->
							<form:FormElement visible="true">
								<form:label>
									<Label text="{i18n>firstQuantity}"/>
								</form:label>
								<form:fields>
									<Input value="{NewLineItems>/Itx4}"/>
								</form:fields>
							</form:FormElement>
							<!--First UoM-->
							<form:FormElement visible="true">
								<form:label>
									<Label text="{i18n>firstuom}"/>
								</form:label>
								<form:fields>
									<ComboBox id="idFirstUoM" selectedKey="{NewLineItems>/Itx3}" items="{ path: '/xSERPERPxCDS_FIRSTUOM' }">
										<core:Item key="{Uom}" text="{Uom}"></core:Item>
									</ComboBox>
								</form:fields>
							</form:FormElement>
						</form:formElements>
						<form:title/>
					</form:FormContainer>
				</form:formContainers>
				<form:layout>
					<form:ResponsiveGridLayout adjustLabelSpan="false" columnsL="2" labelSpanL="3" columnsM="1" labelSpanM="2" labelSpanS="12"/>
				</form:layout>
			</form:Form>
		</content>
		<beginButton>
			<Button text="{i18n>OK}" type="Emphasized" press="onCreateLineItems"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>Cancel}" press="onClose"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>