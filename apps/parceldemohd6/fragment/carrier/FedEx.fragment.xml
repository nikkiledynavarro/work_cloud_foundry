<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<core:Title text="Pickup / Delivery Service"></core:Title>
	<Label text="Drop off Type"/>
	<ComboBox selectedKey="{local>/basic/carrier_data/carrier_options/fdxe/opt02/Dropoff}" items="{/xSERPERPxI_PCDROP}">
		<core:Item text="{Description}" key="{Code}"></core:Item>
	</ComboBox>
	<Label></Label>
	<CheckBox text="Saturday Pickup" tooltip="Saturday Pickup" selected="{local>/basic/carrier_data/carrier_options/fdxe/opt01/Saturdaypick}"/>
	<CheckBox text="Saturday Delivery" tooltip="Saturday Delivery"
		selected="{local>/basic/carrier_data/carrier_options/fdxe/opt01/Saturdaydeliv}"/>
	<Label></Label>
	<CheckBox text="Residential Delivery" tooltip="Residential Delivery"
		selected="{local>/basic/carrier_data/carrier_options/fdxe/opt01/Carrierresid}"/>
	<CheckBox text="FedEX priority Alert" tooltip="FedEX priority Alert"
		selected="{local>/basic/carrier_data/carrier_options/fdxe/opt02/PrioAlert}"/>
	<Label></Label>
	<CheckBox text="Inside Delivery" tooltip="Inside Delivery" selected="{local>/basic/carrier_data/carrier_options/fdxe/opt02/Insidedeliv}"/>
	<CheckBox text="Inside Pickup" tooltip="Inside Pickup" selected="{local>/basic/carrier_data/carrier_options/fdxe/opt02/Insidepickup}"/>
	<Label></Label>
	<CheckBox text="FedEX Priority Alert Plus" tooltip="FedEX Priority Alert Plus"
		selected="{local>/basic/carrier_data/carrier_options/fdxe/opt02/PrioAlertPlus}"/>
	<Label text="C.O.D Collection/Amount" tooltip="Collect On Delivery Collection/Amount"/>
	<ComboBox selectedKey="{local>/basic/carrier_data/carrier_options/fdxe/opt01/Codtype}" items="{/xSERPERPxI_PCCOLL}" id="cbCollTypeFDXE">
		<core:Item text="{Description}" key="{TenderType}"></core:Item>
	</ComboBox>
	<Input placeholder="C.O.D Amount" value="{local>/basic/carrier_data/carrier_options/fdxe/opt01/Codamount}"></Input>
	<core:Title text="Return Service"></core:Title>
	<Label text="Return Service"/>
	<ComboBox id="cbFedExReturnService" items="{/xSERPERPxI_PCRETURNSRV}" change="onChangeReturnService"
		selectedKey="{local>/basic/carrier_data/carrier_options/fdxe/opt01/Returnsrv}">
		<items>
			<core:Item key="{Code}" text="{Description}"/>
		</items>
	</ComboBox>
	<Label text="Reason"/>
	<Input placeholder="Reasons" value="{local>/basic/carrier_data/carrier_options/fdxe/opt01/ReturnReas}"/>
	<Label text="Pickup Ready Date"/>
	<DatePicker placeholder="Date"
		value="{path:'local>/basic/carrier_data/carrier_options/fdxe/opt01/Pickupreadydat', type:'sap.ui.model.type.Date', formatOptions: { pattern: 'MM/dd/yyyy'}}"/>
	<Label text="Pickup Ready Time"/>
	<Input value="{path:'local>/basic/carrier_data/carrier_options/fdxe/opt01/Pickupreadytim/ms', formatter: '.formatter.formatJavascriptTime'}"/>
	<Label text="Pickup Latest Time"/>
	<Input
		value="{path:'local>/basic/carrier_data/carrier_options/fdxe/opt01/Pickuplatesttim/ms', formatter: '.formatter.formatJavascriptTime'}"/>
	<Label text="Courier Instruction"/>
	<Input value="{local>/basic/carrier_data/carrier_options/fdxe/opt01/Courierins}"/>
	<core:Title text="Hazardous Materials"></core:Title>
	<Label text="Commodity Option Type"/>
	<ComboBox selectedKey="{local>/basic/carrier_data/carrier_options/fdxe/opt02/Hazcommopttype}" items="{/xSERPERPxI_PCHAZCOMM}">
		<items>
			<core:Item text="{Description}" key="{Code}"/>
		</items>
	</ComboBox>
	<Label text="Accessibility"/>
	<ComboBox items="{path: '/DomainTextSet', filters: [ {path: 'Domain', operator: 'EQ', value1: '/ERPIS/HAZMATACCESSDOM'} ]}"
		selectedKey="{local>/basic/carrier_data/carrier_options/fdxe/opt02/Hazmataccess}">
		<items>
			<core:Item text="{Description}" key="{= parseInt(${Key})}"/>
		</items>
	</ComboBox>
	<Label text="Emergency Contact/Number"/>
	<Input placeholder="Name" value="{local>/basic/carrier_data/carrier_options/fdxe/opt02/Contactname}"/>
	<Input placeholder="Number" value="{local>/basic/carrier_data/carrier_options/fdxe/opt02/Contactnumber}"/>
	<Label text="Signatory Name/Title"/>
	<Input placeholder="Name" value="{local>/basic/carrier_data/carrier_options/fdxe/opt02/SigContactname}"/>
	<Input placeholder="Title" value="{local>/basic/carrier_data/carrier_options/fdxe/opt02/SigTitle}"/>
	<Label text="Place"/>
	<Input value="{local>/basic/carrier_data/carrier_options/fdxe/opt02/SigPlace}"/>
	<core:Title text="Booking"></core:Title>
	<Label text="Booking Conf No"/>
	<Input value="{local>/basic/carrier_data/carrier_options/fdxe/opt02/Bookcnfno}"/>
	<Label text="No. of pallets"/>
	<Input value="{local>/basic/carrier_data/carrier_options/fdxe/opt02/Palletcnt}"/>
	<Label text="Signature Option"/>
	<ComboBox id="cbSignatureOpt" selectedKey="{local>/basic/carrier_data/carrier_options/fdxe/opt01/Delyconfirm}"
		items="{/xSERPERPxI_PCSIGNATURE}">
		<items>
			<core:Item text="{Description}" key="{Code}"/>
		</items>
	</ComboBox>
	<Label></Label>
	<CheckBox text="Ship Alert" selected="{local>/basic/carrier_data/carrier_options/fdxe/opt02/ShipAlert}"/>
	<CheckBox text="Hold At FedEX location" selected="{local>/basic/carrier_data/carrier_options/fdxe/opt01/Holdatloc}"/>
	<Label></Label>
	<CheckBox text="Ground Electronic C.O.D" tooltip="Ground Electronic C.O.D"
		selected="{local>/basic/carrier_data/carrier_options/fdxe/opt02/Ecod}"/>
	<Label></Label>
	<CheckBox text="International Broker Select" tooltip="International Broker Select"
		selected="{local>/basic/carrier_data/carrier_options/fdxe/opt02/IntlBrokerSel}"/>
</core:FragmentDefinition>