{
  "_version": "1.12.0",
  "sap.app": {
    "id": "comerpisshiperpquickpacksls",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "sap/opu/odata/serperp/QUICK_PACK_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/metadata.xml"
        }
      }
    },
    "sourceTemplate": {
      "id": "sap.ui.ui5-template-plugin.1worklist",
      "version": "1.65.1"
    },
    "crossNavigation": {
      "inbounds": {
        "quickpackslsDisplay": {
          "action": "display",
          "icon": "sap-icon://app",
          "signature": {
            "additionalParameters": "allowed",
            "parameters": {}
          },
          "semanticObject": "quickpacksls",
          "subTitle": "",
          "title": "{{appTitle}}"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://task",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    },
    "fullWidth": true
  },
  "sap.ui5": {
    "resources": {
      "js": [
        {
          "uri": "common/jquery_hotkeys.js"
        }
      ],
      "css": [
        {
          "uri": "css/style.css",
          "id": "stylecss"
        }
      ]
    },
    "rootView": {
      "viewName": "com.erpis.shiperp.sls.quickpacksls.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.60.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.f": {},
        "sap.ushell": {},
        "sap.collaboration": {
          "lazy": true
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.erpis.shiperp.sls.quickpacksls.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true
      }
    },
    "services": {
      "ShellUIService": {
        "factoryName": "sap.ushell.ui5service.ShellUIService",
        "lazy": false,
        "settings": {
          "setTitle": "auto"
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "com.erpis.shiperp.sls.quickpacksls.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "bypassed": {
          "target": [
            "notFound"
          ]
        },
        "async": true
      },
      "routes": [
        {
          "pattern": "",
          "name": "home",
          "target": [
            "home"
          ]
        },
        {
          "pattern": "Profile/{Station}/{Profile}/{InputType}",
          "name": "main",
          "target": [
            "main"
          ]
        }
      ],
      "targets": {
        "home": {
          "viewName": "Home",
          "viewId": "home",
          "viewLevel": 1
        },
        "main": {
          "viewName": "Main",
          "viewId": "main",
          "viewLevel": 2
        },
        "notFound": {
          "viewName": "NotFound",
          "viewId": "notFound"
        }
      }
    }
  },
  "sap.platform.hcp": {
    "uri": "",
    "_version": "1.1.0"
  },
  "sap.cloud": {
    "public": true,
    "service": "comerpisshiperpquickpacksls"
  }
}