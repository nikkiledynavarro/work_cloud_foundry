<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
	<Dialog title="{i18n>foFormFreightOrderTitle} {local>/FreightOrderForm/FreightOrder}">
		<Table class="sapUiTinyMargin border_lightgray_nobottom" width="500px" mode="None"
			items="{path:'local>/FreightOrderForm/ObjectTypes', sorter: { path: 'FreightUnit', descending: false }}">
			<columns>
				<Column hAlign="Center">
					<Text text="{i18n>foFormObjectTypeCol}"/>
				</Column>
				<Column hAlign="Center">
					<Text text="{i18n>foFormPrintPreviewCol}"/>
				</Column>
			</columns>
			<items>
				<ColumnListItem type="Inactive">
					<cells>
						<Text text="{local>ObjectType}"/>
							<Button icon="sap-icon://notes" text="" press="onFormPrintPreviewPressed"/>
					</cells>
				</ColumnListItem>
			</items>
		</Table>
		<buttons>
			<Button text="{i18n>foFormCloseButton}" press="onCloseoFreightOrderFormDialog" type="Reject"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>