					<!--	<core:Item key="{SoldToParty}" text="{Name}"/>-->
					<!--</MultiInput>-->
				</smartFilterBar:customControl>
			</smartFilterBar:ControlConfiguration>
			<smartFilterBar:ControlConfiguration index="6" visible="true" key="DelCreatedBy" visibleInAdvancedArea="false"
				label="{i18n>foDynFilterDelCreatedBy}" filterType="interval" groupId="xSERPTMxFODeliveryFilter">
				<smartFilterBar:customControl>
					<Input value="{DelCreatedBy}"/>
					<!--<MultiInput id="mulDELCreatedBy" showValueHelp="false">-->
					<!--	<core:Item key="{CreatedBy}" text="{Name}"/>-->
					<!--</MultiInput>-->
				</smartFilterBar:customControl>
			</smartFilterBar:ControlConfiguration>
			<smartFilterBar:ControlConfiguration index="7" visible="true" key="DOCreatedOn" visibleInAdvancedArea="false"
				groupId="xSERPTMxFODeliveryFilter" controlType="date" filterType="interval" label="{i18n>foDynFilterDelCreatedOn}">
				<smartFilterBar:customControl>
					<DateRangeSelection delimiter="-" displayFormat="MM/dd/yyyy"/>
				</smartFilterBar:customControl>
			</smartFilterBar:ControlConfiguration>
		</smartFilterBar:controlConfiguration>
		<!-- Purchase Orders Filters-->
		<smartFilterBar:controlConfiguration>
			<smartFilterBar:ControlConfiguration index="1" visible="true" key="PurchasingDocument" visibleInAdvancedArea="false"
				label="{i18n>foDynFilterPoPurDoc}" filterType="interval" groupId="xSERPTMxFOPurchaseOrderFilter">
				<smartFilterBar:customControl>
					<Input value="{PurchasingDocument}"/>
					<!--<MultiInput id="mulPODocument" showValueHelp="false">-->
					<!--	<core:Item key="{PurchasingDocument}" text="{Name}"/>-->
					<!--</MultiInput>-->
				</smartFilterBar:customControl>
			</smartFilterBar:ControlConfiguration>
			<smartFilterBar:ControlConfiguration index="2" visible="true" key="SupplyingPlant" visibleInAdvancedArea="false"
				label="{i18n>foDynFilterPoSupPlant}" filterType="interval" groupId="xSERPTMxFOPurchaseOrderFilter">
				<smartFilterBar:customControl>
					<ComboBox items="{ path: '/xSERPTMxCDS_FOPOSP', sorter: { path: 'SupplyingPlant' } }">
						<core:ListItem key="{SupplyingPlant}" text="{SupplyingPlantText}" additionalText="{SupplyingPlantText}"/>
					</ComboBox>
				</smartFilterBar:customControl>
			</smartFilterBar:ControlConfiguration>
			<smartFilterBar:ControlConfiguration index="3" visible="true" key="PurchaseOrderType" visibleInAdvancedArea="false"
				label="{i18n>foDynFilterPoPurOrdType}" filterType="interval" groupId="xSERPTMxFOPurchaseOrderFilter">
				<smartFilterBar:customControl>
					<ComboBox items="{ path: '/xSERPTMxCDS_FOPOOT', sorter: { path: 'PurchaseOrderType' } }">
						<core:ListItem key="{PurchaseOrderType}" text="{PurchaseOrderTypeText}" additionalText="{PurchaseOrderTypeText}"/>
					</ComboBox>
				</smartFilterBar:customControl>
			</smartFilterBar:ControlConfiguration>
			<smartFilterBar:ControlConfiguration index="4" visible="true" key="Material" visibleInAdvancedArea="false" label="{i18n>foDynFilterPoMat}"
				filterType="interval" groupId="xSERPTMxFOPurchaseOrderFilter">
				<smartFilterBar:customControl>
					<Input value="{Material}"/>
					<!--<MultiInput id="mulPOMaterial" showValueHelp="false">-->
					<!--	<core:Item key="{Material}" text="{Name}"/>-->
					<!--</MultiInput>-->
				</smartFilterBar:customControl>
			</smartFilterBar:ControlConfiguration>
			<smartFilterBar:ControlConfiguration index="5" visible="true" key="POCreatedBy" visibleInAdvancedArea="false"
				label="{i18n>foDynFilterPoCreatedBy}" filterType="interval" groupId="xSERPTMxFOPurchaseOrderFilter">
				<smartFilterBar:customControl>
					<Input value="{POCreatedBy}"/>
					<!--<MultiInput id="mulPOCreatedBy" showValueHelp="false">-->
					<!--	<core:Item key="{CreatedBy}" text="{Name}"/>-->
					<!--</MultiInput>-->
				</smartFilterBar:customControl>
			</smartFilterBar:ControlConfiguration>
			<smartFilterBar:ControlConfiguration index="6" visible="true" key="POCreatedOn" visibleInAdvancedArea="false"
				groupId="xSERPTMxFOPurchaseOrderFilter" controlType="date" filterType="interval" label="{i18n>foDynFilterPOCreatedOn}">
				<smartFilterBar:customControl>
					<DateRangeSelection delimiter="-" displayFormat="MM/dd/yyyy"/>
				</smartFilterBar:customControl>
			</smartFilterBar:ControlConfiguration>
		</smartFilterBar:controlConfiguration>
		<!--end PO-->
	</smartFilterBar:SmartFilterBar>
</core:FragmentDefinition>