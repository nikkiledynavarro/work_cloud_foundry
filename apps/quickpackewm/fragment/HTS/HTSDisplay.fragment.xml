<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<VBox>
		<Toolbar>
			<ToolbarSpacer/>
		</Toolbar>
		<Table id="idHTSList" class="border_lightgray_nobottom" showSeparators="All" growing="false"
			items="{path: 'local>/HTS', templateShareable:false}">
			<headerToolbar>
				<Toolbar>
					<ToolbarSpacer/>
				</Toolbar>
			</headerToolbar>
			<columns>
				<Column width="5rem">
					<Text text="Code"/>
				</Column>
				<Column width="3rem">
					<Text text="ctryOrigin"/>
				</Column>
				<Column width="8rem">
					<Text text="Description"/>
				</Column>
				<Column width="5rem">
					<Text text="Value"/>
				</Column>
				<Column width="5rem">
					<Text text="Currency"/>
				</Column>
				<Column width="4rem">
					<Text text="Weight"/>
				</Column>
				<Column width="4.5rem">
					<Text text="WeightUnit" wrapping="true"/>
				</Column>
				<Column width="4rem">
					<Text text="Quantity"/>
				</Column>
				<Column width="4.5rem">
					<Text text="Unit"/>
				</Column>
				<Column width="4rem">
					<Text text="Quantity"/>
				</Column>
				<Column width="4.5rem">
					<Text text="Unit"/>
				</Column>
				<Column width="5rem">
					<Text text="Export control class"/>
				</Column>
			</columns>
			<items >
				<ColumnListItem type="Active">
					<cells>
						<Text text="{local>htscode}"/>
						<Text text="{local>ctryoforigin}"/>
						<Text text="{local>description}"/>
						<Text text="{local>netvalue}"/>
						<Text text="{local>currency}"/>
						<Text text="{local>weight}"/>
						<Text text="{local>weight_unit}"/>
						<Text text="{local>qty}"/>
						<Text text="{local>uom}"/>
						<Text text="{local>qty2}"/>
						<Text text="{local>uom2}"/>
						<Text text="{local>alumn}"/>
					</cells>
				</ColumnListItem>
			</items>
		</Table>
	</VBox>
</core:FragmentDefinition>