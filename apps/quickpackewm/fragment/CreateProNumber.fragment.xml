<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:form="sap.ui.layout.form">
	<Dialog title="Pro Number">
		<content>
			<form:Form width="100%" editable="true" visible="true">
				<form:formContainers>
					<form:FormContainer visible="true">
						<form:formElements>
							<form:FormElement visible="true">
								<form:label>
									<Label text="Enter Track/ Pro Number"/>
								</form:label>
								<form:fields>
									<Input id="txtLTL"/>
								</form:fields>
							</form:FormElement>
						</form:formElements>
						<form:title/>
					</form:FormContainer>
				</form:formContainers>
				<form:layout>
					<form:ResponsiveGridLayout adjustLabelSpan="false" columnsL="2" labelSpanL="3" columnsM="1" labelSpanM="2" labelSpanS="12"/>
				</form:layout>
			</form:Form>
		</content>
			<beginButton>
			<Button text="Continue" icon= "sap-icon://accept" type="Emphasized" press="onAcceptNumber"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>Cancel}" type="Reject" press="onCloseProNumber"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>