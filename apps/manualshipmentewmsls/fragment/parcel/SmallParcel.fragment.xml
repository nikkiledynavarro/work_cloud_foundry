<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Label text="{i18n>Carrier}"/>
	<ComboBox id="cbCarrier" selectionChange="onCarrierChange" items="{local>/CarrierList}" selectedKey="{local>/basic/carrier_data/carrier}">
		<core:Item key="{local>carrier}" text="{local>description}"></core:Item>
	</ComboBox>
	<Label text="{i18n>Service}"/>
	<ComboBox id="selectService" selectedKey="{local>/basic/carrier_data/service}" items="{local>/ServiceList}"
		selectionChange="onServiceChange">
		<core:Item key="{local>service}" text="{local>description}"></core:Item>
	</ComboBox>
	<Label text="Ship Date/ Arrival Date"/>
	<DatePicker placeholder="Shipment Date"
		value="{path:'local>/basic/date_time/shipment_date', type:'sap.ui.model.type.Date', formatOptions: { pattern: 'MM/dd/yyyy'}}"/>
	<DatePicker placeholder="Arrival Date"
		value="{path:'local>/basic/date_time/arrival_date', type:'sap.ui.model.type.Date', formatOptions: { pattern: 'MM/dd/yyyy'}}"/>
	<Label text="Package Type"/>
	<ComboBox id="selectPackage" selectedKey="{local>/basic/misc/package_type}" items="{/xSERPERPxI_PCPACTYPE}">
		<core:Item key="{PackageType}" text="{Description}"></core:Item>
	</ComboBox>
	<Label text="Declared / Insured Value"/>
	<Input value="{local>/basic/international/declared_value}" tooltip="Declared Value" placeholder="Declared Value">
		<layoutData>
			<l:GridData span="XL3 L3 M3 S3"/>
		</layoutData>
	</Input>
	<Text text="{local>/basic/unit/currency}">
		<layoutData>
			<l:GridData span="XL1 L1 M1 S1"/>
		</layoutData>
	</Text>
	<Input value="{local>/basic/insurance/value}" tooltip="Insured Value" placeholder="Insured Value">
		<layoutData>
			<l:GridData span="XL3 L3 M3 S3"/>
		</layoutData>
	</Input>
	<Text text="{local>/basic/unit/currency}">
		<layoutData>
			<l:GridData span="XL1 L1 M1 S1"/>
		</layoutData>
	</Text>
	<Label text="Shipment Description"/>
	<Input value="{local>/basic/misc/description}"/>
	<Label text="Billing Option"/>
	<ComboBox id="cbBillingOptionParcel" selectedKey="{local>/basic/payment/billing_option}" items="{/xSERPERPxCDS_BILLOP}"
		change="onChangeBillingOption">
		<core:Item key="{Code}" text="{Description}"></core:Item>
	</ComboBox>
	<CheckBox text="Prepaid and add"
		selected="{= (${local>/basic/payment/ppaid_add} &amp;&amp; ${local>/basic/payment/billing_option} ==='PPAID') ? true: false }"
		select="onPrepaidSelect"/>
	<Label text="Third Party Account"/>
	<Input value="{local>/basic/payment/thirdpartyacct}" placeholder="Account"/>
	<Label text="Third Party Zip"/>
	<Input value="{local>/basic/payment/thirdpartyzip}" placeholder="Zip code"/>
	<Label text="Third Party Country"/>
	<ComboBox id="cbThirdPartyCountry" selectedKey="{local>/basic/payment/thirdpartyctry}" tooltip="Country"
		items="{path: '/xSERPERPxI_PCCNTR', length: 999}">
		<core:Item text="{Name}" key="{Country}"/>
	</ComboBox>
	<Label></Label>
	<Button text="{i18n>References}" press="onBtnPressRefChange" type="Emphasized"/>
	<Button text="{i18n>ResetBizrule}" press="onResetBizrule" type="Emphasized"/>
</core:FragmentDefinition>