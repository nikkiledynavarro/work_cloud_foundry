<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<FlexBox justifyContent="SpaceBetween" alignItems="Start" wrap="{= ${device>/system/desktop} ? 'NoWrap': 'Wrap' }" renderType="Bare">
		<ScrollContainer height="500px" vertical="true" horizontal="false" class="sapUiSmallMarginEnd">
			<Table width="{= ${device>/system/desktop} || (${device>/system/tablet} &amp;&amp; ${device>/orientation/landscape} ) ? 'auto' : 'auto' }"
				items="{path: 'local>/aManshipContents', sorter: { path: 'deliveryitem', descending: false }}" id="tableContens" mode="MultiSelect"
				growing="false" class="border_lightgray_nobottom" fixedLayout="true">
				<!--Replace Totes Table with Contents Table-->
				<headerToolbar>
					<Toolbar>
						<Title text="Contents"/>
						<ToolbarSpacer/>
						<Button icon="sap-icon://add" tooltip="Add Product Detail" press="onAddProductDetail"
							enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"/>
						<Button press="onDeleteItems" icon="sap-icon://delete" tooltip="Delete Selected"
							enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"/>
						<Button press="onDeleteAllItems" icon="sap-icon://sys-cancel" tooltip="Delete All"
							enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"/>
					</Toolbar>
				</headerToolbar>
				<columns>
					<Column width="auto">
						<Text text="Line"/>
					</Column>
					<Column width="auto">
						<Text text="Product"/>
					</Column>
					<Column width="auto" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="Description"/>
					</Column>
					<Column width="auto" hAlign="Center">
						<Text text="Quantity" tooltip="Quantity"/>
					</Column>
					<Column width="auto" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="UoM" tooltip="UoM"/>
					</Column>
					<Column width="auto" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="Net Value" tooltip="Net Value"/>
					</Column>
					<Column width="auto" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="Unit Price"/>
					</Column>
					<Column width="auto" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="Currency"/>
					</Column>
					<Column width="auto" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="Weight"/>
					</Column>
					<Column width="auto" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="Weight Unit"/>
					</Column>
					<Column width="auto" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="HTS Code"/>
					</Column>
					<Column width="auto" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="COO"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{local>Line}"/>
							<Text text="{local>Productno}"/>
							<Text text="{local>ProductText}"/>
							<Text text="{local>Qty}"/>
							<Text text="{local>Uom}"/>
							<Text text="{local>Netvalue}"/>
							<Text text="{local>Unitprice}"/>
							<Text text="{local>Currency}"/>
							<Text text="{local>Weight}"/>
							<Text text="{local>Weightunit}"/>
							<Text text="{local>Harmonizedcode}"/>
							<Text text="{local>Ctryoforigin}"/>
							<!--<Text text="{local>Sel}"/>-->
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</ScrollContainer>
		<!--<ScrollContainer height="500px" vertical="true" horizontal="false">-->
		<ScrollContainer height="500px" vertical="true" horizontal="false">
			<Table id="tableHU" selectionChange="onSelectionChange" fixedLayout="true"
				width="{= ${device>/system/desktop} || (${device>/system/tablet} &amp;&amp; ${device>/orientation/landscape} ) ? 'auto' : 'auto' }"
				items="{path: 'local>/HUS', sorter: { path: 'Outbhu', descending: false }}" mode="MultiSelect" growing="true" keyboardMode="Edit"
				growingThreshold="99999" class="border_lightgray_nobottom" updateFinished="onHUTableUpdateFinished">
				<headerToolbar>
					<Toolbar>
						<Title text="Handling Units {= (${local>/basic/carrier_data/mps/mpstype} === '02')? ' / Multi' : '' }"/>
						<ToolbarSpacer/>
						<ComboBox width="10rem" id="cbWeightScale" selectedKey="{local>/UseScale}" tooltip="Weight Scale Options"
							selectionChange="onChangeScaleOption" enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"
							items="{path: '/DomainTextSet', filters: [ {path: 'Domain', operator: 'EQ', value1: '/ERPIS/SCALEINTEGRATIONDOM'} ]}">
							<core:Item text="{Key} - {Description}" key="{Key}"/>
						</ComboBox>
						<Button icon="sap-icon://multiselect-all" tooltip="Update weight scale of all items" press="onMassUpdateScales"
							enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"/>
						<ToolbarSeparator/>
						<Button icon="sap-icon://alert" tooltip="Hazardous" enabled="{= (${local>/basic/shipment_flags/hazmatflag} === true) ? true : false }"
							press="onHazardousPress"/>
						<Button press="onPrintShipLabel" icon="sap-icon://print" tooltip="Print Shipping Label"
							enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ||(${local>/printEnabled}) ? true : false }"/>
						<Button icon="sap-icon://add" tooltip="New HU" press="onAddNewHU"
							enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"/>
						<Button press="onDeleteHU" icon="sap-icon://delete" tooltip="Delete Selected HU"
							enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"/>
						<Button press="onDeleteAllHU" icon="sap-icon://sys-cancel" tooltip="Delete all"
							enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"/>
					</Toolbar>
				</headerToolbar>
				<columns>
					<Column width="auto">
						<Text text="DG"/>
					</Column>
					<Column width="auto">
						<Text text="HU No."/>
					</Column>
					<Column width="auto" hAlign="Center">
						<Text text="Track"/>
					</Column>
					<Column width="auto">
						<Text text="Matl" wrapping="false"/>
					</Column>
					<Column hAlign="Center" width="auto">
						<Text text="StBin"/>
					</Column>
					<Column hAlign="Center" width="auto">
						<Text text="Wgt"/>
					</Column>
					<Column hAlign="Center" width="auto">
						<Text text="WUnit"/>
					</Column>
					<Column hAlign="Center" width="auto" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="L"/>
					</Column>
					<Column hAlign="Center" width="auto" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="W"/>
					</Column>
					<Column hAlign="Center" width="auto" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="H"/>
					</Column>
					<Column hAlign="Center" width="auto">
						<Text text="UoM"/>
					</Column>
					<Column hAlign="Center" width="auto"
						visible="{= ${local>/UseScale} === '0001' || ${local>/UseScale} === '0002' || ${local>/UseScale} === '0004' ? true : false }">
						<Text text="Action"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem type="Navigation" press="onHandleItemsPackingMoreOption">
						<cells>
							<ObjectStatus state="{path: 'local>Statusdg', formatter: '.formatter.trafficIconDG'}" class="sapUiSmallMarginEnd"
								icon="{path: 'local>Statusdg', formatter: '.formatter.trafficDisplayIcon'}"
								tooltip="{path: 'local>Statusdg', formatter: '.formatter.trafficToopTipDG'}"/>
							<Text text="{path:'local>Outbhu', formatter: '.formatter.removeLeadingZero'}" tooltip="{local>Outbhu}" wrapping="false"/>
							<!--<Link enabled="{= (${local>Hu_Items/results/length} > 0) || (${local>Trackingnumber}.length >= 0) ? true : false }"-->
							<!--	text="{path:'local>Outbhu', formatter: '.formatter.removeLeadingZero'}" tooltip="{local>Outbhu}" wrapping="false"/>-->
							<core:Icon press="onShowTrackingnumberPress" color="green" src="sap-icon://accept"
								visible="{= ${local>Trackingnumber}.length > 0 ? true: false}" tooltip="{local>Trackingnumber}"/>
							<Text text="{local>Pmat}" tooltip="{local>Pmat}" wrapping="false"/>
							<Text text="{local>LgplaPa}" tooltip="{local>LgplaPa}" wrapping="false"/>
							<FlexBox justifyContent="Center" alignItems="Center" direction="Column">
								<Input type="Number" visible="{parts:['i18n>true','local>Outbhu','i18n>weight'], formatter: '.editFreightUnit' }"
									enabled="{= (${path: 'local>Trackingnumber', formatter: '.formatter.removeLeadingZero'} ==='' ) ? true : false}"
									value="{path: 'local>Weight'}" submit="onGoNextLineItem" change="onGoToSetWeightDimColumn"
									tooltip="{path: 'local>Weight', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"></Input>
								<Text visible="{parts:['i18n>false','local>Outbhu', 'i18n>weight'], formatter: '.editFreightUnit' }" wrapping="false" class="display_inline"
									text="{path: 'local>Weight', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"
									tooltip="{path: 'local>Weight', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"/>
							</FlexBox>
							<FlexBox justifyContent="Center" alignItems="Center" direction="Column">
								<Input visible="{parts:['i18n>true','local>Outbhu','i18n>dims_unit'], formatter: '.editFreightUnit' }" value="{local>Weightunit}"
									enabled="{= (${path: 'local>Trackingnumber', formatter: '.formatter.removeLeadingZero'} ==='' &amp;&amp; ${local>/UseScale} === '0003') ? true : false}"
									submit="onGoNextLineItem" tooltip="{local>Weightunit}"></Input>
								<Text wrapping="false" visible="{parts:['i18n>false','local>Outbhu','i18n>dims_unit'], formatter: '.editFreightUnit' }"
									class="display_inline" text="{local>Weightunit}" tooltip="{local>Weightunit}"/>
							</FlexBox>
							<FlexBox justifyContent="Center" alignItems="Center" direction="Column">
								<Input type="Number" visible="{parts:['i18n>true','local>Outbhu'], formatter: '.editFreightUnit' }" value="{local>Laeng}"
									enabled="{= (${path: 'local>Trackingnumber', formatter: '.formatter.removeLeadingZero'} ==='') ? true : false}"
									change="onGoToSetWeightDimColumn" submit="onGoNextLineItem"
									tooltip="{path: 'local>Laeng', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"></Input>
								<Text wrapping="false" visible="{parts:['i18n>false','local>Outbhu'], formatter: '.editFreightUnit' }" class="display_inline"
									text="{path: 'local>Laeng', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"
									tooltip="{path: 'local>Laeng', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"/>
							</FlexBox>
							<FlexBox justifyContent="Center" alignItems="Center" direction="Column">
								<Input type="Number" visible="{parts:['i18n>true','local>Outbhu'], formatter: '.editFreightUnit' }" value="{path: 'local>Breit'}"
									enabled="{= (${path: 'local>Trackingnumber', formatter: '.formatter.removeLeadingZero'} ==='') ? true : false}"
									change="onGoToSetWeightDimColumn" submit="onGoNextLineItem"
									tooltip="{path: 'local>Breit', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"></Input>
								<Text wrapping="false" visible="{parts:['i18n>false','local>Outbhu'], formatter: '.editFreightUnit' }" class="display_inline"
									text="{path: 'local>Breit', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"
									tooltip="{path: 'local>Breit', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"/>
							</FlexBox>
							<FlexBox justifyContent="Center" alignItems="Center" direction="Column">
								<Input type="Number" visible="{parts:['i18n>true','local>Outbhu'], formatter: '.editFreightUnit' }" value="{path: 'local>Hoehe'}"
									enabled="{= (${path: 'local>Trackingnumber', formatter: '.formatter.removeLeadingZero'} ==='') ? true : false}"
									change="onGoToSetWeightDimColumn" submit="onGoNextLineItem"
									tooltip="{path: 'local>Hoehe', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"></Input>
								<Text wrapping="false" visible="{parts:['i18n>false','local>Outbhu'], formatter: '.editFreightUnit' }" class="display_inline"
									text="{path: 'local>Hoehe', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"
									tooltip="{path: 'local>Hoehe', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"/>
							</FlexBox>
							<FlexBox justifyContent="Center" alignItems="Center" direction="Column">
								<Input visible="{parts:['i18n>true','local>Outbhu','i18n>dims_unit'], formatter: '.editFreightUnit' }" value="{local>Meabm}"
									enabled="{= (${path: 'local>Trackingnumber', formatter: '.formatter.removeLeadingZero'} ==='' &amp;&amp; ${local>/UseScale} === '0003') ? true : false}"
									submit="onGoNextLineItem" tooltip="{local>Meabm}"></Input>
								<Text wrapping="false" visible="{parts:['i18n>false','local>Outbhu','i18n>dims_unit'], formatter: '.editFreightUnit' }"
									class="display_inline" text="{local>Meabm}" tooltip="{local>Meabm}"/>
							</FlexBox>
							<FlexBox justifyContent="Center" alignItems="Center">
								<ToggleButton icon="sap-icon://edit"
									visible="{= ( (${local>/UseScale} === '0002' || ${local>/UseScale} === '0004' || ${local>/UseScale} === '0001' ) &amp;&amp; ${local>Trackingnumber} ==='') ? true : false }"
									press="onEditItemPackingPress" pressed="{parts:['i18n>true','local>Outbhu'], formatter: '.editFreightUnit' }"></ToggleButton>
								<ToggleButton icon="sap-icon://activate"
									visible="{= (${local>/UseScale} === '0001' &amp;&amp; ${local>Trackingnumber} ==='') ? true : false }" press="onReupdateItemScalePress"></ToggleButton>
							</FlexBox>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</ScrollContainer>
		<!--</ScrollContainer>-->
	</FlexBox>
</core:FragmentDefinition>