<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Label text="Carrier Code"/>
	<Input editable="false" value="{local>/PreviousShipment/carrier}"></Input>
	<Label text="Carrier Service"/>
	<Input editable="false" value="{local>/PreviousShipment/service}"></Input>
	<Label text="Billing Option"/>
	<Input editable="false" value="{local>/PreviousShipment/billing_option}"></Input>
	<Label text="Ship Date"/>
	<Input editable="false"
		value="{path:'local>/PreviousShipment/shipment_date', type:'sap.ui.model.type.Date', formatOptions: { pattern: 'MM/dd/yyyy'}}"></Input>
	<Label text="Weight"/>
	<Input editable="false" value="{local>/PreviousShipment/weight}"></Input>
	<Label text="Rate"/>
	<Input editable="false" value="{local>/PreviousShipment/rate}"></Input>
	<Label text="Tracking Number"/>
	<Input editable="false" value="{local>/PreviousShipment/trackingno}"></Input>
</core:FragmentDefinition>