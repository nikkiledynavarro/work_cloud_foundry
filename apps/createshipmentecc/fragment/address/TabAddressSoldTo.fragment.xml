<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
		adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="3" columnsL="2" columnsM="2"
		singleContainerFullSize="false">
		<f:content>
			<core:Title text="Customer Info"></core:Title>
			<Label text="Name/Attention"/>
			<Input enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }" placeholder="Name" tooltip="Name"
				value="{local>/basic/partners/soldto/address/name1}"></Input>
			<Input enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }" placeholder="Attention" tooltip="Attention"
				value="{local>/basic/partners/soldto/address/name2}"></Input>
			<Label text="Address 1/2"/>
			<Input enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }" placeholder="Address 1" tooltip="Address 1"
				value="{local>/basic/partners/soldto/address/street1}"></Input>
			<Input enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }" placeholder="Address 2" tooltip="Address 2"
				value="{local>/basic/partners/soldto/address/street2}"></Input>
			<Label text="Address 3/4"/>
			<Input enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }" placeholder="Address 3" tooltip="Address 3"
				value="{local>/basic/partners/soldto/address/street3}"></Input>
			<Input enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }" placeholder="Address 4" tooltip="Address 4"
				value="{local>/basic/partners/soldto/address/street4}"></Input>
			<Label text="Phone/Fax"/>
			<Input enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }" placeholder="Phone" tooltip="Phone"
				value="{local>/basic/partners/soldto/address/telephone}"></Input>
			<Input enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }" placeholder="Fax" tooltip="Fax"
				value="{local>/basic/partners/soldto/address/fax}"></Input>
			<core:Title text="Location"></core:Title>
			<Label text="Country"/>
			<ComboBox selectedKey="{local>/basic/partners/soldto/address/country}" tooltip="Country" items="{path: '/xSERPERPxI_PCCNTR', length: 999}"
				enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }" app:nextUpdate="slSoldToState">
				<items>
					<core:Item text="{Name}" key="{Country}"/>
				</items>
			</ComboBox>
			<Label text="Region"></Label>
			<ComboBox id="slSoldToState" tooltip="State" change="onUpdateDomestic" selectedKey="{local>/basic/partners/soldto/address/state}"
				enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }" items="{path: '/xSERPERPxI_PCSTATE', length: 999}">
				<items>
					<core:Item text="{Description}" key="{Region}"/>
				</items>
			</ComboBox>
			<Label text="City"/>
			<Input enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }" placeholder="City"
				value="{local>/basic/partners/soldto/address/city}"></Input>
			<Label text="Postal"/>
			<Input enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }" placeholder="Postal Code"
				value="{local>/basic/partners/soldto/address/postalcode}"/>
		</f:content>
	</f:SimpleForm>
</core:FragmentDefinition>