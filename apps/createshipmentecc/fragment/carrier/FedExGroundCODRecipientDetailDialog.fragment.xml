<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<Dialog title="{i18n>codRecipientDetailTitleFDXG}" class="sapUiContentPadding" contentWidth="900px">
		<content>
			<VBox class="sapUiSmallMargin">
				<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="4"
					adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1"
					singleContainerFullSize="false">
					<f:content>
						<Label text="C.O.D Account"/>
						<Input value="{local>/basic/carrier_data/carrier_options/fdxg/opt02/cod_acct_num}"/>
						<Label text="C.O.D Tin Type"/>
						<ComboBox items="{/xSERPERPxCDS_FDX_TINTY}" selectedKey="{local>/basic/carrier_data/carrier_options/fdxg/opt02/cod_tin}">
							<core:Item key="{Code}" text="{Description}"/>
						</ComboBox>
						<Label text="C.O.D Tin Number"/>
						<Input value="{local>/basic/carrier_data/carrier_options/fdxg/opt02/codtin_type}"/>
					</f:content>
				</f:SimpleForm>
				<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="4"
					adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1"
					singleContainerFullSize="false" title="C.O.D. Recipient Address">
					<f:content>
						<Label text="Name"/>
						<Input value="{local>/basic/partners/shipfrom/address/name1}"/>
						<Label text="Attention"/>
						<Input value="{local>/basic/partners/shipfrom/address/name2}"/>
						<Label text="Addr1"/>
						<Input value="{local>/basic/partners/shipfrom/address/street1}"/>
						<Label text="Addr2"/>
						<Input value="{local>/basic/partners/shipfrom/address/street2}"/>
						<Label text="City"/>
						<Input value="{local>/basic/partners/shipfrom/address/city}"/>
						<Label text="State/Prov"/>
						<ComboBox items="{path: '/xSERPERPxI_PCSTATE', length: 999}" id="slCODRecipientFDXG" change="onUpdateDomesticDialog">
							<!-- selectedKey="{local>/basic/partners/shipfrom/address/state}"-->
							<items>
								<core:Item text="{Description}" key="{Region}"/>
							</items>
						</ComboBox>
						<Label text="Postal Code"/>
						<Input value="{local>/basic/partners/shipfrom/address/postalcode}"/>
						<Label text="Country"/>
						<ComboBox items="{path: '/xSERPERPxI_PCCNTR', length: 999}" selectedKey="{local>/basic/partners/shipfrom/address/country}"
							app:nextUpdate="slCODRecipientFDXG" change="onUpdateDomesticDialog">
							<!--change="onUpdateDomesticDialog" -->
							<items>
								<core:Item text="{Name}" key="{Country}"/>
							</items>
						</ComboBox>
						<Label text="Phone/ Fax"/>
						<Input value="{local>/basic/partners/shipfrom/address/telephone}"/>
						<Input value="{local>/basic/partners/shipfrom/address/fax}"/>
					</f:content>
				</f:SimpleForm>
			</VBox>
		</content>
		<!--<beginButton>-->
		<!--	<Button text="Continue" type="Emphasized" press="onCODRecipientDetailPress"/>-->
		<!--</beginButton>-->
		<endButton>
			<Button press="onCODFDXGRecipientDetailClose" text="{i18n>Cancel}"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>