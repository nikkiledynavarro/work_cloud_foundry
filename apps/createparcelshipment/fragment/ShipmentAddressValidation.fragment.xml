<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:form="sap.ui.layout.form">
	<Dialog title="Warning" icon="sap-icon://alert" contentWidth="500px">
		<content>
			<Table items="{local>/aMessagesValidateShipment}" class="border_lightgray_nobottom" mode="None">
				<columns>
					<Column vAlign="Middle" hAlign="Begin">
						<Text text=""/>
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<ObjectStatus state="{path: 'local>type', formatter: '.formatter.trafficIconMessages'}" class="sapUiSmallMarginEnd"
								icon="{path: 'local>type', formatter: '.formatter.formatmessage'}" text="{local>title}"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<beginButton>
			<Button text=" Proceed with shipment " type="Accept" press="onAcceptProcessShipment"/>
		</beginButton>
		<endButton>
			<Button text=" Cancel " type="Reject" press="onCancelProcessShipment"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>