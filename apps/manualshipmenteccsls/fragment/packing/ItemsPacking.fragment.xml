<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<FlexBox justifyContent="SpaceBetween" alignItems="Start" wrap="{= ${device>/system/desktop} ? 'NoWrap': 'Wrap' }" renderType="Bare">
		<ScrollContainer height="500px" vertical="true" horizontal="false" class="sapUiSmallMarginEnd">
			<Table width="{= ${device>/system/desktop} || (${device>/system/tablet} &amp;&amp; ${device>/orientation/landscape} ) ? 'auto' : 'auto' }"
				items="{path: 'local>/aManshipContents', sorter: { path: 'deliveryitem', descending: false }}" id="tableContens" mode="MultiSelect"
				growing="false" class="border_lightgray_nobottom" fixedLayout="true">
				<!--Replace Totes Table with Contents Table-->
				<headerToolbar>
					<Toolbar>
						<Title text="Contents"/>
						<ToolbarSpacer/>
						<Button icon="sap-icon://add" tooltip="Add Product Detail" press="onAddProductDetail"
							enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"/>
						<Button press="onDeleteItems" icon="sap-icon://delete" tooltip="Delete Selected"
							enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"/>
						<Button press="onDeleteAllItems" icon="sap-icon://sys-cancel" tooltip="Delete All"
							enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"/>
					</Toolbar>
				</headerToolbar>
				<columns>
					<Column width="3rem">
						<Text text="Item"/>
					</Column>
					<Column width="7rem">
						<Text text="Mat.No."/>
					</Column>
					<Column width="2rem" hAlign="Center">
						<Text text="Total" tooltip="Total Quantity"/>
					</Column>
					<Column width="3.2rem" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="Balance" tooltip="Balance Quantity"/>
					</Column>
					<Column width="3rem" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="Partial" tooltip="Partial Quantity"/>
					</Column>
					<Column width="2rem" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="UoM"/>
					</Column>
					<Column width="2rem" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="Wgt"/>
					</Column>
					<Column width="3rem" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="UoM"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{local>deliveryitem}" wrapping="false" tooltip="{local>deliveryitem}"/>
							<Text text="{path:'local>material', formatter: '.formatter.removeLeadingZero'}" wrapping="false" tooltip="{local>material}"/>
							<ObjectStatus text="{local>totalqty}" state="Success"/>
							<ObjectStatus text="{local>openqty}" state="Warning"/>
							<Input type="Number" value="{path: 'local>partialqty', type: 'sap.ui.model.type.Integer', constraints:{minimum:0}}"
								liveChange="onValidateNumber"/>
							<Text text="{local>uom}"/>
							<Text text="{local>weight}"/>
							<Text text="{local>weightunit}"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</ScrollContainer>
		<!---->
		<ScrollContainer height="500px" vertical="true" horizontal="false">
			<Table id="tableHU" selectionChange="onSelectionChange" fixedLayout="true"
				width="{= ${device>/system/desktop} || (${device>/system/tablet} &amp;&amp; ${device>/orientation/landscape} ) ? 'auto' : 'auto' }"
				items="{path: 'local>/Freightunits', sorter: { path: 'freightunitkey', descending: false }}" mode="MultiSelect" growing="true"
				keyboardMode="Edit" growingThreshold="99999" class="border_lightgray_nobottom" updateFinished="onHUTableUpdateFinished">
				<headerToolbar>
					<Toolbar>
						<Title
							text="Freight Units {= (${local>/basic/carrier_data/mps/mps} === 'X' &amp;&amp; ${local>/basic/carrier_data/mps/mpstype} === '02')? ' / Multi' : '' }"/>
						<ToolbarSpacer/>
						<ComboBox width="10rem" id="cbWeightScale" selectedKey="{local>/UseScale}" tooltip="Weight Scale Options"
							selectionChange="onChangeScaleOption" enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"
							items="{path: '/DomainTextSet', filters: [ {path: 'Domain', operator: 'EQ', value1: '/ERPIS/SCALEINTEGRATIONDOM'} ]}">
							<core:Item text="{Key} - {Description}" key="{Key}"/>
						</ComboBox>
						<Button icon="sap-icon://multiselect-all" tooltip="Update weight scale of all items" press="onMassUpdateScales"
							enabled="{= ${local>/basic} &amp;&amp; ${local>/CanShip} === true &amp;&amp; ${local>/UseScale} !== '0001' ? true : false }"/>
						<ToolbarSeparator/>
						<Button icon="sap-icon://alert" tooltip="Hazardous" enabled="{= ${local>/basic/shipment_flags/HazmatExist} ? true : false }"
							press="onHazardousPress"/>
						<Button icon="sap-icon://add" tooltip="New HU" press="onAddNewHU"
							enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"/>
						<Button press="onDeleteHU" icon="sap-icon://delete" tooltip="Delete Selected HU"
							enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"/>
						<Button press="onDeleteAllHU" icon="sap-icon://sys-cancel" tooltip="Delete all"
							enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"/>
					</Toolbar>
				</headerToolbar>
				<columns>
					<Column width="5rem">
						<Text text="HU No."/>
					</Column>
					<Column width="2.5rem" hAlign="Center">
						<Text text="Track"/>
					</Column>
					<Column width="2rem">
						<Text text="Matl" wrapping="false"/>
					</Column>
					<Column hAlign="Center" width="3rem">
						<Text text="Wgt"/>
					</Column>
					<Column hAlign="Center" width="2.5rem">
						<Text text="UoM"/>
					</Column>
					<Column hAlign="Center" width="3rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="L"/>
					</Column>
					<Column hAlign="Center" width="3rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="W"/>
					</Column>
					<Column hAlign="Center" width="3rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
						<Text text="H"/>
					</Column>
					<Column hAlign="Center" width="2.5rem">
						<Text text="UoM"/>
					</Column>
					<Column hAlign="Center" width="3rem"
						visible="{= ${local>/UseScale} === '0001' || ${local>/UseScale} === '0002' || ${local>/UseScale} === '0004' ? true : false }">
						<Text text="Action"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem type="Navigation" press="onHandleItemsPackingMoreOption">
						<cells>
							<Link press="onOpenHUItemsDialog" enabled="{= ${local>FreightunitItems/results/length} > 0 ? true : false }"
								text="{path:'local>freightunitkey', formatter: '.formatter.removeLeadingZero'}" tooltip="{local>freightunitkey}" wrapping="false"/>
							<core:Icon press="onShowTrackingNumberPress" color="green" src="sap-icon://accept"
								visible="{= ${local>trackingnumber}.length > 0 ? true: false}" tooltip="{local>trackingnumber}"/>
							<Text text="{local>packmat}" tooltip="{local>packmat}" wrapping="false"/>
							<FlexBox justifyContent="Center" alignItems="Center" direction="Column">
								<Input type="Number" visible="{parts:['i18n>true','local>freightunitkey','i18n>weight'], formatter: '.editFreightUnit' }"
									enabled="{= (${path: 'local>trackingnumber', formatter: '.formatter.removeLeadingZero'} ==='' ) ? true : false}"
									value="{path: 'local>weight'}" submit="onGoNextLineItem" change="onGoToLengthColumn"
									tooltip="{path: 'local>weight', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"></Input>
								<Text visible="{parts:['i18n>false','local>freightunitkey', 'i18n>weight'], formatter: '.editFreightUnit' }" wrapping="false"
									class="display_inline" text="{path: 'local>weight', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"
									tooltip="{path: 'local>weight', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"/>
							</FlexBox>
							<Text text="{local>weight_unit}"/>
							<FlexBox justifyContent="Center" alignItems="Center" direction="Column">
								<Input type="Number" visible="{parts:['i18n>true','local>freightunitkey'], formatter: '.editFreightUnit' }" value="{local>length}"
									enabled="{= (${path: 'local>trackingnumber', formatter: '.formatter.removeLeadingZero'} ==='') ? true : false}" change="onGoToWidthColumn"
									submit="onGoNextLineItem" tooltip="{path: 'local>length', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"></Input>
								<Text wrapping="false" visible="{parts:['i18n>false','local>freightunitkey'], formatter: '.editFreightUnit' }" class="display_inline"
									text="{path: 'local>length', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"
									tooltip="{path: 'local>length', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"/>
							</FlexBox>
							<FlexBox justifyContent="Center" alignItems="Center" direction="Column">
								<Input type="Number" visible="{parts:['i18n>true','local>freightunitkey'], formatter: '.editFreightUnit' }" value="{path: 'local>width'}"
									enabled="{= (${path: 'local>trackingnumber', formatter: '.formatter.removeLeadingZero'} ==='') ? true : false}" change="onGoToHeightColumn"
									submit="onGoNextLineItem" tooltip="{path: 'local>width', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"></Input>
								<Text wrapping="false" visible="{parts:['i18n>false','local>freightunitkey'], formatter: '.editFreightUnit' }" class="display_inline"
									text="{path: 'local>width', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"
									tooltip="{path: 'local>width', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"/>
							</FlexBox>
							<FlexBox justifyContent="Center" alignItems="Center" direction="Column">
								<Input type="Number" visible="{parts:['i18n>true','local>freightunitkey'], formatter: '.editFreightUnit' }" value="{path: 'local>height'}"
									enabled="{= (${path: 'local>trackingnumber', formatter: '.formatter.removeLeadingZero'} ==='') ? true : false}" change="onGoToUoMColumn"
									submit="onGoNextLineItem" tooltip="{path: 'local>height', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"></Input>
								<Text wrapping="false" visible="{parts:['i18n>false','local>freightunitkey'], formatter: '.editFreightUnit' }" class="display_inline"
									text="{path: 'local>height', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"
									tooltip="{path: 'local>height', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}"/>
							</FlexBox>
							<FlexBox justifyContent="Center" alignItems="Center" direction="Column">
								<Input visible="{parts:['i18n>true','local>freightunitkey','i18n>dims_unit'], formatter: '.editFreightUnit' }" value="{local>dims_unit}"
									enabled="{= (${path: 'local>trackingnumber', formatter: '.formatter.removeLeadingZero'} ==='' &amp;&amp; ${local>/UseScale} === '0003') ? true : false}"
									submit="onGoNextLineItem" tooltip="{local>dims_unit}"></Input>
								<Text wrapping="false" visible="{parts:['i18n>false','local>freightunitkey','i18n>dims_unit'], formatter: '.editFreightUnit' }"
									class="display_inline" text="{local>dims_unit}" tooltip="{local>dims_unit}"/>
							</FlexBox>
							<FlexBox justifyContent="Center" alignItems="Center">
								<ToggleButton icon="sap-icon://edit"
									visible="{= ( (${local>/UseScale} === '0002' || ${local>/UseScale} === '0004' || ${local>/UseScale} === '0001' ) &amp;&amp; ${local>trackingnumber} ==='') ? true : false }"
									press="onEditItemPackingPress" pressed="{parts:['i18n>true','local>freightunitkey'], formatter: '.editFreightUnit' }"></ToggleButton>
								<ToggleButton icon="sap-icon://activate"
									visible="{= (${local>/UseScale} === '0001' &amp;&amp; ${local>trackingnumber} ==='') ? true : false }" press="onReupdateItemScalePress"></ToggleButton>
							</FlexBox>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</ScrollContainer>
	</FlexBox>
</core:FragmentDefinition>