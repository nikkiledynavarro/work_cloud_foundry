<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Dialog title="{i18n>serialDialogTitle}" class="sapUiContentPadding" contentWidth="400px" contentHeight="100%">
		<content>
			<Carousel id="serialCarousel"
				pages="{path: 'local>/MasterSerialList', sorter: [{path: 'posnr', descending: false}, {path: 'vbeln', descending: false}]}"
				pageChanged="onSerialItemChange" height="100%">
				<FlexBox direction="Column">
					<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="4"
						adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1"
						singleContainerFullSize="false">
						<f:content>
							<Label text="{i18n>delivery}/Item"/>
							<Input value="{local>vbeln}" editable="false"/>
							<Input value="{local>posnr}" editable="false"></Input>
							<Label text="Material"></Label>
							<Input value="{local>matnr}" editable="false"></Input>
							<Label text="Created/Total"></Label>
							<Input value="{local>anzser}" editable="false"></Input>
							<Input value="{local>anzsers}" editable="false"></Input>
						</f:content>
					</f:SimpleForm>
					<Table mode="None" class="sapUiTinyMarginTop border_lightgray_nobottom" showSeparators="All" growing="false"
						items="{path: 'local>/SelectedSerial/SerialItemSet/results', templateShareable: true}">
						<headerToolbar>
							<Toolbar>
								<content>
									<Label text="{i18n>serialLb}"/>
									<!--submit="onChangeSerialMultiInput"-->
									<Input liveChange="onAddEventSerialScan" submit="onChangeSerialInputText" showValueHelp="false" editable="{local>/bSerialItemEditable}"/>
									<!--<MultiInput submit="onChangeSerialInputText" liveChange="onChangeSerialMultiInput" enableMultiLineMode="true" showValueHelp="false"-->
									<!--	editable="{local>/bSerialItemEditable}"></MultiInput>-->
									<ToolbarSpacer/>
									<Button text="Clear All" press="onClearSerials" enabled="{local>/bSerialItemEditable}"/>
								</content>
							</Toolbar>
						</headerToolbar>
						<columns>
							<Column hAlign="Center">
								<Text text="{i18n>serialTabColNumber}"/>
							</Column>
						</columns>
						<items >
							<ColumnListItem type="Active">
								<cells>
									<Input value="{local>SERNR}" editable="{local>/bSerialItemEditable}" change="onValidateSerialInput" valueState="None" valueStateText=""/>
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</FlexBox>
			</Carousel>
		</content>
		<beginButton>
			<Button text="Post" type="Emphasized" press="onPostSerialsPress"/>
		</beginButton>
		<endButton>
			<Button press="onCloseSerialDialog" text="Close"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>