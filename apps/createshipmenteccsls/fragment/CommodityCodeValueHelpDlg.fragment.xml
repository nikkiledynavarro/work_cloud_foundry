<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<TableSelectDialog noDataText="{i18n>commodityNoData}"
		title="{i18n>commodityCodeTitle}" liveChange="handleSearchCommCode" confirm="onSelectCommCodeConfirm"
		cancel="handleClose" multiSelect="false"
		items="{ path : 'local>/CommndityCode', sorter : { path : 'ctryoforigin', descending : false } }">
		<ColumnListItem>
			<cells>
				<Text text="{local>ctryoforigin}"/>
				<Text text="{local>stawn}"/>
				<Text text="{local>description}"/>
			</cells>
		</ColumnListItem>
		<columns>
			<Column>
				<header>
					<Text text="{i18n>comodityCountry}"/>
				</header>
			</Column>
			<Column>
				<header>
					<Text text="{i18n>commodityCode}"/>
				</header>
			</Column>
			<Column>
				<header>
					<Text text="{i18n>comodityDescription}"/>
				</header>
			</Column>
		</columns>
	</TableSelectDialog>
</core:FragmentDefinition>