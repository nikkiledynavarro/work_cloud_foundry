	<Input value="{local>/basic/carrier_data/carrier_options/dhl/opt02/Notafiscal}"
		enabled="{= ${local>/OrientationsSet/18/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/18/visible} === '1' ? true : false}"></Input>
	<Label/>
	<CheckBox text="Customs" tooltip="Customs" selected="{local>/basic/carrier_data/carrier_options/dhl/opt01/ChC}"
