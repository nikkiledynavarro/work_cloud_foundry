		visible="{= ${local>/OrientationsSet/0/visible} === '1' ? true : false}"
		selectedKey="{local>/basic/carrier_data/carrier_options/dhl/opt02/Signature}">
		<items>
			<core:ListItem key="{Code}" text="{Description}" additionalText="{Code}"/>
		</items>
	</ComboBox>
</core:FragmentDefinition>