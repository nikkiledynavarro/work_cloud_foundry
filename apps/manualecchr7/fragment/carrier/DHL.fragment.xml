			<core:Item key="{Code}" text="{Description}"/>
		</items>
	</ComboBox>
	<Label></Label>
	<!--{local>/basic/carrier_data/carrier_options/dhl/opt01/Labelregtext}-->
	<Text text="Lithium ion batteries in compliance with Section II of PI965"/>
