		visible="{= ${local>/OrientationsSet/16/visible} === '1' ? true : false}"/>
	<CheckBox text="Break Bulk" tooltip="Break Bulk" selected="{local>/basic/carrier_data/carrier_options/dhl/opt01/ChBb}"
