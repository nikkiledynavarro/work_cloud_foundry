<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Label text="Manual Shiment Category"/>
	<Input editable="true" showValueHelp="true" value="{local>/oManualShipment/Category}" id="idManShipCat" valueHelpRequest="onManShipCategory"
		enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"></Input>
	<Label text="Requestor"/>
	<Input editable="true" value="{local>/oManualShipment/Requestor}" id="idRequestor" liveChange="onChangeManualShiment"
		enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"></Input>
	<Label text="Shipment Description"/>
	<Input editable="true" value="{local>/oManualShipment/ShipDesc}" id="idshipdescipt" liveChange="onChangeManualShiment"
		enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"></Input>
	<Label text="Cost Center"/>
	<Input editable="true" showValueHelp="true" value="{local>/oManualShipment/CostCenter}" id="idCostcenter" valueHelpRequest="onManCostCenter"
		enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"></Input>
	<Label text="Sales District"/>
	<Input editable="true" showValueHelp="true" value="{local>/oManualShipment/Bzirk}" id="idSalesDistrict"
		valueHelpRequest="onManSalesDistrict" enabled="{= (${local>/basic} &amp;&amp; ${local>/CanShip} === true) ? true : false }"></Input>
</core:FragmentDefinition>