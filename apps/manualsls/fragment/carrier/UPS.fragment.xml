<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<core:Title text="Pickup / Delivery Service"></core:Title>
	<Label text="C.O.D Collection" tooltip="Collect On Delivery Collection"
		visible="{= ${local>/OrientationsSet/29/visible} === '1' ? true : false}"
		required="{= ${local>/OrientationsSet/29/visible} === '1' ? true : false}"/>
	<ComboBox id="cbCollType" items="{/xSERPERPxI_PCCOLL}" selectedKey="{local>/basic/carrier_data/carrier_options/ups/opt01/Codtype}"
		enabled="{= ${local>/OrientationsSet/29/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/29/visible} === '1' ? true : false}">
		<core:Item text="{Description}" key="{TenderType}"></core:Item>
	</ComboBox>
	<Label text="C.O.D Amount" tooltip="Collect On Delivery Amount" visible="{= ${local>/OrientationsSet/28/visible} === '1' ? true : false}"
		required="{= ${local>/OrientationsSet/28/visible} === '1' ? true : false}"/>
	<Input placeholder="C.O.D Amount" value="{local>/basic/carrier_data/carrier_options/ups/opt01/Codamount}"
		enabled="{= ${local>/OrientationsSet/28/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/28/visible} === '1' ? true : false}"></Input>
	<Label></Label>
	<CheckBox text="Residential Delivery" tooltip="Residential Delivery"
		selected="{local>/basic/carrier_data/carrier_options/ups/opt01/Carrierresid}"
		enabled="{= ${local>/OrientationsSet/25/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/25/visible} === '1' ? true : false}"/>
	<CheckBox text="Saturday Delivery" tooltip="Saturday Delivery"
		selected="{local>/basic/carrier_data/carrier_options/ups/opt01/Saturdaydeliv}"
		enabled="{= ${local>/OrientationsSet/26/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/26/visible} === '1' ? true : false}"/>
	<core:Title text="Hazardous Materials"></core:Title>
	<Label text="Emergency Contact" visible="{= ${local>/OrientationsSet/59/visible} === '1' ? true : false}"
		required="{= ${local>/OrientationsSet/59/visible} === '1' ? true : false}"/>
	<Input placeholder="Name" value="{local>/basic/carrier_data/carrier_options/ups/opt01/Contactname}"
		enabled="{= ${local>/OrientationsSet/59/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/59/visible} === '1' ? true : false}"/>
	<Label text="Emergency Number" visible="{= ${local>/OrientationsSet/58/visible} === '1' ? true : false}"
		required="{= ${local>/OrientationsSet/58/visible} === '1' ? true : false}"/>
	<Input placeholder="Number" value="{local>/basic/carrier_data/carrier_options/ups/opt01/Contactnumber}"
		enabled="{= ${local>/OrientationsSet/58/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/58/visible} === '1' ? true : false}"/>
	<core:Title text="Verbal Confirmation"></core:Title>
	<Label text="Name" visible="{= ${local>/OrientationsSet/62/visible} === '1' ? true : false}"
		required="{= ${local>/OrientationsSet/62/visible} === '1' ? true : false}"/>
	<Input placeholder="Name" value="{local>/basic/carrier_data/carrier_options/ups/opt01/Verbalconfname}"
		enabled="{= ${local>/OrientationsSet/62/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/62/visible} === '1' ? true : false}"/>
	<Label text="Telephone" visible="{= ${local>/OrientationsSet/61/visible} === '1' ? true : false}"
		required="{= ${local>/OrientationsSet/61/visible} === '1' ? true : false}"/>
	<Input placeholder="Number" value="{local>/basic/carrier_data/carrier_options/ups/opt01/Verbalconfphone}"
		enabled="{= ${local>/OrientationsSet/61/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/61/visible} === '1' ? true : false}"/>
	<Input placeholder="Ext" value="{local>/basic/carrier_data/carrier_options/ups/opt01/Verbalconfext}"
		enabled="{= ${local>/OrientationsSet/63/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/63/visible} === '1' ? true : false}"/>
	<core:Title text="Dry Ice"></core:Title>
	<Label text="Regulation Set" visible="{= ${local>/OrientationsSet/67/visible} === '1' ? true : false}"
		required="{= ${local>/OrientationsSet/67/visible} === '1' ? true : false}"/>
	<ComboBox selectedKey="{local>/basic/carrier_data/carrier_options/ups/opt02/Dryiceregset}"
		items="{path: '/DomainTextSet', filters: [ {path: 'Domain', operator: 'EQ', value1: '/ERPIS/UPSDRYICEDOM'} ]}"
		enabled="{= ${local>/OrientationsSet/67/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/67/visible} === '1' ? true : false}">
		<items>
			<core:Item text="{Description}" key="{Key}"/>
		</items>
	</ComboBox>
	<Label text="Weight/UoM" visible="{= ${local>/OrientationsSet/66/visible} === '1' ? true : false}"
		required="{= ${local>/OrientationsSet/66/visible} === '1' ? true : false}"/>
	<Input placeholder="weight" tooltip="weight" value="{local>/basic/carrier_data/carrier_options/ups/opt02/Dryiceweight}"
		enabled="{= ${local>/OrientationsSet/64/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/64/visible} === '1' ? true : false}"/>
	<Input placeholder="UoM" tooltip="UoM" value="{local>/basic/carrier_data/carrier_options/ups/opt02/Dryiceuom}"
		enabled="{= ${local>/OrientationsSet/66/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/66/visible} === '1' ? true : false}">
		<layoutData>
			<l:GridData span="XL3 L3 M3 S3"/>
		</layoutData>
	</Input>
	<Label/>
	<CheckBox text="Medical Use" tooltip="Medical Use" selected="{local>/basic/carrier_data/carrier_options/ups/opt02/Dryicemeduse}"
		enabled="{= ${local>/OrientationsSet/68/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/68/visible} === '1' ? true : false}"/>
	<core:Title text="Additional Options"></core:Title>
	<Label text="Delivery Conf.ID" visible="{= ${local>/OrientationsSet/30/visible} === '1' ? true : false}"
		required="{= ${local>/OrientationsSet/30/visible} === '1' ? true : false}"/>
	<ComboBox id="cbDeliveryConf" items="{/xSERPERPxI_PCSIGNATURE}"
		selectedKey="{local>/basic/carrier_data/carrier_options/ups/opt01/Delyconfirm}"
		enabled="{= ${local>/OrientationsSet/30/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/30/visible} === '1' ? true : false}">
		<items>
			<core:Item text="{Description}" key="{Code}"/>
		</items>
	</ComboBox>
	<Label text="Return Service Code" visible="{= ${local>/OrientationsSet/40/visible} === '1' ? true : false}"
		required="{= ${local>/OrientationsSet/40/visible} === '1' ? true : false}"></Label>
	<ComboBox id="cbUPSReturnService" items="{/xSERPERPxI_PCRETURNSRV}" change="onChangeReturnService"
		selectedKey="{local>/basic/carrier_data/carrier_options/ups/opt01/Returnsrv}"
		enabled="{= ${local>/OrientationsSet/40/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/40/visible} === '1' ? true : false}">
		<items>
			<core:Item key="{Code}" text="{Description}"/>
		</items>
	</ComboBox>
	<Label text="Return Email" visible="{= ${local>/OrientationsSet/31/visible} === '1' ? true : false}"
		required="{= ${local>/OrientationsSet/31/visible} === '1' ? true : false}"></Label>
	<Input placeholder="Email" value="{local>/basic/carrier_data/carrier_options/ups/opt02/Retsrvemail}"
		enabled="{= ${local>/OrientationsSet/31/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/31/visible} === '1' ? true : false}"/>
	<Label></Label>
	<CheckBox text="Additional Handling" tooltip="Additional Handling"
		selected="{local>/basic/carrier_data/carrier_options/ups/opt01/Addhandling}"
		enabled="{= ${local>/OrientationsSet/37/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/37/visible} === '1' ? true : false}"/>
	<CheckBox text="Shipper Release" tooltip="Shipper Release" selected="{local>/basic/carrier_data/carrier_options/ups/opt01/Shipperrelease}"
		enabled="{= ${local>/OrientationsSet/39/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/39/visible} === '1' ? true : false}"/>
	<Label></Label>
	<CheckBox text="Hold for Pickup" tooltip="Hold for Pickup" selected="{local>/basic/carrier_data/carrier_options/ups/opt01/HoldForPickup}"
		enabled="{= ${local>/OrientationsSet/35/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/35/visible} === '1' ? true : false}"/>
	<CheckBox text="Drop off at UPS Facillity" tooltip="Drop off at UPS"
		selected="{local>/basic/carrier_data/carrier_options/ups/opt01/DropOff}"
		enabled="{= ${local>/OrientationsSet/34/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/34/visible} === '1' ? true : false}"/>
	<Label></Label>
	<CheckBox text="Lift gate for Pickup" tooltip="Lift gate for Pickup"
		selected="{local>/basic/carrier_data/carrier_options/ups/opt01/LiftGatePick}"
		enabled="{= ${local>/OrientationsSet/41/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/41/visible} === '1' ? true : false}"/>
	<CheckBox text="Lift gate for Delivery" tooltip="Lift gate for Delivery"
		selected="{local>/basic/carrier_data/carrier_options/ups/opt01/LiftGateDel}"
		enabled="{= ${local>/OrientationsSet/42/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/42/visible} === '1' ? true : false}"/>
	<Label></Label>
	<CheckBox id="upsAccessPoint" text="Access Point" tooltip="Access Point"
		selected="{local>/basic/carrier_data/carrier_options/ups/opt01/Accesspoint}"
		enabled="{= ${local>/OrientationsSet/38/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/38/visible} === '1' ? true : false}" select="onPressToShowTabUltimateConsignee"/>
	<CheckBox text="Import Control" tooltip="Import Control" enabled="{= ${local>/OrientationsSet/32/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/32/visible} === '1' ? true : false}"
		selected="{local>/basic/carrier_data/carrier_options/ups/opt02/import}"/>
	<Label></Label>
	<CheckBox text="Tax Information Indicator" tooltip="Tax Information Indicator"
		enabled="{= ${local>/OrientationsSet/36/enable} === '1' ? true : false}"
		visible="{= ${local>/OrientationsSet/36/visible} === '1' ? true : false}"
		selected="{local>/basic/carrier_data/carrier_options/ups/opt02/tax_info_ind}"/>
</core:FragmentDefinition>