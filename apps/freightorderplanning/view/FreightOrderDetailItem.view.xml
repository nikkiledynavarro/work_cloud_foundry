<mvc:View controllerName="com.erpis.shiperp.freightorderplanning.controller.FreightOrderDetailItem" xmlns:mvc="sap.ui.core.mvc"
	xmlns:uxap="sap.uxap" xmlns:layout="sap.ui.layout" xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core" xmlns:table="sap.ui.table"
	xmlns:u="sap.ui.unified" xmlns="sap.m" xmlns:html="http://www.w3.org/1999/xhtml" xmlns:l="sap.ui.layout">
	<uxap:ObjectPageLayout id="ObjectPageLayout" showFooter="true" showTitleInHeaderContent="false" upperCaseAnchorBar="false">
		<uxap:headerTitle>
			<uxap:ObjectPageDynamicHeaderTitle>
				<uxap:expandedHeading>
					<FlexBox alignItems="Center" fitContainer="true">
						<Image class="sapUiSmallMarginEnd" src="{path: '', formatter: '.formatter.getTransparentLogoLink' }" height="1.5rem"/>
						<Text text="Freight Order Number: {local>/FreightOrderNumber}" wrapping="true"/>
					</FlexBox>
				</uxap:expandedHeading>
			</uxap:ObjectPageDynamicHeaderTitle>
		</uxap:headerTitle>
		<uxap:headerContent>
			<VBox>
				<form:SimpleForm id="SimpleFormHeader1" title="General Info" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4"
					labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2"
					columnsL="1" columnsM="1" singleContainerFullSize="false">
					<form:content>
						<Label text="{i18n>foDetailItemGeneralCarrier}" required="true"/>
						<Select forceSelection="false" selectedKey="{/Width}">
							<core:Item key="{Width}" text=""/>
						</Select>
						<Label text="{i18n>foItemDetailGeneralService}" required="true"/>
						<Select forceSelection="false" selectedKey="{/Width}">
							<core:Item key="{Width}" text=""/>
						</Select>
						<Label text="{i18n>foItemDetailGeneralShipDateArrivarlDate}" required="true"/>
						<DatePicker value="{local>/FODetailItemGeneral/0/ShipDate}" valueFormat="MM-dd-yyyy" placeholder="Shipment Date"
							class="sapUiSmallMarginBottom" required="true"/>
						<DatePicker value="{local>/FODetailItemGeneral/0/ArrivalDate}" valueFormat="MM-dd-yyyy" placeholder="Arrivarl Date"
							class="sapUiSmallMarginBottom" required="true">
							<layoutData>
								<l:GridData span="XL3 L4 M4 S5"/>
							</layoutData>
						</DatePicker>
						<Label text="{i18n>foItemDetailGeneralDeclaredinsuredvalue}" required="true"/>
						<Input value="{local>/FODetailItemGeneral/0/DeclaredValue}" placeholder="Declared Value"/>
						<Input value="{local>/FODetailItemGeneral/0/InsuredValue}" placeholder="Insured value" required="true">
							<layoutData>
								<l:GridData span="XL3 L4 M4 S5"/>
							</layoutData>
						</Input>
						<Label text="{i18n>foItemDetailGeneralShipmentDescription}"/>
						<Input value="{local>/FODetailItemGeneral/0/ShipmentDesc}"/>
						<Label text="{i18n>foItemDetailGeneralBillingOption}" required="true"/>
						<Select forceSelection="false" selectedKey="{/Width}">
							<core:Item key="{Width}" text=""/>
						</Select>
						<VBox>
							<CheckBox text="{i18n>foItemDetailGeneralPrepaidaddadd}" selected="false"/>
						</VBox>
						<!--<Input value="{local>/FODetailItemGeneral/0/CarrierPhone} " required="true"  width="50%"/>-->
						<Label text="{i18n>foItemDetailGeneralThirdPartyAccount}"/>
						<Input value="{local>/FODetailItemGeneral/0/ThirdPartyAccount}" placeholder="Account"/>
						<Label text="{i18n>foItemDetailGeneralThirdPartyZip}"/>
						<Input value="{local>/FODetailItemGeneral/0/ThirdPartyZip}" placeholder="Zib code"/>
						<Label text="{i18n>foItemDetailGeneralThirdPartyCountry}"/>
						<Select forceSelection="false" selectedKey="{/Width}">
							<core:Item key="{Width}" text=""/>
						</Select>
					</form:content>
				</form:SimpleForm>
			</VBox>
		</uxap:headerContent>
		<!-- Footer-->
		<uxap:sections>
			<uxap:ObjectPageSection titleUppercase="false" title="{i18n>foDetailItemShipFrom}">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>foDetailItemShipFrom}" titleUppercase="false">
						<uxap:blocks>
							<core:Fragment fragmentName="com.erpis.shiperp.freightorderplanning.fragment.freightorderdetailitem.ShipFrom" type="XML"/>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection titleUppercase="false" title="{i18n>foDetailItemShipTo}">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>foDetailItemShipTo}" titleUppercase="false">
						<uxap:blocks>
							<core:Fragment fragmentName="com.erpis.shiperp.freightorderplanning.fragment.freightorderdetailitem.ShipTo" type="XML"/>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection titleUppercase="false" title="{i18n>foItemPackageDetailTitle}">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>foItemDetailGeneralAttachments}" titleUppercase="false">
						<uxap:blocks>
							<core:Fragment fragmentName="com.erpis.shiperp.freightorderplanning.fragment.freightorderdetailitem.PackageDetails" type="XML"/>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
		</uxap:sections>
		<uxap:footer>
			<OverflowToolbar>
				<Button id="popoverButton" icon="sap-icon://message-popup" text="{messageModel>/messagesLength}" type="Emphasized"
					press="handleMessagePopoverPress"/>
				<ToolbarSpacer/>
				<Button type="Accept" text="{i18n>foItemSaveButton}"/>
				<Button type="Emphasized" text="{i18n>foItemCloseButton}" press="onHandleCloseScreen"/>
			</OverflowToolbar>
		</uxap:footer>
	</uxap:ObjectPageLayout>
</mvc:View>