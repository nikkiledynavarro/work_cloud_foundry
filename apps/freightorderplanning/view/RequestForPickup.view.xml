<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns:uxap="sap.uxap" xmlns:layout="sap.ui.layout" xmlns:form="sap.ui.layout.form"
	xmlns:core="sap.ui.core" xmlns:table="sap.ui.table" xmlns:u="sap.ui.unified" xmlns="sap.m"
	controllerName="com.erpis.shiperp.freightorderplanning.controller.RequestForPickup" xmlns:html="http://www.w3.org/1999/xhtml">
	<uxap:ObjectPageLayout id="ObjectPageLayout" showFooter="true" showTitleInHeaderContent="false" upperCaseAnchorBar="false">
		<uxap:headerTitle>
			<uxap:ObjectPageDynamicHeaderTitle>
				<uxap:expandedHeading>
					<FlexBox alignItems="Center" fitContainer="true">
						<Image class="sapUiSmallMarginEnd" src="{path: '', formatter: '.formatter.getTransparentLogoLink' }" height="1.5rem"/>
						<Title text="{i18n>requestRequestPickupTitle}" wrapping="true"/>
					</FlexBox>
				</uxap:expandedHeading>
				<uxap:snappedHeading>
					<FlexBox alignItems="Center" fitContainer="true">
						<Image class="sapUiSmallMarginEnd" src="{path: '', formatter: '.formatter.getTransparentLogoLink' }" height="1.5rem"/>
						<Title text="{i18n>requestRequestPickupTitle}" wrapping="true"/>
					</FlexBox>
				</uxap:snappedHeading>
			</uxap:ObjectPageDynamicHeaderTitle>
		</uxap:headerTitle>
		<uxap:headerContent>
			<VBox>
				<form:SimpleForm id="SimpleFormHeader1" editable="true" layout="ResponsiveGridLayout" title="" labelSpanXL="4" labelSpanL="3" labelSpanM="4"
					labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1"
					singleContainerFullSize="false">
					<form:content>
						<!--<core:Title text=""/>-->
						<!--<Label text="FreightOrder- Testing label"/>-->
						<!--<Text text="{local>/RequestPickupHeaders/0/FreightOrderNumber}"/>-->
						<core:Title text=""/>
						<Label text="{i18n>requestRequestPickupCustomerContact}" required="true"/>
						<Input value="{local>/RequestPickupHeaders/0/CustomerContact}" required="true"/>
						<Label text="{i18n>requestRequesPickupCustomerEmail}" required="true"/>
						<Input value="{local>/RequestPickupHeaders/0/CustomerEmail}" required="true"/>
						<Label text="{i18n>requestRequestPickupCustomerPhone}"/>
						<Input value="{local>/RequestPickupHeaders/0/CustomerPhone}" required="true"/>
						<core:Title text=""/>
						<Label text="{i18n>requestRequestPickupCarrierContact}" required="true"/>
						<Input value="{local>/RequestPickupHeaders/0/CarrierContact}" required="true"/>
						<Label text="{i18n>requestRequestPickupCarrierEmail}" required="true"/>
						<Input value="{local>/RequestPickupHeaders/0/CarrierEmail}" required="true"/>
						<Label text="{i18n>requestRequestPickupCarrierPhone}"/>
						<Input value="{local>/RequestPickupHeaders/0/CarrierPhone}" required="true"/>
					</form:content>
				</form:SimpleForm>
			</VBox>
			<VBox>
				<form:SimpleForm id="SimpleFormHeader2" editable="true" layout="ResponsiveGridLayout" title="" labelSpanXL="4" labelSpanL="3" labelSpanM="4"
					labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1"
					singleContainerFullSize="false">
					<form:content>
						<core:Title text=""/>
						<Label text="{i18n>requestRequestPickupPickupDate}"/>
						<DatePicker value="{local>/RequestPickupHeaders/0/PickupDate}" valueFormat="MM-dd-yyyy" placeholder="Enter Date"
							class="sapUiSmallMarginBottom"/>
						<Label text="{i18n>requestRequestPickupPickupTime}"/>
						<TimePicker value="{local>/RequestPickupHeaders/0/PickupTime}" valueFormat="HH:mm:ss" displayFormat="HH:mm:ss" change="handleChange"
							placeholder="HH:mm:ss"/>
						<core:Title text=""/>
						<Label text="{i18n>requestRequestPickupDoorOpenDate}"/>
						<DatePicker value="{local>/RequestPickupHeaders/0/DoorOpenDate}" valueFormat="MM-dd-yyyy" change="handleChange"/>
						<Label text="{i18n>requestRequestPickupDoorOpenTime}"/>
						<TimePicker value="{local>/RequestPickupHeaders/0/DoorOpenTime}" valueFormat="HH:mm:ss" displayFormat="HH:mm:ss" change="handleChange"
							placeholder="HH:mm:ss"/>
					</form:content>
				</form:SimpleForm>
			</VBox>
			<VBox>
				<form:SimpleForm id="SimpleFormHeader3" editable="true" layout="ResponsiveGridLayout" title="" labelSpanXL="4" labelSpanL="3" labelSpanM="4"
					labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1"
					singleContainerFullSize="false">
					<form:content>
						<core:Title text=""/>
						<Label text="{i18n>requestRequestPickupText}"/>
						<Input value="{local>/RequestPickupHeaders/0/Text}"/>
					</form:content>
				</form:SimpleForm>
			</VBox>
		</uxap:headerContent>
		<uxap:sections>
			<uxap:ObjectPageSection titleUppercase="false" title="Package Details">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>requestRequestPickupDetailsOfThePackages}" titleUppercase="false">
						<uxap:blocks>
							<core:Fragment fragmentName="com.erpis.shiperp.freightorderplanning.fragment.requestforpickup.RequestForPickupPackageDetails" type="XML"/>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
					<uxap:ObjectPageSubSection title="{i18n>requestRequestPickupAttachments}" titleUppercase="false">
						<uxap:blocks>
							<core:Fragment fragmentName="com.erpis.shiperp.freightorderplanning.fragment.requestforpickup.RequestForPickupAttachments" type="XML"/>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
		</uxap:sections>
		<!-- Footer-->
		<uxap:footer>
			<OverflowToolbar>
				<Button id="popoverButton" icon="sap-icon://message-popup" text="{messageModel>/messagesLength}" type="Emphasized"
					press="handleMessagePopoverPress"/>
				<ToolbarSpacer/>
				<Button text="{i18n>backToFOScreenButton}" press="onNavBackToFreightOrderScreen" type="Emphasized"/>
				<Button text="{i18n>sendMailButton}" icon="sap-icon://email" press="onSendEmailPressed" type="Emphasized"/>
				<Button text="{i18n>requestRequestPickupCancelBtn}" press="onNavBackToFreightOrderScreen" type="Reject"/>
			</OverflowToolbar>
		</uxap:footer>
	</uxap:ObjectPageLayout>
</mvc:View>