<core:FragmentDefinition xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core">
	<Dialog title="{i18n>detailDialogCreditAmtTitle}" beforeClose="fnBeforeCloseCreditDialog">
		<l:Grid defaultSpan="L12 M12 S12" width="auto">
			<l:content>
				<f:SimpleForm >
					<f:content>
						<Label text="{parts:['i18n>detailDialogPayamtLabel', 'local>/selectedDisputeDetail/Currency'], formatter: 'jQuery.sap.formatMessage'}"/>
						<FlexBox direction="Column">
							<Input id="idCreditAmountInput" liveChange="fnValidateNumberic" value="{local>/selectedDisputeDetail/CreditAmt}" required="true"
								type="Number" submit="onCreditSave"/>
						</FlexBox>
					</f:content>
				</f:SimpleForm>
			</l:content>
		</l:Grid>
		<buttons>
			<Button text="{i18n>detailDialogPayamtBtnClear}" press="onCreditClear"/>
			<Button text="{i18n>detailDialogPayamtBtnSave}" press="onCreditSave" type="Accept"/>
			<Button text="{i18n>Close}" press="onCreditClose"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>