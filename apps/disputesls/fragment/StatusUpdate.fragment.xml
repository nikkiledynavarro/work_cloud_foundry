<core:FragmentDefinition xmlns:u="sap.ui.unified" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<Dialog title="{i18n>dialogUpdateStatus}" contentHeight="440px">
		<IconTabBar expanded="true" select="onIconSelectTab" id="iconTabStatusUpdate">
			<items>
				<IconTabFilter icon="sap-icon://hint" key="info">
					<f:SimpleForm >
						<f:content>
							<Label text="{i18n>detailDialogStatusUpdateLabel}"/>
							<Select forceSelection="false" items="{local>/disputeStatusList}" selectedKey="{local>/selectedDisputeStatus}">
								<core:Item key="{local>code}" text="{local>description}"/>
							</Select>
							<Label text="{i18n>detailDialogNote}"/>
							<TextArea maxLength="250" value="{local>/selectedDisputeDetail/Note}" rows="3" enabled="{local>/propertyUpdated/isUpdateNote}">
								<layoutData>
									<l:GridData span="XL11 L11 M11 S11"/>
								</layoutData>
							</TextArea>
						</f:content>
					</f:SimpleForm>
				</IconTabFilter>
				<IconTabFilter icon="sap-icon://attachment" key="attachment" enabled="{local>/uploadAttachmentEnabled}">
					<UploadCollection class="border_lightgray_nobottom" multiple="false" change="onUploadChange" id="idStatusUploadFile"
						items="{ path: 'toATTA_CARR', templateShareable: true }" app:objectType="FADISCARR"
						uploadUrl="/sap/opu/odata/SERPERP/FRTA_DISP_SRV/xSERPERPxI_DPDTL_ATTA" mode="SingleSelectLeft" instantUpload="false"
						beforeUploadStarts="onBeforeUpload" showSeparators="All" uploadComplete="onUploadComplete" sameFilenameAllowed="false"
						fileDeleted="onDeleteAttachment">
						<toolbar>
							<OverflowToolbar>
								<Title text="{i18n>Attachments}"/>
								<ToolbarSpacer/>
								<Button icon="sap-icon://less" press="onDeleteAttachment" tooltip="{i18n>toolbarTextDelete}" app:uploadId="idStatusUploadFile"/>
								<UploadCollectionToolbarPlaceholder/>
							</OverflowToolbar>
						</toolbar>
						<items>
							<UploadCollectionItem documentId="{UniqueID}" fileName="{FileName}" mimeType="{FileType}" enableDelete="true" url="{UniqueID}"
								visibleDelete="true" visibleEdit="false" enableEdit="false">
								<attributes>
									<ObjectAttribute title="{i18n>createdOn}" text="{path: 'CreatedOn',formatter: '.formatter.formatDateString'}" active="false"/>
								</attributes>
								<statuses>
									<ObjectStatus title="{i18n>createdBy}" text="{CreatedBy}"/>
								</statuses>
							</UploadCollectionItem>
						</items>
					</UploadCollection>
				</IconTabFilter>
			</items>
		</IconTabBar>
		<buttons>
			<Button text="{i18n>detailDialogPayamtBtnSave}" press="onStatusSave" type="Accept" enabled="{= ${local>/selectedDisputeStatus}.length>0}"
				visible="{=${local>/enabledUploadStatusUpdate}!== true}"/>
			<Button text="{i18n>detailDialogChangeCodeAttachFile}" press="onStatusUploadFiles" visible="{local>/enabledUploadStatusUpdate}"
				type="Emphasized"/>
			<Button text="{i18n>Close}" press="onStatusClose"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>