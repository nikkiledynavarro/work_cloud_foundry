                   {
                       "source":  "^/destinations/Northwind/(.*)$",
                       "target":  "/V2/Northwind/$1",
                       "destination":  "virtual-erps4sales-destination",
                       "authenticationType":  "xsuaa",
                       "csrfProtection":  false
                   },
                   {
                       "source":  "^/sap/opu/odata/(.*)$",
                       "target":  "/sap/opu/odata/$1",
                       "destination":  "virtual-erps4sales-destination",
                       "authenticationType":  "xsuaa",
                       "csrfProtection":  false
                   },
                   {
                       "source":  "^/virtual-erps4sales-destination/(.*)$",
                       "target":  "/$1",
                       "destination":  "virtual-erps4sales-destination",
                       "authenticationType":  "xsuaa",
                       "csrfProtection":  false
                   },
                   {
                       "source":  "^(.*)$",
                       "target":  "$1",
                       "service":  "html5-apps-repo-rt",
                       "authenticationType":  "xsuaa"
                   }
               ]
