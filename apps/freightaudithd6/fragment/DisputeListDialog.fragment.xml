<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
	<Dialog title="{i18n>disputeDialogTitle}">
		<Table id="tbDisputeList" width="400px" class="sapUiTinyMarginBottom"
			items="{ path: 'local>/disputeList', sorter: [{path: 'local>DisputeID'}] }" mode="SingleSelectLeft" includeItemInSelection="true"
			visible="{= ${local>/disputeList}.length>0}" growing="true" growingThreshold="20">
			<headerToolbar>
				<Toolbar>
					<content>
						<SearchField liveChange="onDisputeListSearch" width="100%" class="sapUiSmallMarginEnd"/>
					</content>
				</Toolbar>
			</headerToolbar>
			<columns>
				<Column hAlign="Center"></Column>
			</columns>
			<items>
				<ColumnListItem type="Inactive">
					<cells>
						<Text text="{local>DisputeID}"/>
					</cells>
				</ColumnListItem>
			</items>
		</Table>
		<buttons>
			<Button type="Accept" text="{i18n>createNewDisputeAct}" press="onDisputeListDialogCreate"/>
			<Button type="Emphasized" text="{i18n>consolidate}" press="onDisputeListDialogSelect"/>
			<Button text="{i18n>dialogCancel}" press="onDisputeListDialogClose" type="Reject"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>