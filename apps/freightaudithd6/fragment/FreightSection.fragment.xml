<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form" xmlns:layout="sap.ui.layout">
	<f:SimpleForm id="sfFreight" editable="false" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="12"
		adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="1"
		singleContainerFullSize="false">
		<f:content>
			<!--Freight Info -->
			<core:Title text="{i18n>Freight}"/>
			<Label text="{i18n>Trackpro}"/>
			<Text text="{TrackingNo}"/>
			<Label text="{i18n>BilledWeight}"/>
			<Text text="{BilledWeight}"/>
			<Label text="{i18n>InvOriginalWgt}"/>
			<Text text="{InvoiceOriginalWeight}"/>
			<Label text="{i18n>InvoiceWeight}"/>
			<Text text="{InvoiceWeight}"/>
			<Label text="{i18n>WeightUnit}"/>
			<Text text="{WeightUnit}"/>
			<Label text="{i18n>Master}"/>
			<Text text="{MasterTrackingNo}"/>
			<Label text="{i18n>ServiceType}"/>
			<Text text="{ServiceType}"/>
			<Label text="{i18n>ServiceTypeDesc}"/>
			<Text text="{ServiceTypeDesc}"/>
			<Label text="{i18n>ShipDate}"/>
			<Text text="{path: 'ShipDate', formatter: '.formatter.formatDateString' }"/>
			<Label text="{i18n>PackageType}"/>
			<Text text="{PackageType}"/>
			<!--Freight Payment Info -->
			<core:Title text="{i18n>FreightPayment}"/>
			<Label text="{i18n>PayAmount}"/>
			<Text text="{PayAmount}"/>
			<Label text="{i18n>Currency}"/>
			<Text text="{Currency}"/>
			<Label text="{i18n>PayerNo}"/>
			<Text text="{PayerNo}"/>
			<Label text="{i18n>PayType}"/>
			<Text text="{PayType}"/>
			<Label text="{i18n>PricingZone}"/>
			<Text text="{PricingZone}"/>
			<!--ShipERP Data-->
			<core:Title text="{i18n>ShipERPData}"/>
			<Label text="{i18n>Carrier}"/>
			<Text text="{Carrier}"/>
			<Label text="{i18n>Service}"/>
			<Text text="{Service}"/>
			<Label text="{i18n>Weight}"/>
			<Text text="{SERPWeight}"/>
			<Label text="{i18n>DimWeight}"/>
			<Text text="{SERPTotalDimensionWeight}"/>
			<Label text="{i18n>UOM}"/>
			<Text text="{SERPWeightUoM}"/>
		</f:content>
	</f:SimpleForm>
</core:FragmentDefinition>