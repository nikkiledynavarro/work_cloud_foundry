<mvc:View controllerName="com.erpis.shiperp.sls.cancelshipment.controller.Login" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Page showHeader="false">
		<FlexBox width="auto" height="100%" wrap="Wrap" justifyContent="Center" alignItems="Center"
			class="sapUiSmallMarginBegin sapUiSmallMarginEnd">
			<FlexBox direction="Column" wrap="Wrap" width="auto" height="auto" class="sapUiTinyMargin" justifyContent="Start" alignItems="Start">
				<f:SimpleForm backgroundDesign="Solid" editable="false" layout="ResponsiveGridLayout" title="Shipping Information" class="custom_login">
					<f:content>
						<Label text="Category"/>
						<ComboBox id="cbCategoryApp" selectedKey="{local>/AppCancel}" change="onChangeAppCancel">
							<core:Item key="ECC" text="ECC Cancel"/>
							<core:Item key="EWM" text="EWM Cancel"/>
						</ComboBox>
						<Label text="Warehouse Number"/>
						<Input showValueHelp="true" id="txtWarehouseNumber" visible="{=${local>/AppCancel} === 'EWM'}" valueHelpRequest="onWarehouseNumberRequested" submit="onLoginButtonPressed"/>
						<Label text="Station"/>
						<Input showValueHelp="true" id="idShippingStationInp" valueHelpRequest="onShippingStationRequested" submit="onLoginButtonPressed"/>
						<Label text="Profile"/>
						<Input showValueHelp="true" id="idShippingProfileInp" valueHelpRequest="onShippingProfileRequested" submit="onLoginButtonPressed"/>
						<Button icon="sap-icon://visits" width="50%" text="LOGIN" class="sapUiSmallMarginTop" press="onLoginButtonPressed"></Button>
					</f:content>
				</f:SimpleForm>
			</FlexBox>
		</FlexBox>
	</Page>
</mvc:View>