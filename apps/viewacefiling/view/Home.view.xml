<mvc:View controllerName="com.erpis.shiperp.hr7.viewacefiling.controller.Home" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Page showHeader="false">
		<FlexBox width="auto" height="100%" wrap="Wrap" justifyContent="Center" alignItems="Center"
			class="sapUiSmallMarginBegin sapUiSmallMarginEnd">
			<FlexBox direction="Column" wrap="Wrap" width="auto" height="auto" class="sapUiTinyMargin" justifyContent="Start" alignItems="Start">
				<f:SimpleForm backgroundDesign="Solid" editable="false" layout="ResponsiveGridLayout" title="Ace Information" class="custom_login">
					<f:content>
						<Label text="Profile ID"/>
						<Input showValueHelp="true" valueHelpOnly="true" id="txtProfileId" valueHelpRequest="onAceProfileRequested"/>
						<Button icon="sap-icon://visits" width="50%" text="LOGIN" class="sapUiSmallMarginTop" press="onLogin"></Button>
					</f:content>
				</f:SimpleForm>
			</FlexBox>
		</FlexBox>
	</Page>
</mvc:View>