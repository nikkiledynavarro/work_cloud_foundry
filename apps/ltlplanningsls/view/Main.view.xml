<mvc:View controllerName="com.erpis.shiperp.hr7.ltlplanning.controller.Main" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc"
	xmlns:l="sap.ui.layout" xmlns:core="sap.ui.core" xmlns:f="sap.f" height="100%" xmlns:form="sap.ui.layout.form" xmlns:table="sap.ui.table"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1" xmlns:smartTable="sap.ui.comp.smarttable"
	xmlns:smartFilterBar="sap.ui.comp.smartfilterbar" xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<f:DynamicPage id="dynamicPageCarrier" preserveHeaderStateOnScroll="true" headerExpanded="true" showFooter="true">
		<!--DynamicPage Title -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<FlexBox alignItems="Center">
						<Image class="sapUiSmallMarginEnd" src="{path: '', formatter: '.formatter.getTransparentLogoLink' }" height="1.5rem"/>
					</FlexBox>
				</f:heading>
				<f:snappedContent>
					<Text id="statusText"></Text>
				</f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>
		<!--DynamicPage Header -->
		<f:header>
			<f:DynamicPageHeader>
				<f:content>
					<core:Fragment fragmentName="com.erpis.shiperp.hr7.ltlplanning.fragment.DynamicHeader" type="XML"/>
				</f:content>
			</f:DynamicPageHeader>
		</f:header>
		<!--Dynamic table-->
		<f:content>
			<IconTabBar id="idIconTabBar" select="onQuickFilter" class="border_lightblue_nobottom width_auto sapUiNoContentPadding" expandable="false">
				<items>
					<IconTabFilter icon="sap-icon://my-sales-order" id="iconAllDeli" text="{i18n>allDeliveries}" tooltip="{i18n>allDeliveries}" key="AD"
						count="{dataModel>/AllDeliveries}"/>
					<IconTabSeparator icon="sap-icon://vertical-grip"/>
					<IconTabFilter icon="sap-icon://BusinessSuiteInAppSymbols/icon-year" id="iconOpenDeli" text="{i18n>openDeliveries}"
						tooltip="{i18n>openDeliveries}" key="OD" count="{dataModel>/OpenDeliveries}" iconColor="Negative"/>
					<IconTabFilter icon="sap-icon://shipping-status" id="iconShipments" text="{i18n>withShipments}" tooltip="{i18n>withShipments}" key="WS"
						count="{dataModel>/WithShipment}" iconColor="Critical"/>
					<IconTabFilter icon="sap-icon://BusinessSuiteInAppSymbols/icon-year" id="iconTransportation" text="{i18n>transNumber}"
						tooltip="{i18n>transNumber}" key="TN" count="{dataModel>/TransportationNumber}" iconColor="Positive"/>
					<IconTabSeparator icon="sap-icon://vertical-grip"/>
				</items>
				<content>
					<ScrollContainer horizontal="true" vertical="true">
						<smartTable:SmartTable entitySet="DocumentListSet" id="planningTable" smartFilterId="DynamicFilter" header="{i18n>deliveries}"
							tableBindingPath="dataModel>/deliveries" enableExport="true" beforeExport="onBeforeExport" beforeRebindTable="onBeforeTableRebind"
							useVariantManagement="false" enableAutoBinding="true" showTablePersonalisation="false" showRowCount="true" demandPopin="true">
							<smartTable:customToolbar>
								<OverflowToolbar design="Transparent">
									<ToolbarSpacer/>
									<OverflowToolbarButton icon="sap-icon://lead" tooltip="{i18n>rateQuote}" press="onRateQuote"/>
									<OverflowToolbarButton icon="sap-icon://cart" tooltip="{i18n>rateShop}" press="onRateShop"/>
									<OverflowToolbarButton icon="sap-icon://email" tooltip="{i18n>requestforPickup}" press="onRequestForPickUp"/>
									<OverflowToolbarButton icon="sap-icon://accelerated" tooltip="{i18n>bol}" press="onBol"/>
									<OverflowToolbarButton icon="sap-icon://cancel" tooltip="{i18n>cancel}" press="onCancel"/>
									<OverflowToolbarButton icon="sap-icon://shipping-status" tooltip="{i18n>close}" press="onClose"/>
									<OverflowToolbarButton icon="sap-icon://sort" tooltip="{i18n>sort}" press="onSort"/>
								</OverflowToolbar>
							</smartTable:customToolbar>
							<Table id="tableDeliveries" mode="SingleSelectLeft" selectionChange="onSelectionChange" growing="true" growingThreshold="100"
								showOverlay="false" growingScrollToLoad="false" fixedLayout="true">
								<columns>
									<!--Shipment-->
									<Column hAlign="Center" vAlign="Middle">
										<Text text="{i18n>shipment}" wrapping="false" tooltip="{i18n>shipment}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "Tknum", "columnIndex":"1", "leadingProperty": "Tknum"}'/>
										</customData>
									</Column>
									<!--Delivery-->
									<Column hAlign="Center" vAlign="Middle">
										<Text text="{i18n>delivery}" wrapping="false" tooltip="{i18n>delivery}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "Vbeln", "columnIndex":"2", "leadingProperty": "Vbeln"}'/>
										</customData>
									</Column>
									<!--Transportation document-->
									<Column hAlign="Center" vAlign="Middle">
										<Text text="{i18n>transportationDocument}" wrapping="false" tooltip="{i18n>transportationDocument}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "Trailerdocnum", "columnIndex":"3", "leadingProperty": "Trailerdocnum"}'/>
										</customData>
									</Column>
									<!--Carrier Code-->
									<Column hAlign="Center" vAlign="Middle">
										<Text text="{i18n>carrierCode}" wrapping="false" tooltip="{i18n>carrierCode}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "Carrier", "columnIndex":"4", "leadingProperty": "Carrier"}'/>
										</customData>
									</Column>
									<!--Carrier Service-->
									<Column hAlign="Center" vAlign="Middle">
										<Text text="{i18n>carrierService}" wrapping="false" tooltip="{i18n>carrierService}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "Service", "columnIndex":"5", "leadingProperty": "Service"}'/>
										</customData>
									</Column>
									<!--Tracking Number-->
									<Column hAlign="Center" vAlign="Middle">
										<Text text="{i18n>trackingNumber}" wrapping="false" tooltip="{i18n>trackingNumber}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "Pronumber", "columnIndex":"6", "leadingProperty": "Pronumber"}'/>
										</customData>
									</Column>
									<!--Delivery Date-->
									<Column hAlign="Center" vAlign="Middle">
										<Text text="{i18n>deliveryDate}" wrapping="false" tooltip="{i18n>deliveryDate}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "Lfdat", "columnIndex":"7", "leadingProperty": "Lfdat"}'/>
										</customData>
									</Column>
									<!--Weight UoM-->
									<Column hAlign="Center" vAlign="Middle">
										<Text text="{i18n>weightUoM}" wrapping="false" tooltip="{i18n>weightUoM}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "Gewei", "columnIndex":"8", "leadingProperty": "Gewei"}'/>
										</customData>
									</Column>
									<!--Total Weight-->
									<Column hAlign="Center" vAlign="Middle">
										<Text text="{i18n>totalWeight}" wrapping="false" tooltip="{i18n>totalWeight}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "Btgew", "columnIndex":"9", "leadingProperty": "Btgew"}'/>
										</customData>
									</Column>
									<!--Ship To-->
									<Column hAlign="Center" vAlign="Middle">
										<Text text="{i18n>shipTo}" wrapping="false" tooltip="{i18n>shipTo}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "Shiptoname", "columnIndex":"10", "leadingProperty": "Shiptoname"}'/>
										</customData>
									</Column>
								</columns>
								<items>
									<ColumnListItem vAlign="Middle">
										<cells>
											<!--Shipment-->
											<Text text="{dataModel>Tknum}" tooltip="{i18n>shipment}"/>
											<!--Delivery-->
											<Text text="{dataModel>Vbeln}" tooltip="{i18n>delivery}"/>
											<!--Transportation document-->
											<Text text="{dataModel>Trailerdocnum}" tooltip="{i18n>transportationDocument}"/>
											<!--Carrier Code-->
											<Text text="{dataModel>Carrier}" tooltip="{i18n>carrierCode}"/>
											<!--Carrier Service-->
											<Text text="{dataModel>Service}" tooltip="{i18n>carrierService}"/>
											<!--Tracking Number-->
											<Text text="{dataModel>Pronumber}" tooltip="{i18n>trackingNumber}"/>
											<!--Delivery Date-->
											<Text text="{path:'dataModel>Lfdat', formatter: '.formatter.formatDateString'}" tooltip="{i18n>deliveryDate}"/>
											<!--Weight UoM-->
											<Text text="{dataModel>Gewei}" tooltip="{i18n>weightUoM}"/>
											<!--Total Weight-->
											<ObjectNumber number="{dataModel>Btgew}" unit="" state="" tooltip="{i18n>totalWeight}"/>
											<!--Ship To-->
											<Text text="{dataModel>Shiptoname}" tooltip="{i18n>shipTo}"/>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</smartTable:SmartTable>
					</ScrollContainer>
				</content>
			</IconTabBar>
		</f:content>
		<!--DynamicPage Footer -->
		<f:footer>
			<OverflowToolbar id="idToolbarFooter">
				<Button id="popoverButton" icon="sap-icon://message-popup" text="{messageModel>/messagesLength}" type="Emphasized"
					press="handleMessagePopoverPress"/>
				<ToolbarSpacer/>
				<Button text="{i18n>plan}" id="btnPlan" press="onPlan" type="Emphasized"/>
			</OverflowToolbar>
		</f:footer>
	</f:DynamicPage>
</mvc:View>