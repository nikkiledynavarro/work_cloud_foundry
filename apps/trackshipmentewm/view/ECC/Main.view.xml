<mvc:View controllerName="com.erpis.shiperp.trackshipmentewm.controller.ECC.Main" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc"
	xmlns:l="sap.ui.layout" xmlns:core="sap.ui.core" xmlns:f="sap.f" height="100%" xmlns:form="sap.ui.layout.form" xmlns:table="sap.ui.table"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<f:DynamicPage id="dynamicPageId" preserveHeaderStateOnScroll="true" headerExpanded="true" showFooter="true">
		<!-- DynamicPage Title -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<FlexBox alignItems="Center">
						<Image class="sapUiSmallMarginEnd" src="{path: '', formatter: '.formatter.getTransparentLogoLink' }" height="1.5rem"/>
						<Select width="auto" class="margin_right_5px" id="cbInputType" change="onResetData" items="{/xSERPERPxI_TRACK_INPUTTYPE}">
							<layoutData>
								<OverflowToolbarLayoutData priority="NeverOverflow"/>
							</layoutData>
							<items>
								<core:Item text="{Description}" key="{Shiptypeinput}"></core:Item>
							</items>
							<!--<items>-->
							<!--	<core:Item text="HU" key="8"></core:Item>-->
							<!--	<core:Item text="Delivery" key="3"></core:Item>-->
							<!--	<core:Item text="Tracking Number" key="7"></core:Item>-->
							<!--</items>-->
						</Select>
						<MultiInput submit="onSubmit" id="txtIdECC" width="12rem" placeholder="Enter Number" class="margin_right_5px" showValueHelp="false">
							<layoutData>
								<OverflowToolbarLayoutData priority="NeverOverflow"/>
							</layoutData>
						</MultiInput>
						<Button icon="sap-icon://reset" tooltip="Reset Data" type="Emphasized" press="onResetData" class="margin_right_5px"/>
					</FlexBox>
				</f:heading>
				<f:actions>
					<Button icon="sap-icon://shipping-status" tooltip="Open Parcel App" type="Emphasized" press="onCrossNavigate"
						app:crossNavigate="#Parcel-ship"/>
					<Button icon="sap-icon://sys-cancel" tooltip="Open Cancel App" type="Reject" press="onCrossNavigate" app:crossNavigate="#cancelhr7-Display"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<!-- DynamicPage Header -->
		<f:content>
			<form:SimpleForm >
				<form:toolbar>
					<Toolbar>
						<Title text="Track Shipment"></Title>
						<ToolbarSpacer/>
						<Button icon="sap-icon://print" text="Print POD" type="Emphasized" press="onPrintPOD"/>
					</Toolbar>
				</form:toolbar>
				<form:content>
					<VBox>
						<Table id="idShipmentDetail" items="{path: 'local>/ShipmentFinalData'}" mode="MultiSelect">
							<headerToolbar>
								<Toolbar>
									<Label text="Show"></Label>
									<ComboBox id="numSelected" items="{ path: 'pageModel>/modelData', sorter: { path: 'text' } }" selectedKey="{local>/Pagination/nPage}"
										change="onChangeNum" width="70px">
										<core:Item key="{pageModel>}" text="{pageModel>}"/>
									</ComboBox>
									<Label text="entries"></Label>
									<ToolbarSpacer/>
									<Label text="Search: " visible="false"></Label>
									<SearchField placeholder="" showSearchButton="false" width="15rem" visible="false"/>
								</Toolbar>
							</headerToolbar>
							<columns>
								<Column>
									<ObjectStatus text="Tracking Number"></ObjectStatus>
								</Column>
								<Column hAlign="Center">
									<ObjectStatus icon="sap-icon://sort" text="Master Tracking No."></ObjectStatus>
								</Column>
								<Column hAlign="Center">
									<ObjectStatus icon="sap-icon://sort" text="Carrier"></ObjectStatus>
								</Column>
								<Column hAlign="End">
									<ObjectStatus icon="sap-icon://sort" text="Service"></ObjectStatus>
								</Column>
								<Column hAlign="End">
									<ObjectStatus icon="sap-icon://sort" text="Delivery"></ObjectStatus>
								</Column>
								<Column hAlign="End">
									<ObjectStatus icon="sap-icon://sort" text="Latest Status"></ObjectStatus>
								</Column>
								<Column hAlign="End">
									<ObjectStatus icon="sap-icon://sort" text=""></ObjectStatus>
								</Column>
							</columns>
							<items>
								<ColumnListItem>
									<cells>
										<Link text="{local>TrackingNum}" press="onOpenTrackingStatusDialog" id="trackNum"></Link>
										<Text text="{local>MasterTrack}"></Text>
										<Text text="{local>Carrier}"></Text>
										<Text text="{local>Service}"></Text>
										<Text text="{local>Delivery}"></Text>
										<Text text="{local>Status}"></Text>
										<Text text=""></Text>
									</cells>
								</ColumnListItem>
							</items>
						</Table>
						<FlexBox justifyContent="End" alignItems="Center" class="sapUiTinyMarginTop" visible="{local>/showPagination}">
							<Button text="Previous" id="arrowBack" tooltip="Back" press="onNavBackButtonPress"
								enabled="{=${local>/Pagination/ncurrNum} !== 0 &amp;&amp; ${local>/Pagination/ncurrNum} !== 1}">
								<layoutData>
									<FlexItemData growFactor="0" maxWidth="auto"/>
								</layoutData>
							</Button>
							<Button type="Emphasized" text="{local>/Pagination/ncurrNum}" tooltip="Current Page">
								<layoutData>
									<FlexItemData growFactor="0" maxWidth="auto"/>
								</layoutData>
							</Button>
							<Button text="Next" id="arrowNext" tooltip="Next" press="onNavNextButtonPress"
								enabled="{=${local>/Pagination/ncurrNum} ===${local>/Pagination/Total} ? false : true }">
								<layoutData>
									<FlexItemData growFactor="0" maxWidth="auto"/>
								</layoutData>
							</Button>
						</FlexBox>
					</VBox>
				</form:content>
			</form:SimpleForm>
		</f:content>
