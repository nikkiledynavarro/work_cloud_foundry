{
  "_version": "1.9.0",
  "sap.app": {
    "id": "comerpisshiperptrackshipmentewm",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "TrackShipmentEWM",
    "description": "TrackShipmentEWM",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "EWMService": {
        "uri": "sap/opu/odata/serperp/shipewm_srv/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/metadata.xml"
        }
      },
      "ECCService": {
        "uri": "/sap/opu/odata/serperp/track_shipment_srv/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/ECC/metadata.xml"
        }
      }
    },
    "sourceTemplate": {
      "id": "sap.ui.ui5-template-plugin.1worklist",
      "version": "1.52.7"
    },
    "crossNavigation": {
      "inbounds": {
        "TrackShipmentEWMDisplay": {
          "action": "display",
          "icon": "sap-icon://app",
          "signature": {
            "additionalParameters": "allowed",
            "parameters": {}
          },
          "semanticObject": "TrackShipmentEWM",
          "subTitle": "",
          "title": "TrackShipmentEWM"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://task",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    },
    "fullWidth": true
  },
  "sap.ui5": {
    "resources": {
      "css": [
        {
          "uri": "css/style.css",
          "id": "stylecss"
        }
      ]
    },
    "rootView": {
      "viewName": "com.erpis.shiperp.trackshipmentewm.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.42.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.f": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.erpis.shiperp.trackshipmentewm.i18n.i18n"
        }
      },
      "": {
        "dataSource": "ECCService",
        "settings": {
          "useBatch": true,
          "refreshAfterChange": false
        },
        "preload": true
      },
      "ECCService": {
        "dataSource": "ECCService",
        "settings": {
          "useBatch": true,
          "refreshAfterChange": false
        },
        "preload": true
      },
      "EWMService": {
        "dataSource": "EWMService",
        "settings": {
          "useBatch": true,
          "refreshAfterChange": false
        },
        "preload": true
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "com.erpis.shiperp.trackshipmentewm.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "bypassed": {
          "target": [
            "notFound"
          ]
        },
        "async": true
      },
      "routes": [
        {
          "pattern": "",
          "name": "home",
          "target": [
            "home"
          ]
        },
        {
          "pattern": "ProfileECC/{Station}/{Profile}/:TrackShipment:",
          "name": "mainECC",
          "target": [
            "mainECC"
          ]
        },
        {
          "pattern": "ProfileEWM/{Station}/{Profile}/{WarehouseNumber}",
          "name": "mainEWM",
          "target": [
            "mainEWM"
          ]
        }
      ],
      "targets": {
        "home": {
          "viewName": "Home",
          "viewId": "home",
          "viewLevel": 1,
          "title": "{i18n>worklistViewTitle}"
        },
        "mainECC": {
          "viewName": "ECC.Main",
          "viewId": "ECC",
          "viewLevel": 2,
          "title": "{i18n>objectViewTitle}"
        },
        "mainEWM": {
          "viewName": "EWM.Main",
          "viewId": "EWM",
          "viewLevel": 2,
          "title": "{i18n>objectViewTitle}"
        },
        "notFound": {
          "viewName": "NotFound",
          "viewId": "notFound"
        }
      }
    }
  },
  "sap.platform.hcp": {
    "uri": "",
    "_version": "1.1.0"
  },
  "sap.cloud": {
    "public": true,
    "service": "comerpisshiperptrackshipmentewm"
  }
}