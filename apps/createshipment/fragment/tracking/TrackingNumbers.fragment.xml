<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Dialog title="Tracking Numbers" class="sapUiContentPadding" contentWidth="400px" contentHeight="100%">
		<content>
			<!--<Carousel id="trackingCarousel" height="100%">-->
			<FlexBox direction="Column">
				<Table mode="None" class="sapUiTinyMarginTop border_lightgray_nobottom" showSeparators="All" growing="false"
					items="{path: 'local>/SelectedTrackingNumber', templateShareable: true}">
					<headerToolbar>
						<Toolbar>
							<content>
								<Label text="{i18n>serialLb}"/>
								<Input liveChange="onAddtrakingnumberScan" submit="onChangeMunualShipInputText" showValueHelp="false" />
								<ToolbarSpacer/>
								<Button text="Clear All" press="onClearTrackingNumber"/>
							</content>
						</Toolbar>
					</headerToolbar>
					<columns>
						<Column hAlign="Center">
							<Text text="Tracking Numbers"/>
						</Column>
					</columns>
					<items >
						<ColumnListItem type="Active">
							<cells>
								<Input value="{local>manualtrack}"  valueState="None" valueStateText=""/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</FlexBox>
			<!--</Carousel>-->
		</content>
		<beginButton>
			<Button text="Accept" icon="sap-icon://accept" type="Emphasized" press="onAcceptPress"/>
		</beginButton>
		<endButton>
			<Button press="onCloseTrackingNumbers" type="Reject" text="Cancel"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>