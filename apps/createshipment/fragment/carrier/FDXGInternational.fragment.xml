<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<core:Title text="Clearance Requirements"></core:Title>
	<Label text="Term of Sale"></Label>
	<ComboBox id="cbfdxgTermOfSale" tooltip="Term of Sale" selectedKey="{local>/basic/international/termofsale}"
		items="{/xSERPERPxCDS_SALETERM}">
		<core:Item text="{Description}" key="{TermID}"></core:Item>
	</ComboBox>
	<Label text="Freight/Insurance Charge"/>
	<Input placeholder="Freight Charge" value="{local>/basic/international/freightcharge}"/>
	<Input placeholder="Insurance Charge" value="{local>/basic/international/insurancecharge}"/>
	<Label text="Shipping Document"></Label>
	<CheckBox text="Commercial Invoice" selected="{local>/basic/international/shipping_docs/cominv}"/>
	<CheckBox text="Certificate of Origin" selected="{local>/basic/international/shipping_docs/coo}"/>
	<Label></Label>
	<CheckBox text="Shipper's Export Declaration" tooltip="Shipper's Export Declaration"
		selected="{local>/basic/international/shipping_docs/sed}"/>
	<CheckBox text="NAFTA" selected="{local>/basic/international/shipping_docs/ncoo}"/>
	<Label></Label>
	<CheckBox text="Pro Forma Invoice" selected="{local>/basic/international/shipping_docs/pfinv}"/>
	<Label text="Reason for Export"/>
	<ComboBox selectedKey="{local>/basic/international/reasonexportcode}" items="{/xSERPERPxCDS_RSNEXP}">
		<core:Item text="{Description}" key="{Code}"></core:Item>
	</ComboBox>
	<Button type="Emphasized" text="NAFTA Details" enabled="{local>/basic/international/shipping_docs/ncoo}" press="onNAFTAPress"/>
	<Label></Label>
	<Label text="Purpose of Sale"/>
	<ComboBox id="cbfdxgSalePurpose" selectedKey="{local>/basic/international/salepurpose}" items="{/xSERPERPxCDS_PPESALE}">
		<core:Item text="{Description}" key="{PurposeofSale}"></core:Item>
	</ComboBox>
	<Label></Label>
	<Label text="Regulatory Control"/>
	<ComboBox id="cbfdxgRegulatoryControl" selectedKey="{local>/basic/international/regcontrol}" items="{/xSERPERPxCDS_RECTRL}">
		<core:Item text="{Description}" key="{Regcontrol}"></core:Item>
	</ComboBox>
	<core:Title text="SED/EEI Filling"></core:Title>
	<Label text="Sender Tin Type"/>
	<ComboBox id="cbfdxgTinType" tooltip="Sender Tin Type" selectedKey="{local>/basic/international/sendertintype}"
		items="{/xSERPERPxI_PCTINTYPE}">
		<core:Item text="{Description}" key="{TinType}"></core:Item>
	</ComboBox>
	<Label text="ITN Number (AES)"/>
	<ComboBox id="cbfdxgITNNumber" tooltip="Sender Tin Type" selectedKey="{local>/basic/international/itnnumber}"
		items="{/xSERPERPxCDS_FRT_LIST}" >
		<core:Item text="{Description}" key="{ITNNumber}"></core:Item>
	</ComboBox>
	<!--<Input placeholder="ITN Number (AES)" tooltip="ITN Number (AES)" value="{local>/basic/international/itnnumber}"/>-->
	<Label text="Inbond type/Entry"/>
	<ComboBox tooltip="Inbond type" selectedKey="{local>/basic/international/inboundtype}" items="{/xSERPERPxI_PCINBOUND}">
		<core:Item text="{Description}" key="{Code}"></core:Item>
	</ComboBox>
	<Input placeholder="Entry Number" tooltip="Entry Number" value="{local>/basic/international/entrynumber}"/>
	<Label text="Trans mode/Point.Orig" tooltip="Mode of Transport/Point of origin"/>
	<ComboBox tooltip="Mode of Transport" selectedKey="{local>/basic/international/modeoftransport}" items="{/xSERPERPxI_PCMOT}">
		<core:Item text="{Description}" key="{Code}"></core:Item>
	</ComboBox>
	<Input tooltip="Point of origin" placeholder="Point of origin" value="{local>/basic/international/pointoforigin}"/>
	<Label text="Port of Export/Unloading"></Label>
	<Input placeholder="Port of Export" tooltip="Port of Export" value="{local>/basic/international/portofexport}"/>
	<Input placeholder="Port of Unloading" tooltip="Port of Unloading" value="{local>/basic/international/portofunloading}"/>
	<Label text="Loading Pier"></Label>
	<Input placeholder="Loading Pier" tooltip="Loading Pier" value="{local>/basic/international/loadingpier}"/>
	<Label text="License"/>
	<Input value="{local>/basic/international/license}"/>
	<DatePicker placeholder="License Date" value="{local>/basic/international/licensedate}"/>
	<Label text="LIC Exception Code"/>
	<ComboBox tooltip="LIC Exception Code" selectedKey="{local>/basic/international/licenseexceptioncode}" items="{/xSERPERPxI_PCLICEXP}">
		<core:Item text="{Description}" key="{Code}"></core:Item>
	</ComboBox>
	<Label text="ECCN Number"/>
	<Input value="{local>/basic/international/eccnnumber}"/>
	<Label text=""/>
	<CheckBox text="Routed Export Transaction" tooltip="Routed Export Transaction" selected="{local>/basic/international/routedexporttrans}"/>
	<Label text=""/>
	<CheckBox text="Containerized (vessel only)" tooltip="Containerized (vessel only)" selected="{local>/basic/international/containerized}"/>
	<core:Title text="Broker Select"></core:Title>
	<Label text="Broker Select"/>
	<CheckBox selected="{local>/basic/international/customs_broker/broker_select}"/>
	<Label text="Broker Acc/Type"/>
	<Input placeholder="Acc Number" tooltip="Acc Number" value="{local>/basic/international/customs_broker/brokeracctnum}"
		enabled="{= ${local>/basic/international/customs_broker/broker_select} ? true : false }"/>
	<ComboBox tooltip="Broker Type" selectedKey="{local>/basic/international/customs_broker/brokertype}"
		enabled="{= ${local>/basic/international/customs_broker/broker_select} ? true : false }"
		items="{path: '/DomainTextSet', filters: [ {path: 'Domain', operator: 'EQ', value1: '/ERPIS/BROKERTYPE_DOM'} ]}">
		<core:Item key="{Key}" text="{Key}"/>
	</ComboBox>
	<Label text="Broker TIN/Type"/>
	<Input placeholder="Number" enabled="{= ${local>/basic/international/customs_broker/broker_select} ? true : false }" tooltip="Number"
		value="{local>/basic/international/customs_broker/brokertin}"/>
	<ComboBox id="cbfdxgBrokerTinType" tooltip="Broker Tin Type"
		enabled="{= ${local>/basic/international/customs_broker/broker_select} ? true : false }"
		selectedKey="{local>/basic/international/customs_broker/brokertintype}" items="{/xSERPERPxI_PCBROKERTIN}">
		<core:Item text="{TinType}" key="{TinType}"></core:Item>
	</ComboBox>
	<Label text="Person/Company Name"/>
	<Input placeholder="Person Name" enabled="{= ${local>/basic/international/customs_broker/broker_select} ? true : false }"
		tooltip="Person Name" value="{local>/basic/international/customs_broker/brokerpersonname}"/>
	<Input placeholder="Company Name" enabled="{= ${local>/basic/international/customs_broker/broker_select} ? true : false }"
		tooltip="Company Name" value="{local>/basic/international/customs_broker/brokercompanynam}"/>
	<Label text="Phone/Pager Number"/>
	<Input placeholder="Phone" enabled="{= ${local>/basic/international/customs_broker/broker_select} ? true : false }" tooltip="Phone"
		value="{local>/basic/international/customs_broker/brokerphonenum}"/>
	<Input placeholder="Pager" enabled="{= ${local>/basic/international/customs_broker/broker_select} ? true : false }" tooltip="Pager"
		value="{local>/basic/international/customs_broker/brokerpagernum}"/>
	<Label text="Email/Fax"/>
	<Input placeholder="Email" enabled="{= ${local>/basic/international/customs_broker/broker_select} ? true : false }" type="Email"
		value="{local>/basic/international/customs_broker/brokeremail}"/>
	<Input placeholder="Fax" enabled="{= ${local>/basic/international/customs_broker/broker_select} ? true : false }" tooltip="Fax"
		value="{local>/basic/international/customs_broker/brokerfaxnumber}"/>
	<Label text="Street 1"/>
	<Input placeholder="Street1" enabled="{= ${local>/basic/international/customs_broker/broker_select} ? true : false }" tooltip="Street1"
		value="{local>/basic/international/customs_broker/brokerstreet1}"/>
	<Label text="Street 2"/>
	<Input placeholder="Street2" enabled="{= ${local>/basic/international/customs_broker/broker_select} ? true : false }" tooltip="Street2"
		value="{local>/basic/international/customs_broker/brokerstreet2}"/>
	<Label text="Country"/>
	<ComboBox id="cbfdxgInternationalCountry" selectedKey="{local>/basic/international/customs_broker/brokercountry}" tooltip="Country"
		change="onUpdateDomestic" enabled="{= ${local>/basic/international/customs_broker/broker_select} ? true : false }"
		items="{path: '/xSERPERPxI_PCCNTR', length: 999}" app:nextUpdate="slFedExInternationalState">
		<items>
			<core:Item text="{Name}" key="{Country}"/>
		</items>
	</ComboBox>
	<Label text="Region"></Label>
	<ComboBox id="cbfdxgInternationalState" tooltip="State" change="onUpdateDomestic"
		enabled="{= ${local>/basic/international/customs_broker/broker_select} ? true : false }" items="{path: '/xSERPERPxI_PCSTATE', length: 999}">
		<items>
			<core:Item text="{Description}" key="{Region}"/>
		</items>
	</ComboBox>
	<Label text="City/Zip"></Label>
	<Input placeholder="City" enabled="{= ${local>/basic/international/customs_broker/broker_select} ? true : false }" tooltip="City"
		value="{local>/basic/international/customs_broker/brokercity}"/>
	<Input placeholder="Zip" enabled="{= ${local>/basic/international/customs_broker/broker_select} ? true : false }" tooltip="Zip"
		value="{local>/basic/international/customs_broker/brokerpostalcode}"/>
	<core:Title text="Commercial Destination Control Coding"></core:Title>
	<Label text="Statement Types"/>
	<ComboBox id="cbfdxgStatementType" tooltip="Statement Types" items="{/xSERPERPxI_PCSTMTTYPE}">
		<core:Item text="{StatementType}" key="{StatementType}"></core:Item>
	</ComboBox>
	<Label text="Destination Countries"/>
	<Input value="{local>/basic/international/destcountries}"/>
	<Label text="End User"/>
	<Input value="{local>/basic/international/endUser}"/>
	<!-- Shipfrom country CANADA -->
	<Title text="{= ${local>/basic/partners/shipfrom/address/country} === 'CA' ? 'Canada B13A Filling' : '' }"
		visible="{= ${local>/basic/partners/shipfrom/address/country} === 'CA' ? true : false }"></Title>
	<Label text="B13A Filing Option" visible="{= ${local>/basic/partners/shipfrom/address/country} === 'CA' ? true : false }"></Label>
	<ComboBox items="{/xSERPERPxCDS_RSNEXP}" visible="{= ${local>/basic/partners/shipfrom/address/country} === 'CA' ? true : false }">
		<core:Item text="{Description}" key="{Code}"></core:Item>
	</ComboBox>
	<Label text="Statement Data" visible="{= ${local>/basic/partners/shipfrom/address/country} === 'CA' ? true : false }"></Label>
	<Input visible="{= ${local>/basic/partners/shipfrom/address/country} === 'CA' ? true : false }"></Input>
	<Label text="Permit Number" visible="{= ${local>/basic/partners/shipfrom/address/country} === 'CA' ? true : false }"></Label>
	<Input visible="{= ${local>/basic/partners/shipfrom/address/country} === 'CA' ? true : false }"></Input>
	<!-- Shipfrom country CANADA -->
</core:FragmentDefinition>