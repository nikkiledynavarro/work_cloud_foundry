<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<FlexBox>
		<HBox alignItems="Center" class="sapUiMediumMarginEnd">
			<Label text="{i18n>totalPallets}: " width="5rem" class="sapUiSmallMarginEnd"/>
			<Input value="{local>/total/totalPallets}" placeholder="Total Pallets" liveChange="onInputLiveChange" enabled="true" editable="false"/>
		</HBox>
		<HBox alignItems="Center" class="sapUiMediumMarginEnd">
			<Label text="{i18n>totalPieces}: " width="5rem" class="sapUiSmallMarginEnd"/>
			<Input value="{local>/total/totalPieces}" placeholder="Total Pieces" liveChange="onInputLiveChange" enabled="true" editable="false"/>
		</HBox>
		<HBox alignItems="Center" class="sapUiMediumMarginEnd">
			<Label text="{i18n>totalWeight}: " width="5rem" class="sapUiSmallMarginEnd"/>
			<Input value="{local>/total/totalWeight}" placeholder="Total Weight" liveChange="onInputLiveChange" enabled="true" editable="false"/>
		</HBox>
	</FlexBox>
</core:FragmentDefinition>