<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog contentWidth="400px" title="Consolidation">
		<content>
			<FlexBox justifyContent="Center" alignItems="Center" class="sapUiSmallMarginTopBottom">
				<MultiInput id="idDocNo" submit="onMultiInputDocNo" placeholder="Enter document numbers" showValueHelp="false" width="20rem">
					<core:Item key="{key}" text="{text}"/>
				</MultiInput>
			</FlexBox>
		</content>
		<beginButton>
			<Button text="Submit" press="onSubmitDocumentNo" type="Emphasized"/>
		</beginButton>
		<endButton>
			<Button text="Cancel" press="onCancel" type="Reject"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>