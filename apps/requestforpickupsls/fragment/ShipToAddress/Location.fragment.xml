<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<!--Country-->
	<Label text="{i18n>country}"/>
	<ComboBox id="Country" items="{ path: '/xSERPERPxRFP_Country', length: 999}" selectedKey="{local>/basic/ship_to_address/coutry}"
		change="onChangeCountry" enabled="{= (${local>/basic} &amp;&amp; ${local>/ShipmentManual} === true) ? true : false }">
		<core:Item key="{Land1}" text="{Natio}"></core:Item>
	</ComboBox>
	<!--Region-->
	<Label text="{i18n>region}"/>
	<ComboBox id="Region" items="{ path: '/xSERPERPxRFP_Region', length: 999}" selectedKey="{local>/basic/ship_to_address/region}"
		change="onChangeRegion" enabled="{= (${local>/basic} &amp;&amp; ${local>/ShipmentManual} === true) ? true : false }">
		<core:Item key="{Land1}" text="{Bezei}"></core:Item>
	</ComboBox>
	<!--City-->
	<Label text="{i18n>city}"/>
	<Input value="{local>/basic/ship_to_address/city}" placeholder="City"
		enabled="{= (${local>/basic} &amp;&amp; ${local>/ShipmentManual} === true) ? true : false }"/>
	<!--Postal-->
	<Label text="{i18n>postal}"/>
	<Input value="{local>/basic/ship_to_address/postal}" placeholder="Postal"
		enabled="{= (${local>/basic} &amp;&amp; ${local>/ShipmentManual} === true) ? true : false }"/>
</core:FragmentDefinition>