<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Dialog title="Edit Vehicle" contentWidth="1500px">
		<content>
			<f:SimpleForm width="auto" editable="true" layout="ResponsiveGridLayout" labelSpanXL="6" labelSpanL="6" labelSpanM="6" labelSpanS="4"
				columnsXL="4" columnsL="4" columnsM="3" class="border_lightgray sapUiSmallMarginBottom">
				<f:content>
					<!--ShipERP Fields-->
					<core:Title text="{i18n>shiperpFields}"></core:Title>
					<Label text="{i18n>carrier}"/>
					<ComboBox id="idCarr" selectedKey="{editVehicle>/Carrier}" items="{path: '/xSERPERPxCDS_CARR_COD'}" selectionChange="onChangeCarrier">
						<core:Item key="{CarrierCode}" text="{CarrierCode}"></core:Item>
					</ComboBox>
					<Label text="{i18n>service}"/>
					<ComboBox id="idService" selectedKey="{editVehicle>/Service}" items="{path: 'local>/ServiceList'}">
						<core:Item key="{local>Service}" text="{local>Service}  -  {local>Description}"></core:Item>
					</ComboBox>
					<Label text="{i18n>miscellaneousCarrier}"/>
					<Input value="{editVehicle>/vehmisccarr}"/>
					<Label text="{i18n>trackProNumber}"/>
					<Input editable="false" value="{editVehicle>/vehtrackpro}"/>
					<!--Status-->
					<core:Title text="{i18n>status}"></core:Title>
					<Label text="{i18n>notConsistnent}"/>
					<ObjectStatus icon="{path: 'editVehicle>/StatNc', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'editVehicle>/StatNc', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>genneralBlock}"/>
					<ObjectStatus icon="sap-icon://up" state="Warning"></ObjectStatus>
					<Label text="{i18n>arrivalAtCheckpoint}"/>
					<ObjectStatus icon="{path: 'editVehicle>/StatChki', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'editVehicle>/StatChki', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>departureFromCheckpoint}"/>
					<ObjectStatus icon="{path: 'editVehicle>/StatChko', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'editVehicle>/StatChko', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>blockedForCheck-In/Out}"/>
					<ObjectStatus icon="{path: 'editVehicle>/StatBlc', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'editVehicle>/StatBlc', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>goodsReceiptStarted}"/>
					<ObjectStatus icon="{path: 'editVehicle>/StatBgr', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'editVehicle>/StatBgr', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>goodsReceiptPosted}"/>
					<ObjectStatus icon="{path: 'editVehicle>/StatPgr', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'editVehicle>/StatPgr', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>goodsIssueStarted}"/>
					<ObjectStatus icon="{path: 'editVehicle>/StatBgi', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'editVehicle>/StatBgi', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>goodsIssuePosted}"/>
					<ObjectStatus icon="{path: 'editVehicle>/StatPgi', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'editVehicle>/StatPgi', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>blockedForGoodsMovements}"/>
					<ObjectStatus icon="{path: 'editVehicle>/StatBlgm', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'editVehicle>/StatBlgm', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<core:Title text=""></core:Title>
					<Label text="{i18n>loadStarted}"/>
					<ObjectStatus icon="{path: 'editVehicle>/StatLs', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'editVehicle>/StatLs', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>loadingCompleted}"/>
					<ObjectStatus icon="{path: 'editVehicle>/StatLc', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'editVehicle>/StatLc', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>unloadingStarted}"/>
					<ObjectStatus icon="{path: 'editVehicle>/StatBu', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'editVehicle>/StatBlgm', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>unloadingCompleted}"/>
					<ObjectStatus icon="{path: 'editVehicle>/StatUc', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'editVehicle>/StatBlgm', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>blockedForLoading/Unloading}"/>
					<ObjectStatus icon="{path: 'editVehicle>/StatBll', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'editVehicle>/StatBll', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>invoiceRequested}"/>
					<ObjectStatus icon="{path: 'editVehicle>/StatIbgi', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'editVehicle>/StatIbgi', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>messageSentToTMS}"/>
					<ObjectStatus icon="{path: 'editVehicle>/StatTmsd', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'editVehicle>/StatTmsd', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>blockedDueToCustomesProcess}"/>
					<ObjectStatus icon="{path: 'editVehicle>/StatBlcp', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'editVehicle>/StatBlcp', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>marksForArchiving}"/>
					<ObjectStatus icon="{path: 'editVehicle>/StatMarc', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'editVehicle>/StatMarc', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>archived}"/>
					<ObjectStatus icon="{path: 'editVehicle>/StatAarc', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'editVehicle>/StatAarc', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<core:Title text=""></core:Title>
					<Label text="{i18n>frgtDocNo}"/>
					<Input value="{editVehicle>/DasDocno}"/>
					<Label text="{i18n>driver}"/>
					<Input value="{editVehicle>/Driver}"/>
					<Label text="{i18n>vehcID}"/>
					<Input value="{editVehicle>/VehIdent1}"/>
					<Label text="{i18n>vehcID}"/>
					<Input value="{editVehicle>/VehIdent2}"/>
					<Label text="{i18n>vehcID}"/>
					<Input value="{editVehicle>/VehIdent3}"/>
					<Label text="{i18n>creationUser}"/>
					<Input editable="false" value="{editVehicle>/CreatedBy}"/>
					<Label text="Creation Date"/>
					<DatePicker editable="false" value="{path:'editVehicle>/CreatedAtDate', formatter: '.formatter.formatDateTime'}" valueFormat="yyyy-MM-dd"
						displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker editable="false" value="{path: 'editVehicle>/CreatedAtTime', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss" displayFormat="HH:mm:ss"
						placeholder="HH:mm:ss"/>
					<Label text="{i18n>changeUserDate}"/>
					<Input editable="false" value="{editVehicle>/ChangedAt}"/>
					<Label text="Change Date"/>
					<DatePicker editable="false" value="{path:'editVehicle>/ChangedAtDate', formatter: '.formatter.formatDateTime'}" valueFormat="yyyy-MM-dd"
						displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker editable="false" value="{path: 'editVehicle>/ChangedAtTime', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss" displayFormat="HH:mm:ss"
						placeholder="HH:mm:ss"/>
					<Label text="{i18n>totalWeight}"/>
					<Input value="{editVehicle>/VehWeight}"/>
					<Label text="{i18n>maxWeightVolume}"/>
					<Input editable="false" value="{editVehicle>/LoadWeight}"/>
					<Input editable="false" value="{editVehicle>/LoadVolume}"/>
					<Label text="{i18n>maxLengthWidth}"/>
					<Input editable="false" value="{editVehicle>/LoadLength}"/>
					<Input editable="false" value="{editVehicle>/LoadWidth}"/>
					<Label text="{i18n>maxHeight}"/>
					<Input editable="false" value="{editVehicle>/LoadHeight}"/>
					<!--Vehicle-->
					<core:Title text="{i18n>vehicle}"></core:Title>
					<Label text="{i18n>vehicle}"/>
					<Input editable="false" value="{editVehicle>/VehNumExt}"/>
					<Label text="{i18n>carrier}"/>
					<Input editable="false" value="{editVehicle>/TspCarrier}"/>
					<Label text="{i18n>scac}"/>
					<Input editable="false" value="{editVehicle>/ScacCurr}"/>
					<Label text="{i18n>licensePlateNumber}"/>
					<Input editable="false" value="{editVehicle>/LicPlate}"/>
					<Label text="{i18n>intVehicleNo}"/>
					<Input editable="false" value="{ path: 'editVehicle>/VehNum', formatter: '.formatter.validateDocNo'}"/>
					<Label text="{i18n>veh}"/>
					<Input editable="false" value="{editVehicle>/VehSrActNum}"/>
					<Label text="{i18n>state}"/>
					<Input editable="false" value="{editVehicle>/SrActState}"/>
					<Label text="{i18n>actyType}"/>
					<Input editable="false" value="{editVehicle>/ActType}"/>
					<Label text="{i18n>meansOfTrans}"/>
					<Input editable="false" value="{editVehicle>/Mtr}"/>
					<Label text="{i18n>transpMode}"/>
					<Input editable="false" value="{editVehicle>/Mot}"/>
					<Label text=""/>
					<CheckBox editable="false" value="{editVehicle>/FlgDateActual}" text="{i18n>lockByExtSyst}"/>
					<Label text="{i18n>lockDate}"/>
					<DatePicker editable="false" value="{path:'editVehicle>/ChgExtDate', formatter: '.formatter.formatDateTime'}" valueFormat="yyyy-MM-dd"
						displayFormat="MM/dd/yyyy"></DatePicker>
					<Label text="{i18n>expirationDate}"/>
					<DatePicker editable="false" value="{editVehicle>/ChgExpiDate}" valueFormat="yyyy-MM-dd" displayFormat="MM/dd/yyyy"></DatePicker>
					<!--Arrival/ Departure-->
					<core:Title text="{i18n>arrivalDeparture}"></core:Title>
					<Label text="{i18n>arrival}"/>
					<DatePicker editable="false" value="{ path:'editVehicle>/StartActual', formatter: '.formatter.formatDateTime' }" valueFormat="yyyy-MM-dd"
						displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker editable="false" value="{ path:'editVehicle>/StartActT', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss" displayFormat="HH:mm:ss"
						placeholder="HH:mm:ss"/>
					<Label text="{i18n>departure}"/>
					<DatePicker editable="false" value="{ path:'editVehicle>/EndActD', formatter: '.formatter.formatDateTime' }" valueFormat="yyyy-MM-dd"
						displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker editable="false" value="{path: 'editVehicle>/EndActT', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss" displayFormat="HH:mm:ss"
						placeholder="HH:mm:ss"/>
					<!--Planned Arrival Period-->
					<core:Title text="{i18n>plannedArrivalPeriod}"></core:Title>
					<Label text="{i18n>start}"/>
					<DatePicker editable="false" value="{ path:'editVehicle>/StartActual', formatter: '.formatter.formatDateTime' }" valueFormat="yyyy-MM-dd"
						displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker editable="false" value="{path: 'editVehicle>/StartPlanTstfrT', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss"
						displayFormat="HH:mm:ss" placeholder="HH:mm:ss"/>
					<Label text="{i18n>end}"/>
					<DatePicker editable="false" value="{ path:'editVehicle>/EndActual', formatter: '.formatter.formatDateTime' }" valueFormat="yyyy-MM-dd"
						displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker editable="false" value="{path: 'editVehicle>/StartPlanTsttoT', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss"
						displayFormat="HH:mm:ss" placeholder="HH:mm:ss"/>
					<!--Planned Departure Period-->
					<core:Title text="Planned Departure Period"></core:Title>
					<Label text="{i18n>start}"/>
					<DatePicker editable="false" value="{ path:'editVehicle>/StartPlanTstfrD', formatter: '.formatter.formatDateTime' }"
						valueFormat="yyyy-MM-dd" displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker value="{path: 'editVehicle>/EndPlanTstfrT', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss" displayFormat="HH:mm:ss"
						placeholder="HH:mm:ss"/>
					<Label text="{i18n>end}"/>
					<DatePicker value="{ path:'editVehicle>/EndPlanTstfrD', formatter: '.formatter.formatDateTime' }" valueFormat="yyyy-MM-dd"
						displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker editable="false" value="{path: 'editVehicle>/EndPlanTsttoT', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss" displayFormat="HH:mm:ss"
						placeholder="HH:mm:ss"/>
					<!--Actual Arrival/Actual Departure-->
					<core:Title text="{i18n>actualArrival/actualDeparture}"></core:Title>
					<Label text="{i18n>actualArrival}"/>
					<DatePicker editable="false" value="{ path:'editVehicle>/StartActualD', formatter: '.formatter.formatDateTime' }" valueFormat="yyyy-MM-dd"
						displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker editable="false" value="{path: 'editVehicle>/StartActualT', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss" displayFormat="HH:mm:ss"
						placeholder="HH:mm:ss"/>
					<Label text="{i18n>actualDeparture}"/>
					<DatePicker editable="false" value="{ path:'editVehicle>/EndActualD', formatter: '.formatter.formatDateTime' }" valueFormat="yyyy-MM-dd"
						displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker editable="false" value="{path: 'editVehicle>/EndActualT', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss" displayFormat="HH:mm:ss"
						placeholder="HH:mm:ss"/>
				</f:content>
			</f:SimpleForm>
		</content>
		<beginButton>
			<Button icon="sap-icon://accept" press="onAcceptEdit" type="Accept"/>
		</beginButton>
		<endButton>
			<Button icon="sap-icon://decline" press="onCloseVehicleEdit" type="Reject"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>