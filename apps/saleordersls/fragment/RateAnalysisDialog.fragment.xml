<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form"
	xmlns:table="sap.ui.table">
	<Dialog title="Rate Analysis" class="sapUiContentPadding" stretch="true" afterOpen="onAfterRateAnalysisOpen" state="Success">
		<FlexBox fitContainer="true"
			wrap="{= ${device>/system/desktop} || (${device>/system/tablet} &amp;&amp; ${device>/orientation/landscape} ) ? 'NoWrap' : 'Wrap' }">
			<FlexBox class="sapUiTinyMarginEnd">
				<layoutData>
					<FlexItemData growFactor="3"></FlexItemData>
				</layoutData>
				<table:TreeTable id="tableRateAnalysis" selectionMode="Single" selectionBehavior="RowOnly" rowSelectionChange="onChangeRateAnalysisLine"
					rows="{path:'global>/RateAnalysis', parameters: {arrayNames:['Children'], numberOfExpandedLevels: 4}, sorter: {path: 'Foundx', descending: true} }"
					enableSelectAll="false" visibleRowCountMode="Interactive">
					<table:columns>
						<table:Column width="15rem">
							<Label text="Hierarchy Header"/>
							<table:template>
								<ObjectStatus state="{= ${global>Foundx} ? 'Success' : 'None' }" icon="{= ${global>Foundx} ? 'sap-icon://accept' : '' }"
									text="{global>NodeDesc}" tooltip="{global>NodeDesc}"/>
							</table:template>
						</table:Column>
						<table:Column>
							<Label text="Description"/>
							<table:template>
								<Text text="{global>Ddtext}" wrapping="false" tooltip="{global>Ddtext}"/>
							</table:template>
						</table:Column>
					</table:columns>
				</table:TreeTable>
			</FlexBox>
			<FlexBox direction="Column" wrap="Wrap">
				<layoutData>
					<FlexItemData growFactor="2"></FlexItemData>
				</layoutData>
				<Table id="tabHdr" class="border_lightgray_nobottom"
					items="{path: 'global>/RateMessagesToFields', filters: [ { path: 'Found', operator: 'EQ', value1: '' } ]}">
					<headerToolbar>
						<OverflowToolbar>
							<Title id="txtTabDesc" text="Tab Description" level="H2"/>
							<ToolbarSpacer/>
							<SearchField liveChange="onMessagesFilter" width="40%"/>
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column>
							<Text text="{i18n>Field}"/>
						</Column>
						<Column>
							<Text text="{i18n>Description}"/>
						</Column>
						<Column>
							<Text text="{i18n>Value}"/>
						</Column>
					</columns>
					<items >
						<ColumnListItem type="Active">
							<cells>
								<Text text="{global>Text1}"/>
								<Text text="{global>Text2}"/>
								<Text text="{global>Text3}"/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
				<Table class="sapUiSmallMarginTop border_lightgray_nobottom" updateFinished="onAnalysisDataFound"
					items="{path: 'global>/RateMessagesToFields', filters: [ { path: 'Found', operator: 'EQ', value1: 'X' } ]}">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Data Found" level="H2"/>
							<ToolbarSpacer/>
							<SearchField liveChange="onMessagesFilter" width="40%"/>
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column>
							<Text text="{i18n>Field}"/>
						</Column>
						<Column>
							<Text text="{i18n>Description}"/>
						</Column>
						<Column>
							<Text text="{i18n>Value}"/>
						</Column>
					</columns>
					<items >
						<ColumnListItem type="Active">
							<cells>
								<Text text="{global>Text1}"/>
								<Text text="{global>Text2}"/>
								<Text text="{global>Text3}"/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</FlexBox>
		</FlexBox>
		<endButton>
			<Button press="onCloseRateAnalysisDetail" text="Close"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>