<core:FragmentDefinition xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns="sap.m">
	<ObjectListItem icon="sap-icon://sales-order" type="Navigation" title="Order: {local>SalesNo}" press="onSelectionChange">
		<firstStatus>
			<ObjectStatus text="{path:'local>CreatedOn', formatter: '.formatter.formatDateString'}"/>
		</firstStatus>
		<secondStatus>
			<ObjectStatus text="{local>DeliveryStatusText}" state="{path: 'local>DeliveryStatus', formatter:'.formatter.formatDeliveryStatus'}"/>
		</secondStatus>
		<attributes>
			<ObjectAttribute title="Cust.Ref" text="{local>CustomerReference}"/>
			<ObjectAttribute title="Sold to" text="{local>SoldToParty/toParty}"/>
			<ObjectAttribute title="Ship to" text="{local>ShipToParty/toParty}"/>
		</attributes>
	</ObjectListItem>
</core:FragmentDefinition>