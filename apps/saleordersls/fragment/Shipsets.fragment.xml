<core:FragmentDefinition xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns="sap.m">
	<Table inset="false" items="{ path: 'global>/ShipSetSet' }" sticky="ColumnHeaders" mode="SingleSelectLeft" class="border_lightgray_nobottom"
		id="listDetail" width="100%" selectionChange="onCheckPackProposalActive">
		<headerToolbar>
			<OverflowToolbar>
				<content>
					<Title text="Shipsets ({global>/ShipSetSet/length})" level="H2"/>
					<ToolbarSeparator/>
					<Text text="{global>/SOActive/SplitCriteria}" tooltip="Split Criteria: {global>/SOActive/SplitCriteria}" wrapping="false"/>
					<ToolbarSpacer/>
					<OverflowToolbarButton type="Ghost" icon="sap-icon://lead" tooltip="Single Rate" press="onSingleRate"/>
					<OverflowToolbarButton type="Ghost" icon="sap-icon://collections-insight" tooltip="Rate Shop" press="onRateShop"/>
					<OverflowToolbarButton type="Ghost" icon="sap-icon://paid-leave" tooltip="Optimization" press="onOptimization"/>
					<ToolbarSeparator/>
					<OverflowToolbarButton type="Ghost" enabled="false" id="btnPackProposal" icon="sap-icon://inbox" tooltip="Packing Proposal"
						press="onPackProposal"/>
				</content>
			</OverflowToolbar>
		</headerToolbar>
		<columns>
			<Column width="3.1rem">
				<Text text="Counter" tooltip="Counter" wrapping="false"/>
			</Column>
			<Column width="3rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
				<Text text="Ship.Pt" tooltip="Shipping Point" wrapping="false"/>
			</Column>
			<Column width="3rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
				<Text text="IncoT" tooltip="Incoterms" wrapping="false"/>
			</Column>
			<Column width="4rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
				<Text text="CarrCode" tooltip="Carrier" wrapping="false"/>
			</Column>
			<Column width="5rem" minScreenWidth="XXLarge" demandPopin="true" popinDisplay="Inline">
				<Text text="Service" tooltip="Service Desc" wrapping="false"/>
			</Column>
			<Column width="4rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
				<Text text="Ship To" tooltip="Ship To Party" wrapping="false"/>
			</Column>
			<Column width="5.5rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
				<Text text="Loading Date" tooltip="Loading Date" wrapping="false"/>
			</Column>
			<Column minScreenWidth="XXLarge" demandPopin="true" popinDisplay="Inline">
				<Text text="Delivery" tooltip="Delivery" wrapping="false"/>
			</Column>
			<Column width="5rem" minScreenWidth="XXLarge" demandPopin="true" popinDisplay="Inline">
				<Text text="Misc.Carr" tooltip="Misc Carrier" wrapping="false"/>
			</Column>
			<Column width="5rem" minScreenWidth="XXLarge" demandPopin="true" popinDisplay="Inline">
				<Text text="Carr.Rate" tooltip="Carrier Rate" wrapping="false"/>
			</Column>
			<Column minScreenWidth="XXLarge" demandPopin="true" popinDisplay="Inline">
				<Text text="List Rate" tooltip="List Rate" wrapping="false"/>
			</Column>
			<Column minScreenWidth="XXLarge" demandPopin="true" popinDisplay="Inline">
				<Text text="Weight" tooltip="Weight" wrapping="false"/>
			</Column>
			<Column width="2rem" minScreenWidth="XXLarge" demandPopin="true" popinDisplay="Inline">
				<Text text="UOM" tooltip="UOM" wrapping="false"/>
			</Column>
			<Column minScreenWidth="XXLarge" demandPopin="true" popinDisplay="Inline">
				<Text text="Vol" tooltip="Volume" wrapping="false"/>
			</Column>
			<Column width="3rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
				<Text text="Bill.Opt" tooltip="Billing Option" wrapping="false"/>
			</Column>
			<Column width="4rem" minScreenWidth="XXLarge" demandPopin="true" popinDisplay="Inline">
				<Text text="Ins.Typ" tooltip="Insurance Type" wrapping="false"/>
			</Column>
			<Column width="4rem" minScreenWidth="XXLarge" demandPopin="true" popinDisplay="Inline">
				<Text text="Ins.Value" tooltip="Insured Value" wrapping="false"/>
			</Column>
		</columns>
		<items>
			<ColumnListItem press="onSelectionChange" type="Active">
				<cells>
					<Link text="{global>Counter}" press="onShipsetItemPress" emphasized="true" wrapping="false" tooltip="{global>Counter}"/>
					<Text text="{global>Vstel}" wrapping="false" tooltip="{global>Vstel}"/>
					<Text text="{global>Inco1}" wrapping="false" tooltip="{global>Inco1}"/>
					<Text text="{global>Carrier}" wrapping="false" tooltip="{global>Carrier}"/>
					<Text text="{global>ServiceDesc}" wrapping="false" tooltip="{global>ServiceDesc}"/>
					<Text text="{global>Kunwe}" wrapping="false" tooltip="{global>Kunwe}"/>
					<Text text="{path: 'global>Lddat', formatter: '.formatter.formatDateString'}"/>
					<Text text="{global>Delivery}" wrapping="false" tooltip="{global>Delivery}"/>
					<Text text="{global>Misccarr}" wrapping="false" tooltip="{global>Misccarr}"/>
					<Text text="{global>Rate}" wrapping="false" tooltip="{global>Rate}"/>
					<Text text="{global>Listrate}" wrapping="false" tooltip="{global>Listrate}"/>
					<Text text="{global>Brgew}" wrapping="false" tooltip="{global>Brgew}"/>
					<Text text="{global>Gewei}" wrapping="false" tooltip="{global>Gewei}"/>
					<Text text="{global>Volum}" wrapping="false" tooltip="{global>Volum}"/>
					<Text text="{global>Billoption}" wrapping="false" tooltip="{global>Billoption}"/>
					<Text text="{global>Instype}" wrapping="false" tooltip="{global>Instype}"/>
					<Text text="{global>Insvalue}" wrapping="false" tooltip="{global>Insvalue}"/>
				</cells>
			</ColumnListItem>
		</items>
	</Table>
</core:FragmentDefinition>