<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Dialog contentWidth="100%" title="Ship Set Items" showHeader="true" state="Success" stretch="true">
		<Table items="{global>ShipSetItemSet/results/}">
			<columns>
				<Column width="5rem">
					<Text text="Sales Doc" wrapping="false" tooltip="Sales Document"/>
				</Column>
				<Column width="3rem">
					<Text text="Item" wrapping="false" tooltip="Item"/>
				</Column>
				<Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
					<Text text="Material" wrapping="false" tooltip="Material"/>
				</Column>
				<Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
					<Text text="Mat.Entered" wrapping="false" tooltip="Material Entered"/>
				</Column>
				<Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
					<Text text="Pr.Ref.Matl" wrapping="false" tooltip="Pr. Ref. Matl"/>
				</Column>
				<Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
					<Text text="Batch" wrapping="false" tooltip="Batch"/>
				</Column>
				<Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
					<Text text="Mat.Group" wrapping="false" tooltip="Material Group"/>
				</Column>
				<Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
					<Text text="Desc" wrapping="false" tooltip="Description"/>
				</Column>
				<Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
					<Text text="Item.Cat" wrapping="false" tooltip="Item Category"/>
				</Column>
				<Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
					<Text text="Item Type" wrapping="false" tooltip="Item Type"/>
				</Column>
				<Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
					<Text text="Rel.For.Billing" wrapping="false" tooltip="Relevant For Billing"/>
				</Column>
				<Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
					<Text text="Prod.Hier" wrapping="false" tooltip="Product Hierarchy"/>
				</Column>
				<Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
					<Text text="Net Value" wrapping="false" tooltip="Net Value"/>
				</Column>
				<Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
					<Text text="Ord.Qty" wrapping="false" tooltip="Order Quantity"/>
				</Column>
			</columns>
			<items>
				<ColumnListItem>
					<cells>
						<Text text="{= isNaN(parseInt(${global>Vbeln}))?'':parseInt(${global>Vbeln})}" wrapping="false" tooltip="{global>Vbeln}"/>
						<Text text="{= parseInt(${global>Posnr})}" wrapping="false" tooltip="{global>Posnr}"/>
						<Text text="{global>Matnr}" wrapping="false" tooltip="{global>Matnr}"/>
						<Text text="{global>Matwa}" wrapping="false" tooltip="{global>Matwa}"/>
						<Text text="{global>Pmatn}" wrapping="false" tooltip="{global>Pmatn}"/>
						<Text text="{global>Charg}" wrapping="false" tooltip="{global>Charg}"/>
						<Text text="{global>Matkl}" wrapping="false" tooltip="{global>Matkl}"/>
						<Text text="{global>Arktx}" wrapping="false" tooltip="{global>Arktx}"/>
						<Text text="{global>Pstyv}" wrapping="false" tooltip="{global>Pstyv}"/>
						<Text text="{global>Posar}" wrapping="false" tooltip="{global>Posar}"/>
						<Text text="{global>Fkrel}" wrapping="false" tooltip="{global>Fkrel}"/>
						<Text text="{global>Prodh}" wrapping="false" tooltip="{global>Prodh}"/>
						<Text text="{global>Netwr}" wrapping="false" tooltip="{global>Netwr}"/>
						<Text text="{global>Kwmeng}" wrapping="false" tooltip="{global>Kwmeng}"/>
					</cells>
				</ColumnListItem>
			</items>
		</Table>
		<beginButton>
			<Button text="Close" press="onCloseShipSetItemDialog"/>
		</beginButton>
	</Dialog>
</core:FragmentDefinition>