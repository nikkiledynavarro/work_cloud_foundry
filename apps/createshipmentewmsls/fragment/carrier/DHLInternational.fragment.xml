<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<core:Title text="DHL"></core:Title>
	<Label text="Flag"></Label>
	<CheckBox text="Dutiable Flag" selected="{= ${local>/basic/international/dutiable} === '' ? false : true }"/>
	<CheckBox text="Commerce Licenced" selected="{= ${local>/basic/international/commerciallicensed} === '' ? false : true }"/>
	<Label text="Filling Type"/>
	<Input value="{local>/basic/international/filingtype}"></Input>
	<Label text="FTSR"/>
	<ComboBox tooltip="FTSR" selectedKey="{local>/basic/international/ftsr}"
		items="{path: '/DomainTextSet', filters: [ {path: 'Domain', operator: 'EQ', value1: '/ERPIS/FTSR_DOM'} ]}">
		<core:Item key="{Key}" text="{Description}"/>
	</ComboBox>
	<Label text="ITN Number"/>
	<Input value="{local>/basic/international/itnnumber}"/>
	<Label text="EIN"/>
	<Input value="{local>/basic/international/ein}"/>
</core:FragmentDefinition>