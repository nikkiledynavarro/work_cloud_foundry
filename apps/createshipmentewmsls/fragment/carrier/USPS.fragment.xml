<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<core:Title text="Pickup/Delivery"></core:Title>
	<Label></Label>
	<CheckBox text="Sunday/Holiday Delivery" tooltip="Sunday/Holiday Delivery"
		selected="{= ${local>/basic/carrier_data/carrier_options/usps/opt01/Sundayholiday} === 'X' ? true : false}"></CheckBox>
	<Label></Label>
	<CheckBox text="NextDay2ndDayPOTToAddressee" tooltip="NextDay2ndDayPOToAddressee"
		selected="{= ${local>/basic/carrier_data/carrier_options/usps/opt01/Nextday2ndday} === 'X' ? true : false}"></CheckBox>
	<Label></Label>
	<core:Title text="Services"></core:Title>
	<Label></Label>
	<CheckBox text="Certified Mail" tooltip="Certified Mail"
		selected="{= ${local>/basic/carrier_data/carrier_options/usps/opt01/Certifiedmail} === 'X' ? true : false}"></CheckBox>
	<CheckBox text="Delivery Confirmation" tooltip="Delivery Confirmation"
		selected="{= ${local>/basic/carrier_data/carrier_options/usps/opt01/Deliveryconfirm} === 'X' ? true : false}"></CheckBox>
	<Label></Label>
	<CheckBox text="Signature Confirmation" tooltip="Signature Confirmation"
		selected="{= ${local>/basic/carrier_data/carrier_options/usps/opt01/Signatureconfirm} === 'X' ? true : false}"></CheckBox>
	<CheckBox text="Stealth Postage" tooltip="Stealth Postage" selected="{local>/basic/carrier_data/carrier_options/usps/opt01/Stealth}"></CheckBox>
	<Label></Label>
	<CheckBox text="Registered Mail" tooltip="Registered Mail" selected="{local>/basic/carrier_data/carrier_options/usps/opt01/Registermail}"></CheckBox>
	<Label></Label>
	<core:Title text="Additional Options"></core:Title>
	<Label text="Return Service Code"></Label>
	<ComboBox selectedKey="{local>/basic/carrier_data/carrier_options/usps/opt01/Returnsrv}"
		items="{path:'/xSERPERPxI_PCRETURNSRV', filters: [ {path: 'Carrier', operator: 'EQ', value1: 'USPS'} ]}" change="onChangeReturnService">
		<core:Item text="{Description}" key="{Code}"/>
	</ComboBox>
	<Label></Label>
	<Label text="Contents Type"></Label>
	<ComboBox selectedKey="{local>/basic/carrier_data/carrier_options/usps/opt01/Contentstype}"
		items="{path: '/DomainTextSet', filters: [ {path: 'Domain', operator: 'EQ', value1: '/ERPIS/CONTENTSTYPE'} ]}">
		<core:Item text="{Description}" key="{Key}"/>
	</ComboBox>
</core:FragmentDefinition>