<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form"
	xmlns:table="sap.ui.table">
	<Dialog title="{= ${local>/rateTitle} ? 'Rate Analysis' : 'Analysis' }" class="sapUiContentPadding" stretch="true" afterOpen="onAfterRateAnalysisOpen">
		<FlexBox fitContainer="true"
			wrap="{= ${device>/system/desktop} || (${device>/system/tablet} &amp;&amp; ${device>/orientation/landscape} ) ? 'NoWrap' : 'Wrap' }">
			<FlexBox class="sapUiTinyMarginEnd">
				<layoutData>
					<FlexItemData growFactor="3"></FlexItemData>
				</layoutData>
				<table:TreeTable id="tableRateAnalysis" selectionMode="Single" selectionBehavior="RowOnly" rowSelectionChange="onChangeRateAnalysisLine"
					rows="{path:'local>/CarrierRateAnalysis', parameters: {arrayNames:['Children'], numberOfExpandedLevels: 4}}" enableSelectAll="false"
					visibleRowCountMode="Interactive">
					<table:columns>
						<table:Column width="15rem">
							<Label text="Hierarchy Header"/>
							<table:template>
								<ObjectStatus state="{path: 'local>Image', formatter: '.formatter.colorIcon'}" icon="{path: 'local>Image', formatter: '.formatter.trafficIcon'}" text="{local>Condition}" tooltip="{local>Condition}"/>
							</table:template>
						</table:Column>
						<table:Column>
							<Label text="Description"/>
							<table:template>
								<Text text="{local>NodeDesc}" wrapping="false" tooltip="{local>NodeDesc}"/>
							</table:template>
						</table:Column>
					</table:columns>
				</table:TreeTable>
			</FlexBox>
			<FlexBox direction="Column" wrap="Wrap">
				<layoutData>
					<FlexItemData growFactor="2"></FlexItemData>
				</layoutData>
				<Table id="tabHdr" class="border_lightgray_nobottom" visible="false" items="{path: 'local>/ALVRateAnalysis'}">
					<headerToolbar>
						<OverflowToolbar>
							<Title id="txtTabDesc" text="Tab Description" level="H2"/>
							<ToolbarSpacer/>
							<SearchField liveChange="onMessagesFilter" width="40%"/>
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column>
							<Text text="{i18n>Field}"/>
						</Column>
						<Column>
							<Text text="{i18n>Description}"/>
						</Column>
						<Column>
							<Text text="{i18n>Value}"/>
						</Column>
					</columns>
					<items >
						<ColumnListItem type="Active">
							<cells>
								<Text text="{local>field_name}"/>
								<Text text="{local>field_desc}"/>
								<Text text="{local>field_value}"/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
				<Table class="sapUiSmallMarginTop border_lightgray_nobottom" updateFinished="onAnalysisDataFound"
					items="{path: 'local>/MessagesToFields'}">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Data Found" level="H2"/>
							<ToolbarSpacer/>
							<SearchField liveChange="onMessagesFilter" width="40%"/>
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column>
							<Text text="{i18n>Field}"/>
						</Column>
						<Column>
							<Text text="{i18n>Description}"/>
						</Column>
						<Column>
							<Text text="{i18n>Value}"/>
						</Column>
					</columns>
					<items >
						<ColumnListItem type="Active">
							<cells>
								<Text text="{local>field_name}"/>
								<Text text="{local>field_value}"/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</FlexBox>
		</FlexBox>
		<beginButton>
			<Button press="onConditonAnalysisDialog" type= "Emphasized" text="Condition Tables" />
		</beginButton>
		<endButton>
			<Button press="onCloseRateAnalysisDialog" text="Close"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>