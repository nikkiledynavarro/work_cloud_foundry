<mvc:View controllerName="com.erpis.shiperp.cancel.controller.Login" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core"
	xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Page showHeader="false">
		<FlexBox width="auto" height="100%" wrap="Wrap" justifyContent="Center" alignItems="Center"
			class="sapUiSmallMarginBegin sapUiSmallMarginEnd">
			<FlexBox direction="Column" wrap="Wrap" width="auto" height="auto" class="sapUiTinyMargin" justifyContent="Start" alignItems="Start">
				<f:SimpleForm backgroundDesign="Solid" editable="false" layout="ResponsiveGridLayout" title="Shipping Information" class="custom_login">
					<f:content>
						<Label text="{i18n>shippingStation}"/>
						<Input showValueHelp="true" valueHelpRequest="onShippingStationRequested" id="idShippingStationInp" submit="onLoginButtonPressed"/>
						<Label text="{i18n>shippingProfile}"/>
						<Input showValueHelp="true" valueHelpRequest="onShippingProfileRequested" id="idShippingProfileInp" submit="onLoginButtonPressed"/>
						<Button icon="sap-icon://visits" width="50%" text="{i18n>login}" class="sapUiSmallMarginTop" press="onLoginButtonPressed"></Button>
					</f:content>
				</f:SimpleForm>
			</FlexBox>
		</FlexBox>
	</Page>
</mvc:View>