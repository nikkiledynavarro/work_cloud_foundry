<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:f="sap.ui.layout.form">
	<Dialog title="{i18n>batteryDetailDialogTitle}" class="sapUiContentPadding">
		<content>
			<FlexBox width="100%">
				<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
					adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="3" columnsL="2" columnsM="2"
					singleContainerFullSize="false">
					<f:content>
						<Label text="{i18n>battMatTypeLabel}"/>
						<ComboBox id="idBattMat" items="{/xSERPERPxI_FDX_MATTP}">
							<core:Item text="{Description}" key="{Code}"></core:Item>
						</ComboBox>
						<Label text="{i18n>battPackType}"/>
						<ComboBox id="idBattPack" items="{/xSERPERPxI_FDX_PAKTP}">
							<core:Item text="{Description}" key="{Code}"></core:Item>
						</ComboBox>
						<Label text="{i18n>battRegType}"/>
						<ComboBox id="idBattReg" items="{/xSERPERPxI_FDX_REGTP}">
							<core:Item text="{Description}" key="{Code}"></core:Item>
						</ComboBox>
					</f:content>
				</f:SimpleForm>
			</FlexBox>
		</content>
		<endButton>
			<Button press="onCloseBatteryDetailDialog" text="Close"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>