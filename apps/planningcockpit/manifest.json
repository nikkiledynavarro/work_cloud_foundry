{
  "_version": "1.12.0",
  "sap.app": {
    "id": "comerpisshiperpplanningcockpit",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "sourceTemplate": {
      "id": "servicecatalog.connectivityComponentForManifest",
      "version": "0.0.0"
    },
    "dataSources": {
      "PLANNING_SRV": {
        "uri": "sap/opu/odata/serptm/PLANNING_SRV/",
        "type": "OData",
        "settings": {
          "localUri": "localService/metadata.xml"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "planningcockpitDisplay": {
          "action": "display",
          "icon": "sap-icon://app",
          "signature": {
            "additionalParameters": "allowed",
            "parameters": {}
          },
          "semanticObject": "planningcockpit",
          "subTitle": "",
          "title": "{{appTitle}}"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://task",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    },
    "fullWidth": true
  },
  "sap.ui5": {
    "flexEnabled": true,
    "rootView": {
      "viewName": "com.erpis.shiperp.planningcockpit.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.66.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.f": {
          "minVersion": ""
        },
        "sap.ushell": {
          "minVersion": ""
        },
        "sap.collaboration": {
          "minVersion": "",
          "lazy": true
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.erpis.shiperp.planningcockpit.i18n.i18n"
        }
      },
      "": {
        "type": "sap.ui.model.odata.v2.ODataModel",
        "settings": {
          "defaultOperationMode": "Server",
          "defaultBindingMode": "OneWay",
          "defaultCountMode": "Request"
        },
        "dataSource": "PLANNING_SRV",
        "preload": true
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css",
          "id": "stylecss"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "com.erpis.shiperp.planningcockpit.view",
        "controlAggregation": "pages",
        "controlId": "app",
        "clearControlAggregation": false,
        "bypassed": {
          "target": [
            "notFound"
          ]
        }
      },
      "routes": [
        {
          "name": "home",
          "pattern": "",
          "titleTarget": "",
          "greedy": false,
          "target": [
            "home"
          ]
        },
        {
          "name": "main",
          "pattern": "main",
          "titleTarget": "",
          "greedy": false,
          "target": [
            "main"
          ]
        }
      ],
      "targets": {
        "home": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewName": "Home",
          "viewId": "home",
          "viewLevel": 1
        },
        "main": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewName": "Main",
          "viewId": "main",
          "viewLevel": 2
        },
        "notFound": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": "",
          "viewId": "notFound",
          "viewName": ""
        }
      }
    },
    "services": {
      "ShellUIService": {
        "factoryName": "sap.ushell.ui5service.ShellUIService",
        "lazy": false,
        "settings": {
          "setTitle": "auto"
        }
      }
    }
  },
  "sap.platform.hcp": {
    "uri": "webapp",
    "_version": "1.1.0"
  },
  "sap.cloud": {
    "public": true,
    "service": "comerpisshiperpplanningcockpit"
  }
}