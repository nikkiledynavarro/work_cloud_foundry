<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1" xmlns:smartFilterBar="sap.ui.comp.smartfilterbar">
	<smartFilterBar:SmartFilterBar entitySet="FiltersSet" id="DynamicFilter" assignedFiltersChanged="onAssignedFiltersChanged"
		persistencyKey="DynamicFilterPKey" useToolbar="false" considerSelectionVariants="true" beforeVariantFetch="onBeforeVariantFetched">
		<!--Basic Filter -->
		<smartFilterBar:controlConfiguration>
			<!--Carrier Code-->
			<smartFilterBar:ControlConfiguration index="0" visible="true" key="Carrier" label="{i18n>carrierCode}" visibleInAdvancedArea="true"
				filterType="interval" groupId="_BASIC">
				<smartFilterBar:customControl>
					<MultiComboBox id="carrierCode" items="{ path: '/xSERPERPxCARRCODE', length: 9999, templateShareable:true}"
						selectionChange="onSelectionChangeCarrier">
						<core:ListItem key="{Code}" text="{Code} - {Description}"/>
					</MultiComboBox>
				</smartFilterBar:customControl>
			</smartFilterBar:ControlConfiguration>
			<!--Created On-->
			<smartFilterBar:ControlConfiguration index="1" visible="true" key="CreatedOn" visibleInAdvancedArea="true" groupId="_BASIC"
				filterType="interval" label="{i18n>createdOn}">
				<smartFilterBar:customControl>
					<DateRangeSelection id="dateCreatedOn" delimiter="-" displayFormat="MM/dd/yyyy" change="ChangeDateRangeSelection"/>
				</smartFilterBar:customControl>
			</smartFilterBar:ControlConfiguration>
			<!--Late Deliveries-->
			<smartFilterBar:ControlConfiguration index="2" visible="true" key="LateDeliveries" visibleInAdvancedArea="true"
				label="{i18n>lateDeliveries}" filterType="interval" groupId="_BASIC">
				<smartFilterBar:customControl>
					<CheckBox selected="true"/>
				</smartFilterBar:customControl>
			</smartFilterBar:ControlConfiguration>
			<!--Unshipped Deliveries-->
			<smartFilterBar:ControlConfiguration index="3" visible="true" key="UnshippedDeliveries" visibleInAdvancedArea="true"
				label="{i18n>unshippedDeliveries}" filterType="interval" groupId="_BASIC">
				<smartFilterBar:customControl>
					<CheckBox selected="true"/>
				</smartFilterBar:customControl>
			</smartFilterBar:ControlConfiguration>
			<!--On-time Deliveries-->
			<smartFilterBar:ControlConfiguration index="4" visible="true" key="OntimeDeliveries" visibleInAdvancedArea="true"
				label="{i18n>onTimeDeliveries}" filterType="interval" groupId="_BASIC">
				<smartFilterBar:customControl>
					<CheckBox selected="true"/>
				</smartFilterBar:customControl>
			</smartFilterBar:ControlConfiguration>
		</smartFilterBar:controlConfiguration>
		<!--Shipping Filter-->
		<smartFilterBar:controlConfiguration>
			<!--Service-->
			<smartFilterBar:ControlConfiguration index="0" visible="true" key="Service" visibleInAdvancedArea="false" label="{i18n>service}"
				filterType="interval" groupId="Shipping">
				<smartFilterBar:customControl>
					<MultiComboBox id="idService" items="{path: '/xSERPERPxSERVICES', length: 9999 }" selectionChange="onChangeService">
						<core:ListItem key="{Service}" text="{Service} - {Description}"/>
					</MultiComboBox>
				</smartFilterBar:customControl>
			</smartFilterBar:ControlConfiguration>
			<!--Shipping/Receiving Point-->
			<smartFilterBar:ControlConfiguration index="1" visible="true" key="ShippingPoint" visibleInAdvancedArea="false" groupId="Shipping"
				filterType="interval" label="{i18n>shippingreceivingPoint}">
				<smartFilterBar:customControl>
					<MultiComboBox items="{ path: '/xSERPERPxTVSTT', length: 9999}">
						<core:ListItem key="{shipPoint}" text="{shipPoint} - {Description}"/>
					</MultiComboBox>
				</smartFilterBar:customControl>
			</smartFilterBar:ControlConfiguration>
			<!--Created By-->
			<smartFilterBar:ControlConfiguration index="3" visible="true" key="CreatedBy" visibleInAdvancedArea="false" groupId="Shipping"
				filterType="interval" label="{i18n>createdBy}">
				<smartFilterBar:customControl>
					<MultiInput id="datecreatedBy" submit="onSubmit" showValueHelp="false">
						<core:Item key="{key}" text="{text}"/>
					</MultiInput>
				</smartFilterBar:customControl>
			</smartFilterBar:ControlConfiguration>
		</smartFilterBar:controlConfiguration>
		<!--Delivery Filter-->
		<smartFilterBar:controlConfiguration>
			<!--Requested Delivery Date-->
			<smartFilterBar:ControlConfiguration index="0" visible="true" key="RequestedDeliveryDate" visibleInAdvancedArea="false"
				label="{i18n>requestedDeliveryDate}" filterType="interval" groupId="Delivery">
				<smartFilterBar:customControl>
					<DateRangeSelection id="requestedDeliveryDate" delimiter="-" displayFormat="MM/dd/yyyy" change="ChangeDateRangeSelection"/>
				</smartFilterBar:customControl>
			</smartFilterBar:ControlConfiguration>
			<!--Actual Delivery Date-->
			<smartFilterBar:ControlConfiguration index="1" visible="true" key="ActualDeliveryDate" visibleInAdvancedArea="false"
				label="{i18n>actualDeliveryDate}" filterType="interval" groupId="Delivery">
				<smartFilterBar:customControl>
					<DateRangeSelection id="actualDeliveryDate" delimiter="-" displayFormat="MM/dd/yyyy" change="ChangeDateRangeSelection"/>
				</smartFilterBar:customControl>
			</smartFilterBar:ControlConfiguration>
		</smartFilterBar:controlConfiguration>
	</smartFilterBar:SmartFilterBar>
</core:FragmentDefinition>