<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<ColumnListItem type="Inactive">
		<cells>
			<Link text="{= ${local>ID} ? ${local>ID} : '' }" press="onDisputeIDPressed"/>
			<ObjectStatus text="{path: 'local>Status',formatter: '.formatter.formatDisputeStatus'}"
				state="{path: 'local>Status',formatter: '.formatter.formatDisputeStatusState'}"/>
			<Text text="{local>InvoiceNo}"/>
			<Text text="{local>AccountNo}"/>
			<Text text="{local>CarrierCode}"/>
			<Text text="{local>CompanyCode}"/>
			<Text text="{path: 'local>CreatedDate', formatter:'.formatter.formatDateString'}"/>
			<Text text="{path: 'local>CompletedDate', formatter:'.formatter.formatDateString'}"/>
			<Text text="{local>DaysOpen}"/>
			<ObjectNumber
				number="{ parts:[{path:'local>TotalCreditAmt'},{path:'local>Currency'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
				unit="{path: 'local>Currency'}"/>
		</cells>
	</ColumnListItem>
</core:FragmentDefinition>