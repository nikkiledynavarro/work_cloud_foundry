<core:FragmentDefinition xmlns:u="sap.ui.unified" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<Dialog title="{i18n>dialogUpdateReasonTitle}" beforeClose="onReasonNodeDialogClose" contentHeight="440px">
		<IconTabBar id="idIconTabBarUpdateReCod" expanded="true" select="onSelectTab">
			<items>
				<IconTabFilter icon="sap-icon://hint" key="info">
					<f:SimpleForm layout="ResponsiveGridLayout" title="Address" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="12"
						adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1">
						<f:toolbar>
							<Toolbar visible="{local>/propertyUpdated/isDisplayCheckbox}">
								<Title text="Select which value to update?"/>
								<ToolbarSpacer/>
								<CheckBox visible="{local>/propertyUpdated/isDisplayCheckbox}" selected="{local>/propertyUpdated/selectedAll}" select="onCheckboxSelectAll"/>
							</Toolbar>
						</f:toolbar>
						<f:content>
							<Label text="{i18n>detailDialogReasonCode}"/>
							<Select selectedKey="{local>/selectedDisputeDetail/ChargeCode}" items="{local>/reasonCodeList}" forceSelection="true"
								enabled="{local>/propertyUpdated/isUpdateReaCode}">
								<core:Item key="{local>Code}" text="{local>Description}"></core:Item>
								<layoutData>
									<l:GridData span="XL11 L11 M11 S11"/>
								</layoutData>
							</Select>
							<CheckBox visible="{local>/propertyUpdated/isDisplayCheckbox}" selected="{local>/propertyUpdated/isUpdateReaCode}"
								select="onCheckboxItemSelect" width="0">
								<layoutData>
									<l:GridData span="XL1 L1 M1 S1"/>
								</layoutData>
							</CheckBox>
							<Label text="{parts:['i18n>detailDialogDisputeamtLabel', 'local>/selectedDisputeDetail/Currency'], formatter: 'jQuery.sap.formatMessage'}"/>
							<Input id="idDisputeCreditAmountInput" liveChange="fnValidateNumberic" value="{local>/selectedDisputeDetail/DisputeAmt}" type="Number"
								submit="onCreditSave" enabled="{local>/propertyUpdated/isUpdateDisputeAmt}">
								<layoutData>
									<l:GridData span="XL11 L11 M11 S11"/>
								</layoutData>
							</Input>
							<CheckBox visible="{local>/propertyUpdated/isDisplayCheckbox}" selected="{local>/propertyUpdated/isUpdateDisputeAmt}"
								select="onCheckboxItemSelect">
								<layoutData>
									<l:GridData span="XL1 L1 M1 S1"/>
								</layoutData>
							</CheckBox>
							<Label text="{i18n>detailDialogNote}"/>
							<TextArea maxLength="250" value="{local>/selectedDisputeDetail/Note}" rows="3" enabled="{local>/propertyUpdated/isUpdateNote}">
								<layoutData>
									<l:GridData span="XL11 L11 M11 S11"/>
								</layoutData>
							</TextArea>
							<CheckBox visible="{local>/propertyUpdated/isDisplayCheckbox}" selected="{local>/propertyUpdated/isUpdateNote}"
								select="onCheckboxItemSelect">
								<layoutData>
									<l:GridData span="XL1 L1 M1 S1"/>
								</layoutData>
							</CheckBox>
						</f:content>
					</f:SimpleForm>
				</IconTabFilter>
				<IconTabFilter icon="sap-icon://attachment" key="attachment" enabled="{local>/uploadAttachmentEnabled}">
					<UploadCollection class="border_lightgray_nobottom" id="idAttachmentUploadColec" multiple="false" change="onUploadChange"
						app:objectType="FADISPUTE" uploadUrl="/sap/opu/odata/SERPERP/FRTA_DISP_SRV/xSERPERPxI_DPDTL_ATTA"
						items="{ path: 'toATTA', templateShareable: false }" mode="SingleSelectLeft" instantUpload="false" beforeUploadStarts="onBeforeUpload"
						showSeparators="All" uploadComplete="onUploadComplete" sameFilenameAllowed="false" fileDeleted="onDeleteAttachment">
						<toolbar>
							<OverflowToolbar>
								<Title text="{i18n>Attachments}"/>
								<ToolbarSpacer/>
								<Button id="btnDelete" icon="sap-icon://less" press="onDeleteAttachment" tooltip="{i18n>toolbarTextDelete}"
									app:uploadId="idAttachmentUploadColec"/>
								<UploadCollectionToolbarPlaceholder/>
							</OverflowToolbar>
						</toolbar>
						<items>
							<UploadCollectionItem documentId="{UniqueID}" fileName="{FileName}" mimeType="{FileType}" enableDelete="false" url="{UniqueID}"
								visibleDelete="false" visibleEdit="false" enableEdit="false">
								<attributes>
									<ObjectAttribute title="{i18n>createdOn}" text="{path: 'CreatedOn',formatter: '.formatter.formatDateString'}" active="false"/>
								</attributes>
								<statuses>
									<ObjectStatus title="{i18n>createdBy}" text="{CreatedBy}"/>
								</statuses>
							</UploadCollectionItem>
						</items>
					</UploadCollection>
				</IconTabFilter>
			</items>
		</IconTabBar>
		<buttons>
			<Button text="{i18n>detailDialogChangeCodeUpdate}" press="onChangeCodeUpdate" id="btnUpdate"
				enabled="{= (${local>/propertyUpdated/isUpdateReaCode} || ${local>/propertyUpdated/isUpdateDisputeAmt} || ${local>/propertyUpdated/isUpdateNote})}"
				type="Accept"/>
			<Button text="{i18n>detailDialogChangeCodeAttachFile}" press="onUploadFiles" id="btnUpload" type="Emphasized"/>
			<Button text="{i18n>Close}" press="onChangeCodeClose"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>