<core:FragmentDefinition xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core">
	<Dialog title="{i18n>detailDialogDeletedListTitle}">
		<l:Grid defaultSpan="L12 M12 S12" width="auto">
			<l:content>
				<Table class="border_lightgray_nobottom sapUiSmallMarginTop" width="100%" mode="None" items="{toDELDTL}" growing="true"
					growingThreshold="20">
					<columns>
						<Column demandPopin="true" minScreenWidth="Desktop" width="9.5rem">
							<Text text="{i18n>detailTabColTrackNo}"/>
						</Column>
						<Column demandPopin="true" minScreenWidth="Desktop" hAlign="End" width="3rem">
							<Text text="{i18n>detailTabColBill}"/>
						</Column>
						<Column demandPopin="true" hAlign="End" width="3rem">
							<Text text="{i18n>detailTabColZerp}"/>
						</Column>
						<Column demandPopin="true" minScreenWidth="Desktop" width="2rem">
							<Text text="{i18n>detailTabColCur}"/>
						</Column>
						<Column demandPopin="true" minScreenWidth="Desktop" width="2rem">
							<Text text="{i18n>detailTabColDiff}"/>
						</Column>
						<Column demandPopin="true" minScreenWidth="Desktop" width="2.2rem">
							<Text text="{i18n>detailTabColDiffPerc}"/>
						</Column>
						<Column demandPopin="true" minScreenWidth="Desktop" width="2.7rem">
							<Text text="{i18n>detailTabColBillOpt}"/>
						</Column>
						<Column demandPopin="true" minScreenWidth="Desktop" width="6rem">
							<Text text="{i18n>detailTabColDeleteby}"/>
						</Column>
						<Column demandPopin="true" minScreenWidth="Desktop" width="6rem">
							<Text text="{i18n>detailTabColDeleteon}"/>
						</Column>
						<Column demandPopin="true" minScreenWidth="Desktop" width="6rem">
							<Text text="{i18n>detailTabColNewDisputeID}"/>
						</Column>
					</columns>
					<ColumnListItem type="Inactive">
						<cells>
							<Text text="{Trackpro}"/>
							<Text text="{ parts:[{path:'BilledAmt'},{path:'Currency'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"/>
							<Text text="{ parts:[{path:'SERPAmt'},{path:'Currency'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"/>
							<Text text="{Currency}"/>
							<Text text="{ parts:[{path:'DisputeAmt'},{path:'Currency'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"/>
							<Text text="{ parts:[{path:'DiffPer'},{path:'Currency'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"/>
							<Text text="{BillOption}"/>
							<Text text="{ChangedBy}"/>
							<Text text="{path: 'ChangedDate',formatter: '.formatter.formatDateString'}"/>
							<Text text="{NewDisputeID}"/>
						</cells>
					</ColumnListItem>
				</Table>
			</l:content>
		</l:Grid>
		<buttons>
			<Button text="{i18n>Close}" press="onDeleteListDialogClose"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>