<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<!--Shipment reference no-->
	<Label text="{i18n>ShipmentReferenceNo}"/>
	<Input id="idShipmentRN" value="{local>/basic/general/sub_general/Srn}"
		enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
	<!--State of origin-->
	<Label text="{i18n>stateOfOrigin}"/>
	<ComboBox id="idStateOO" items="{ path: '/xSERPERPxCDS_STATEOFORIGIN', length: 9999 }" selectedKey="{local>/basic/general/sub_general/St}"
		selectionChange="onServiceChange" enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }">
		<core:Item key="{Regio}" text="{Regio} -{Bezei}"></core:Item>
	</ComboBox>
	<!--Foreign trade zone-->
	<Label text="{i18n>foreignTradeZone}"/>
	<ComboBox id="idForeignTZ" items="{ path: '/xSERPERPxCDS_FTZCD', length: 9999 }" selectedKey="{local>/basic/general/sub_general/Ftz}"
		selectionChange="onServiceChange" enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }">
		<core:Item key="{Ftz}" text="{Ftz} - {PortOfEntry}"></core:Item>
	</ComboBox>
	<!--Port of export-->
	<Label text="{i18n>portOfExport}"/>
	<ComboBox id="idPortOE" items="{ path: '/xSERPERPxCDS_USPRT', length: 9999 }" selectedKey="{local>/basic/general/sub_general/Poe}"
		selectionChange="onServiceChange" enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }">
		<core:Item key="{Poe}" text="{Poe} - {PortDesc}"></core:Item>
	</ComboBox>
	<!--Country  of destination-->
	<Label text="{i18n>countyOfDestination}"/>
	<ComboBox id="idCountryOD" items="{ path: '/xSERPERPxCDS_COUNTRYOFDES', length: 9999 }" selectedKey="{local>/basic/general/sub_general/Cod}"
		selectionChange="onServiceChange" enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }">
		<core:Item key="{Land1}" text="{Land1} - {Landx}"></core:Item>
	</ComboBox>
	<!--Port of unlading-->
	<Label text="{i18n>portOfUnlading}"/>
	<ComboBox id="idPortOU" items="{ path: '/xSERPERPxCDS_PORTS', length: 9999 }" selectedKey="{local>/basic/general/sub_general/Pou}"
		selectionChange="onServiceChange" enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }">
		<core:Item key="{Poe}" text="{Poe} - {PortDesc}"></core:Item>
	</ComboBox>
	<!--Import entry number-->
	<Label text="{i18n>importEntryNumber}"/>
	<Input id="idImportEN" value="{local>/basic/general/sub_general/Ibn}"
		enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
	<!--Filling option-->
	<Label text="{i18n>fillingOption}"/>
	<ComboBox id="idFillingOption" selectedKey="{local>/basic/general/sub_general/Fo}" change=""
		enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }">
		<core:Item key="2" text="2 - Predeparture"/>
		<core:Item key="4" text="4 - Postdeparture"/>
	</ComboBox>
</core:FragmentDefinition>