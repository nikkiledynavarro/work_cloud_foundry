<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<!--Name-->
	<Label text="{i18n>name}"/>
	<Input value="{local>/basic/partners/int_consigee/Ad43}"
		enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
	<!--Contact name-->
	<Label text="{i18n>contactName}"/>
	<Input value="{local>/basic/partners/int_consigee/Ad45}"
		enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
	<!--Contact phone-->
	<Label text="{i18n>contactPhone}"/>
	<Input value="{local>/basic/partners/int_consigee/Ad47}"
		enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
	<!--Address Line 1-->
	<Label text="{i18n>address1}"/>
	<Input value="{local>/basic/partners/int_consigee/Ad48}"
		enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
	<!--Address line 2-->
	<Label text="{i18n>address2}"/>
	<Input value="{local>/basic/partners/int_consigee/Ad49}"
		enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
	<core:Title text=""></core:Title>
	<!--City-->
	<Label text="{i18n>city}"/>
	<Input value="{local>/basic/partners/int_consigee/Ad410}"
		enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
	<!--State-->
	<Label text="{i18n>state}"/>
	<ComboBox id="idstate" items="{path: 'local>/States'}" selectedKey="{local>/basic/partners/int_consigee/Ad411}"
		selectionChange="onLastChangedBy" enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }">
		<core:Item key="{local>Bland}" text="{local>Bland} - {local>Bezei}"></core:Item>
	</ComboBox>
	<!--Country-->
	<Label text="{i18n>country}"/>
	<Input value="{local>/basic/partners/int_consigee/Ad412}"
		enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
	<!--Postal code-->
	<Label text="{i18n>postalCode}"/>
	<Input value="{local>/basic/partners/int_consigee/Ad413}"
		enabled="{= (${local>/basic} &amp;&amp; ${local>/AceSubmit} === true) ? false : true }"/>
</core:FragmentDefinition>