<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:form="sap.ui.layout.form">
	<Dialog contentWidth="850px" title="Freight Unit Items" class="sapUiContentPadding">
		<content>
			<Table id="tableHUItem" items="{local>/FreightunitItems}" class="border_lightgray_nobottom" mode="None">
				<columns>
					<Column width="5rem">
						<Text text="Freight Unit"/>
					</Column>
					<Column width="4.5rem">
						<Text text="Delivery" tooltip="Delivery"/>
					</Column>
					<Column hAlign="Center" width="2rem">
						<Text text="Item"/>
					</Column>
					<Column width="6rem">
						<Text text="Material"/>
					</Column>
					<Column width="6rem">
						<Text text="Description"/>
					</Column>
					<Column width="3rem" hAlign="Center">
						<Text text="Quant" tooltip="Quantity"/>
					</Column>
					<Column width="2.5rem" hAlign="Center">
						<Text text="UOM"/>
					</Column>
					<Column width="4.5rem">
						<Text text="HU No"/>
					</Column>
					<Column width="2rem" hAlign="Center">
						<Text text="Line"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<ObjectStatus state="Success" text="{= parseInt(${local>freightunitkey}) }" tooltip="{local>freightunitkey}"/>
							<ObjectStatus state="Success" text="{local>delivery}" tooltip="{local>delivery}"/>
							<Text text="{= parseInt(${local>deliveryitem}) }" wrapping="false" tooltip="{local>deliveryitem}"/>
							<ObjectStatus state="Warning" text="{path:'local>material', formatter: '.formatter.removeLeadingZero'}"/>
							<Text text="{local>description}" wrapping="false" tooltip="{local>description}"/>
							<Text text="{= parseInt(${local>quantity}) }"/>
							<Text text="{local>uom}"/>
							<Text text="{local>hu_id}"/>
							<Text text="{= parseInt(${local>linenumber}) }"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<endButton>
			<Button text="{i18n>Close}" press="onCloseHUItemsDialog"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>