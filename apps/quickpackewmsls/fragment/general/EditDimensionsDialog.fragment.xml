<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:form="sap.ui.layout.form">
	<Dialog title="Change Dimensions">
		<content>
			<form:Form width="100%" editable="true" visible="true">
				<form:formContainers>
					<form:FormContainer visible="true">
						<form:formElements>
							<form:FormElement visible="true">
								<form:label>
									<Label text="Length"/>
								</form:label>
								<form:fields>
									<Input id="length" type="Number" value="{local>/EditDimensions/length}"/>
								</form:fields>
							</form:FormElement>
							<form:FormElement visible="true">
								<form:label>
									<Label text="Width"/>
								</form:label>
								<form:fields>
									<Input id="width" type="Number" value="{local>/EditDimensions/width}"/>
								</form:fields>
							</form:FormElement>
							<form:FormElement visible="true">
								<form:label>
									<Label text="Height"/>
								</form:label>
								<form:fields>
									<Input id="height" type="Number" value="{local>/EditDimensions/height}"/>
								</form:fields>
							</form:FormElement>
						</form:formElements>
						<form:title/>
					</form:FormContainer>
				</form:formContainers>
				<form:layout>
					<form:ResponsiveGridLayout adjustLabelSpan="false" columnsL="2" labelSpanL="3" columnsM="1" labelSpanM="2" labelSpanS="12"/>
				</form:layout>
			</form:Form>
		</content>
		<beginButton>
			<Button text="OK" type="Emphasized" press="onConfirmEditDimensions"/>
		</beginButton>
		<endButton>
			<Button text="Cancel" press="onCloseEdit" type="Reject"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>