<mvc:View controllerName="com.erpis.shiperp.sls.freightordersls.controller.ConditionDetail" xmlns="sap.m" xmlns:uxap="sap.uxap"
	xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:layout="sap.ui.layout">
	<uxap:ObjectPageLayout showTitleInHeaderContent="true" alwaysShowContentHeader="false" preserveHeaderStateOnScroll="false"
		headerContentPinnable="true" isChildPage="true" enableLazyLoading="false" showFooter="true">
		<uxap:headerTitle>
			<uxap:ObjectPageDynamicHeaderTitle>
				<uxap:heading>
					<Title text="{i18n>SidebySideComparison}: {InvoiceNo} / {TrackingNo}"/>
				</uxap:heading>
				<uxap:navigationActions>
					<OverflowToolbarButton type="Emphasized" icon="sap-icon://navigation-left-arrow" tooltip="{i18n>Previous}" press="onPrevPress"/>
					<OverflowToolbarButton type="Emphasized" icon="sap-icon://navigation-right-arrow" tooltip="{i18n>Next}" press="onNextPress"/>
				</uxap:navigationActions>
			</uxap:ObjectPageDynamicHeaderTitle>
		</uxap:headerTitle>
		<uxap:headerContent>
			<layout:VerticalLayout class="sapUiMediumMarginEnd">
				<HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
					<Text text="{i18n>ApprovalStatus}:" class="sapUiSmallMarginEnd"/>
					<ObjectStatus icon="{path: 'DetailStatus', formatter: '.formatter.formatTrackingApprovalStatusIcon'}"
						text="{path: 'DetailStatus', formatter: '.formatter.formatTrackingApprovalStatusDesc'}"
						state="{path: 'DetailStatus', formatter: '.formatter.formatTrackingApprovalStatusColor'}"></ObjectStatus>
				</HBox>
				<HBox justifyContent="SpaceBetween">
					<Text text="{i18n>MatchStatus}:"/>
					<ObjectStatus text="{parts: [{path: 'OriginalPayAmt'}, {path: 'SERPAmount'}], formatter: '.formatter.formatTrackingMatchPercentage'}%"
						state="{parts: [{path: 'OriginalPayAmt'}, {path: 'SERPAmount'}], formatter: '.formatter.formatTrackingAmountState'}"></ObjectStatus>
				</HBox>
			</layout:VerticalLayout>
			<layout:VerticalLayout class="sapUiMediumMarginEnd">
				<HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
					<Text text="{i18n>AmountChange}:" class="sapUiSmallMarginEnd"/>
					<ObjectStatus text="{path: 'AmountDiffer', type: 'sap.ui.model.type.Float', formatOptions: { maxFractionDigits: 2 }} {currency}"
						state="{parts: [{path: 'OriginalPayAmt'}, {path: 'SERPAmount'}], formatter: '.formatter.formatTrackingAmountUpDownState'}"></ObjectStatus>
				</HBox>
				<HBox justifyContent="SpaceBetween">
					<Text text="{i18n>PercentChange}:" class="sapUiSmallMarginEnd"/>
					<ObjectStatus text="{path: 'PercentDiffer', type: 'sap.ui.model.type.Float', formatOptions: { maxFractionDigits: 2 }} %"
						state="{parts: [{path: 'OriginalPayAmt'}, {path: 'SERPAmount'}], formatter: '.formatter.formatTrackingAmountUpDownState'}"></ObjectStatus>
				</HBox>
			</layout:VerticalLayout>
			<layout:VerticalLayout class="sapUiMediumMarginEnd">
				<HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
					<Text text="{i18n>Approved}:" class="sapUiSmallMarginEnd"/>
					<ObjectStatus text="{= ${local>/countApproved} + ${local>/countReleased}}" state="Success"></ObjectStatus>
				</HBox>
				<HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
					<Text text="Open:" class="sapUiSmallMarginEnd"/>
					<ObjectStatus text="{local>/countOpen}" state="Warning"></ObjectStatus>
				</HBox>
				<HBox justifyContent="SpaceBetween">
					<Text text="Disputed:" class="sapUiSmallMarginEnd"/>
					<ObjectStatus text="{local>/countDisputed}" state="Error"></ObjectStatus>
				</HBox>
			</layout:VerticalLayout>
		</uxap:headerContent>
		<uxap:sections>
			<uxap:ObjectPageSection showTitle="true" titleUppercase="false" visible="true">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>Comparison}" mode="Expanded">
						<uxap:blocks>
							<core:Fragment fragmentName="com.erpis.shiperp.sls.freightordersls.fragment.ComparisonSection" type="XML"/>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
				<uxap:customAnchorBarButton/>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection showTitle="true" titleUppercase="false" visible="true">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>Address}" mode="Expanded">
						<uxap:blocks>
							<core:Fragment fragmentName="com.erpis.shiperp.sls.freightordersls.fragment.AddressSection" type="XML"/>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection showTitle="true" titleUppercase="false" visible="true">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>General}" mode="Expanded">
						<uxap:blocks>
							<core:Fragment fragmentName="com.erpis.shiperp.sls.freightordersls.fragment.GeneralSection" type="XML"/>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection showTitle="true" titleUppercase="false" visible="true">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>Freight}" mode="Expanded">
						<uxap:blocks>
							<core:Fragment fragmentName="com.erpis.shiperp.sls.freightordersls.fragment.FreightSection" type="XML"/>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
		</uxap:sections>
		<uxap:footer>
			<OverflowToolbar>
				<Button id="popoverButton" icon="sap-icon://message-popup" text="{messageModel>/messagesLength}" type="Emphasized"
					press="handleMessagePopoverPress"/>
				<ToolbarSpacer/>
				<Button text="{i18n>Approve}" press="onApprovePress" type="Accept"/>
				<Button text="{i18n>Dispute}" press="onDisputePress" type="Reject"/>
				<Button text="{i18n>updateStatusButtonText}" press="onStatusClick"/>
				<Button text="{i18n>Cancel}" press="onCancelPress"/>
			</OverflowToolbar>
		</uxap:footer>
	</uxap:ObjectPageLayout>
</mvc:View>