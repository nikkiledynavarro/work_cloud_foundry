<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Dialog title="{i18n>transportationUnitCockpit}" contentWidth="1000px">
		<content>
			<f:SimpleForm id="SimpleTus" layout="ResponsiveGridLayout" singleContainerFullSize="false">
				<f:content>
					<!--TU-->
					<Label text="{i18n>tu}"/>
					<ComboBox items="{ path: 'local>/aTuNum_ExtList' }" selectedKey="{TUCockpit>/TuNumExt}" width="40%">
						<core:ListItem key="{local>TuNumExt}" text="{local>TuNumExt}"/>
					</ComboBox>
					<!--Carrier-->
					<Label text="{i18n>carrier}"/>
					<ComboBox items="{ path: 'local>/aCarrierList' }" showSecondaryValues="true" selectedKey="{TUCockpit>/Carrier}" width="20%">
						<core:ListItem key="{local>Description}" text="{local>Carrier}" additionalText="{local>Description}"/>
					</ComboBox>
					<!--SCAC-->
					<Label text="{i18n>scac}"/>
					<ComboBox items="{ path: 'local>/aScaccurrList' }" showSecondaryValues="true" selectedKey="{TUCockpit>/ScacCurr}" width="20%">
						<core:ListItem key="{local>Description}" text="{local>ScacCurr}" additionalText="{local>Description}"/>
					</ComboBox>
					<!--Means of Transport-->
					<Label text="{i18n>meansOfTransport}"/>
					<ComboBox id="idMeansOfTrans" items="{ path: 'local>/aMeansOfTransportList' }" showSecondaryValues="true" selectedKey="{TUCockpit>/Mtr}"
						width="20%" required="true">
						<core:ListItem key="{local>Mtr}" text="{local>Mtr}" additionalText="{local>Description}"/>
					</ComboBox>
					<!--Pack. Material-->
					<Label text="{i18n>packMaterial}"/>
					<ComboBox id="idPackMaterial" items="{ path: 'local>/aPackMaterialList' }" showSecondaryValues="true" selectedKey="{TUCockpit>/PackMat}"
						width="20%" required="true">
						<core:ListItem key="{local>PackMat}" text="{local>PackMat}" additionalText="{local>Description}"/>
					</ComboBox>
					<!--Route-->
					<Label text="{i18n>route}"/>
					<ComboBox items="{ path: 'local>/aRouteList' }" showSecondaryValues="true" selectedKey="{TUCockpit>/Route}" width="50%">
						<core:ListItem key="{local>Description}" text="{local>Route}" additionalText="{local>Description}"/>
					</ComboBox>
					<!--S&R Activity Direction-->
					<Label text="{i18n>ActivityDirection}"/>
					<ComboBox id="idActyDire" items="{ path: 'local>/aActivityDirectionList' }" showSecondaryValues="true" selectedKey="{TUCockpit>/ActDir}"
						width="60%" required="true">
						<core:ListItem key="{local>ActDir}" text="{local>ActDir}" additionalText="{local>Description}"/>
					</ComboBox>
					<!--S&R Activity Start Date-->
					<Label text="{i18n>ActivityStartDate}"/>
					<!--<DatePicker id="idStartActD" value="{TUCockpit>/StartActD}" width="20%" valueFormat="yyyy-MM-dd" displayFormat="MM/dd/yyyy" required="true"></DatePicker>-->
					<DatePicker id="idStartActD" editable="true" value="{path:'TUCockpit>/StartActD', formatter: '.formatter.formatDateTime'}"
						valueFormat="yyyy-MM-dd" displayFormat="MM/dd/yyyy"></DatePicker>
					<!--S&R Activity Start Time-->
					<Label text="{i18n>ActivityStartTime}"/>
					<!--<TimePicker id="idStartActT" value="{TUCockpit>/StartActT}" width="20%" valueFormat="HH:mm:ss" displayFormat="HH:mm:ss"-->
					<!--	change="handleChange" placeholder="HH:mm:ss" required="true"/>-->
					<TimePicker id="idStartActT" editable="true" value="{path: 'TUCockpit>/StartActT', formatter: '.formatter.formatTime'}"
						valueFormat="HH:mm:ss" displayFormat="HH:mm:ss" placeholder="HH:mm:ss"/>
					<!--S&R Activity End Date-->
					<Label text="{i18n>ActivityEndDate}"/>
					<!--<DatePicker id="idEndActD" value="{TUCockpit>/EndActD}" width="20%" valueFormat="yyyy-MM-dd" displayFormat="MM/dd/yyyy" required="true"></DatePicker>-->
					<DatePicker id="idEndActD" editable="true" value="{path:'TUCockpit>/StartActD', formatter: '.formatter.formatDateTime'}"
						valueFormat="yyyy-MM-dd" displayFormat="MM/dd/yyyy"></DatePicker>
					<!--S&R Activity End Time-->
					<Label text="{i18n>ActivityEndTime}"/>
					<!--<TimePicker id="idEndActT" value="{TUCockpit>/EndActT}" width="20%" valueFormat="HH:mm:ss" displayFormat="HH:mm:ss" change="handleChange"-->
					<!--	placeholder="HH:mm:ss" required="true"/>-->
					<TimePicker id="idEndActT" editable="true" value="{path: 'TUCockpit>/EndActT', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss"
						displayFormat="HH:mm:ss" placeholder="HH:mm:ss"/>
					<!--ShipERP Carrier Code-->
					<Label text="{i18n>shipERPCarrierCode}"/>
					<Input value="{TUCockpit>/TusrCarrier}" editable="false" width="20%"/>
					<!--ShipERP Carrier Service ID-->
					<Label text="{i18n>shipERPCarrierServiceID}"/>
					<Input value="{TUCockpit>/TusrService}" editable="false" width="70%"/>
					<!--Misc. Carrier-->
					<Label text="{i18n>miscCarrier}"/>
					<Input value="{TUCockpit>/TusrMiscCarr}" editable="false" width="50%"/>
					<!--Load Number-->
					<Label text="{i18n>loadNumber}"/>
					<Input value="{TUCockpit>/TusrLoadNo}" width="40%"/>
				</f:content>
			</f:SimpleForm>
		</content>
		<beginButton>
			<Button icon="sap-icon://accept" press="onAcceptpressed" type="Accept"/>
		</beginButton>
		<endButton>
			<Button icon="sap-icon://decline" press="onCloseDialog" type="Reject"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>