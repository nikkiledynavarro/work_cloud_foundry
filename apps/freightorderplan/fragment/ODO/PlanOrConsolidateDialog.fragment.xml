<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
	<Dialog title="{i18n>planOrConsolidateDialogTitle}">
		<Text text="{i18n>planOrConsolidateDialog}" class="sapUiTinyMarginBegin"/>
		<Table class="sapUiTinyMargin border_lightgray_nobottom" width="500px" selectionChange="onSelectionTUConsolidate" id="tblPlanOrConsolidate"
			mode="MultiSelect" items="{path:'local>/aOpenAvailableTUs', sorter: { path: 'TuSrActNum', descending: false }}">
			<headerToolbar>
				<OverflowToolbar>
					<SearchField width="90%" showSearchButton="true" search="handlePlanConsolidateSearch" class="sapUiTinyMarginBegin"/>
				</OverflowToolbar>
			</headerToolbar>
			<columns>
				<Column hAlign="Center"></Column>
			</columns>
			<items>
				<ColumnListItem type="Inactive">
					<cells>
						<Text text="{local>TuNum}"/>
					</cells>
				</ColumnListItem>
			</items>
		</Table>
		<buttons>
			<Button text="{i18n>planOrConsolidateDialogPlanNewTU}" press="onPlanConsolidateDialogPlanNewTUPressed" type="Accept"/>
			<Button enabled="{=${local>/aOpenAvailableTUs}.length >0 ?true:false}" text="{i18n>planOrConsolidateDialogConsolidatetoExistingTU}"
				press="onAssignConsolidatetoExistingTUPressed" type="Emphasized"/>
			<Button text="{i18n>planOrConsolidateDialogCancel}" press="onClosePlanOrConsolidateDialog" type="Reject"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>