<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Dialog title="Vehicle Details" contentWidth="1500px">
		<content>
			<f:SimpleForm width="auto" editable="true" layout="ResponsiveGridLayout" labelSpanXL="6" labelSpanL="6" labelSpanM="6" labelSpanS="4"
				columnsXL="4" columnsL="4" columnsM="3" class="border_lightgray sapUiSmallMarginBottom">
				<f:content>
					<!--ShipERP Fields-->
					<core:Title text="{i18n>shiperpFields}"></core:Title>
					<Label text="{i18n>carrier}"/>
					<ComboBox editable="false" selectedKey="{VehicleDetail>/Carrier}" items="{path: '/xSERPERPxCDS_CARR_COD'}">
						<core:Item key="{CarrierCode}" text="{CarrierCode}"></core:Item>
					</ComboBox>
					<Label text="{i18n>service}"/>
					<ComboBox editable="false" selectedKey="{VehicleDetail>/Service}" items="{path: 'local>/ServiceList'}">
						<core:Item key="{local>Service}" text="{local>Service}"></core:Item>
					</ComboBox>
					<Label text="{i18n>miscellaneousCarrier}"/>
					<Input editable="false" value="{VehicleDetail>/vehmisccarr}"/>
					<Label text="{i18n>trackProNumber}"/>
					<Input editable="false" value="{VehicleDetail>/vehtrackpro}"/>
					<!--Status-->
					<core:Title text="{i18n>status}"></core:Title>
					<Label text="{i18n>notConsistnent}"/>
					<ObjectStatus icon="{path: 'VehicleDetail>/StatNc', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'VehicleDetail>/StatNc', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>genneralBlock}"/>
					<ObjectStatus icon="sap-icon://up" state="Warning"></ObjectStatus>
					<Label text="{i18n>arrivalAtCheckpoint}"/>
					<ObjectStatus icon="{path: 'VehicleDetail>/StatChki', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'VehicleDetail>/StatChki', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>departureFromCheckpoint}"/>
					<ObjectStatus icon="{path: 'VehicleDetail>/StatChko', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'VehicleDetail>/StatChko', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>blockedForCheck-In/Out}"/>
					<ObjectStatus icon="{path: 'VehicleDetail>/StatBlc', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'VehicleDetail>/StatBlc', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>goodsReceiptStarted}"/>
					<ObjectStatus icon="{path: 'VehicleDetail>/StatBgr', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'VehicleDetail>/StatBgr', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>goodsReceiptPosted}"/>
					<ObjectStatus icon="{path: 'VehicleDetail>/StatPgr', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'VehicleDetail>/StatPgr', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>goodsIssueStarted}"/>
					<ObjectStatus icon="{path: 'VehicleDetail>/StatBgi', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'VehicleDetail>/StatBgi', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>goodsIssuePosted}"/>
					<ObjectStatus icon="{path: 'VehicleDetail>/StatPgi', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'VehicleDetail>/StatPgi', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>blockedForGoodsMovements}"/>
					<ObjectStatus icon="{path: 'VehicleDetail>/StatBlgm', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'VehicleDetail>/StatBlgm', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<core:Title text=""></core:Title>
					<Label text="{i18n>loadStarted}"/>
					<ObjectStatus icon="{path: 'VehicleDetail>/StatLs', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'VehicleDetail>/StatLs', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>loadingCompleted}"/>
					<ObjectStatus icon="{path: 'VehicleDetail>/StatLc', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'VehicleDetail>/StatLc', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>unloadingStarted}"/>
					<ObjectStatus icon="{path: 'VehicleDetail>/StatBu', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'VehicleDetail>/StatBlgm', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>unloadingCompleted}"/>
					<ObjectStatus icon="{path: 'VehicleDetail>/StatUc', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'VehicleDetail>/StatBlgm', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>blockedForLoading/Unloading}"/>
					<ObjectStatus icon="{path: 'VehicleDetail>/StatBll', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'VehicleDetail>/StatBll', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>invoiceRequested}"/>
					<ObjectStatus icon="{path: 'VehicleDetail>/StatIbgi', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'VehicleDetail>/StatIbgi', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>messageSentToTMS}"/>
					<ObjectStatus icon="{path: 'VehicleDetail>/StatTmsd', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'VehicleDetail>/StatTmsd', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>blockedDueToCustomesProcess}"/>
					<ObjectStatus icon="{path: 'VehicleDetail>/StatBlcp', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'VehicleDetail>/StatBlcp', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>marksForArchiving}"/>
					<ObjectStatus icon="{path: 'VehicleDetail>/StatMarc', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'VehicleDetail>/StatMarc', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<Label text="{i18n>archived}"/>
					<ObjectStatus icon="{path: 'VehicleDetail>/StatAarc', formatter: '.formatter.validateVehicleIcon'}"
						state="{path: 'VehicleDetail>/StatAarc', formatter: '.formatter.validateVehicleStatusColor'}"></ObjectStatus>
					<core:Title text=""></core:Title>
					<Label text="{i18n>frgtDocNo}"/>
					<Input editable="false" value="{VehicleDetail>/DasDocno}"/>
					<Label text="{i18n>driver}"/>
					<Input editable="false" value="{VehicleDetail>/Driver}"/>
					<Label text="{i18n>vehcID}"/>
					<Input editable="false" value="{VehicleDetail>/VehIdent1}"/>
					<Label text="{i18n>vehcID}"/>
					<Input editable="false" value="{VehicleDetail>/VehIdent2}"/>
					<Label text="{i18n>vehcID}"/>
					<Input editable="false" value="{VehicleDetail>/VehIdent3}"/>
					<Label text="{i18n>creationUser}"/>
					<Input editable="false" value="{VehicleDetail>/CreatedBy}"/>
					<Label text="Creation Date"/>
					<DatePicker editable="false" value="{path:'VehicleDetail>/CreatedAtDate', formatter: '.formatter.formatDateTime'}" valueFormat="yyyy-MM-dd"
						displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker editable="false" value="{path: 'VehicleDetail>/CreatedAtTime', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss"
						displayFormat="HH:mm:ss" placeholder="HH:mm:ss"/>
					<Label text="{i18n>changeUser}"/>
					<Input editable="false" value="{VehicleDetail>/ChangedAt}"/>
					<Label text="{i18n>changeUserDate}"/>
					<Label text="Change Date"/>
					<DatePicker editable="false" value="{path:'VehicleDetail>/ChangedAtDate', formatter: '.formatter.formatDateTime'}" valueFormat="yyyy-MM-dd"
						displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker editable="false" value="{path: 'VehicleDetail>/ChangedAtTime', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss"
						displayFormat="HH:mm:ss" placeholder="HH:mm:ss"/>
					<Label text="{i18n>totalWeight}"/>
					<Input editable="false" value="{VehicleDetail>/VehWeight}"/>
					<Label text="{i18n>maxWeightVolume}"/>
					<Input editable="false" value="{VehicleDetail>/LoadWeight}"/>
					<Input editable="false" value="{VehicleDetail>/LoadVolume}"/>
					<Label text="{i18n>maxLengthWidth}"/>
					<Input editable="false" value="{VehicleDetail>/LoadLength}"/>
					<Input editable="false" value="{VehicleDetail>/LoadWidth}"/>
					<Label text="{i18n>maxHeight}"/>
					<Input editable="false" value="{VehicleDetail>/LoadHeight}"/>
					<!--Vehicle-->
					<core:Title text="{i18n>vehicle}"></core:Title>
					<Label text="{i18n>vehicle}"/>
					<Input editable="false" value="{VehicleDetail>/VehNumExt}"/>
					<Label text="{i18n>carrier}"/>
					<Input editable="false" value="{VehicleDetail>/TspCarrier}"/>
					<Label text="{i18n>scac}"/>
					<Input editable="false" value="{VehicleDetail>/ScacCurr}"/>
					<Label text="{i18n>licensePlateNumber}"/>
					<Input editable="false" value="{VehicleDetail>/LicPlate}"/>
					<Label text="{i18n>intVehicleNo}"/>
					<Input editable="false" value="{ path: 'VehicleDetail>/VehNum', formatter: '.formatter.validateDocNo'}"/>
					<Label text="{i18n>veh}"/>
					<Input editable="false" value="{VehicleDetail>/VehSrActNum}"/>
					<Label text="{i18n>state}"/>
					<Input editable="false" value="{VehicleDetail>/SrActState}"/>
					<Label text="{i18n>actyType}"/>
					<Input editable="false" value="{VehicleDetail>/ActType}"/>
					<Label text="{i18n>meansOfTrans}"/>
					<Input editable="false" value="{VehicleDetail>/Mtr}"/>
					<Label text="{i18n>transpMode}"/>
					<Input editable="false" value="{VehicleDetail>/Mot}"/>
					<Label text=""/>
					<CheckBox editable="false" value="{VehicleDetail>/FlgDateActual}" text="{i18n>lockByExtSyst}"/>
					<Label text="{i18n>lockDate}"/>
					<DatePicker editable="false" value="{path:'VehicleDetail>/ChgExtDate', formatter: '.formatter.formatDateTime'}" valueFormat="yyyy-MM-dd"
						displayFormat="MM/dd/yyyy"></DatePicker>
					<Label text="{i18n>expirationDate}"/>
					<DatePicker editable="false" value="{VehicleDetail>/ChgExpiDate}" valueFormat="yyyy-MM-dd" displayFormat="MM/dd/yyyy"></DatePicker>
					<!--Arrival/ Departure-->
					<core:Title text="{i18n>arrivalDeparture}"></core:Title>
					<Label text="{i18n>arrival}"/>
					<DatePicker editable="false" value="{ path:'VehicleDetail>/StartActD', formatter: '.formatter.formatDateTime' }" valueFormat="yyyy-MM-dd"
						displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker editable="false" value="{ path:'VehicleDetail>/StartActT', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss"
						displayFormat="HH:mm:ss" placeholder="HH:mm:ss"/>
					<Label text="{i18n>departure}"/>
					<DatePicker editable="false" value="{ path:'VehicleDetail>/EndActD', formatter: '.formatter.formatDateTime' }" valueFormat="yyyy-MM-dd"
						displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker editable="false" value="{path: 'VehicleDetail>/EndActT', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss"
						displayFormat="HH:mm:ss" placeholder="HH:mm:ss"/>
					<!--Planned Arrival Period-->
					<core:Title text="{i18n>plannedArrivalPeriod}"></core:Title>
					<Label text="{i18n>start}"/>
					<DatePicker editable="false" value="{ path:'VehicleDetail>/StartActual', formatter: '.formatter.formatDateTime' }" valueFormat="yyyy-MM-dd"
						displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker editable="false" value="{path: 'VehicleDetail>/StartPlanTstfrT', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss"
						displayFormat="HH:mm:ss" placeholder="HH:mm:ss"/>
					<Label text="{i18n>end}"/>
					<DatePicker editable="false" value="{ path:'VehicleDetail>/EndActual', formatter: '.formatter.formatDateTime' }" valueFormat="yyyy-MM-dd"
						displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker editable="false" value="{path: 'VehicleDetail>/StartPlanTsttoT', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss"
						displayFormat="HH:mm:ss" placeholder="HH:mm:ss"/>
					<!--Planned Departure Period-->
					<core:Title text="Planned Departure Period"></core:Title>
					<Label text="{i18n>start}"/>
					<DatePicker editable="false" value="{ path:'VehicleDetail>/StartPlanTstfrD', formatter: '.formatter.formatDateTime' }"
						valueFormat="yyyy-MM-dd" displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker editable="false" value="{path: 'VehicleDetail>/EndPlanTstfrT', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss"
						displayFormat="HH:mm:ss" placeholder="HH:mm:ss"/>
					<Label text="{i18n>end}"/>
					<DatePicker editable="false" value="{ path:'VehicleDetail>/EndPlanTstfrD', formatter: '.formatter.formatDateTime' }"
						valueFormat="yyyy-MM-dd" displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker editable="false" value="{path: 'VehicleDetail>/EndPlanTsttoT', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss"
						displayFormat="HH:mm:ss" placeholder="HH:mm:ss"/>
					<!--Actual Arrival/Actual Departure-->
					<core:Title text="{i18n>actualArrival/actualDeparture}"></core:Title>
					<Label text="{i18n>actualArrival}"/>
					<DatePicker editable="false" value="{ path:'VehicleDetail>/StartActualD', formatter: '.formatter.formatDateTime' }" valueFormat="yyyy-MM-dd"
						displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker editable="false" value="{path: 'VehicleDetail>/StartActualT', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss"
						displayFormat="HH:mm:ss" placeholder="HH:mm:ss"/>
					<Label text="{i18n>actualDeparture}"/>
					<DatePicker editable="false" value="{ path:'VehicleDetail>/EndActualD', formatter: '.formatter.formatDateTime' }" valueFormat="yyyy-MM-dd"
						displayFormat="MM/dd/yyyy"></DatePicker>
					<TimePicker editable="false" value="{path: 'VehicleDetail>/EndActualT', formatter: '.formatter.formatTime'}" valueFormat="HH:mm:ss"
						displayFormat="HH:mm:ss" placeholder="HH:mm:ss"/>
				</f:content>
			</f:SimpleForm>
		</content>
		<endButton>
			<Button icon="sap-icon://decline" press="onCloseVehicleDetails" type="Reject"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>