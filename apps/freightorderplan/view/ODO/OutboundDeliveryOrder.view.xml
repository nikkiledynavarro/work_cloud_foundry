<mvc:View controllerName="com.erpis.shiperp.hr7.tuv.controller.ODO.OutboundDeliveryOrder" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc"
	xmlns:l="sap.ui.layout" xmlns:core="sap.ui.core" xmlns:f="sap.f" height="100%" xmlns:form="sap.ui.layout.form" xmlns:table="sap.ui.table"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1" xmlns:smartTable="sap.ui.comp.smarttable"
	xmlns:smartFilterBar="sap.ui.comp.smartfilterbar" xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<f:DynamicPage id="dynamicPageIdEWM" preserveHeaderStateOnScroll="true" headerExpanded="true" showFooter="true">
		<!--  DynamicPage Title -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<FlexBox alignItems="Center">
						<Image class="sapUiSmallMarginEnd" src="{path: '', formatter: '.formatter.getTransparentLogoLink' }" height="1.5rem"/>
					</FlexBox>
				</f:heading>
				<f:snappedContent>
					<Text id="statusText"></Text>
				</f:snappedContent>
				<f:actions>
					<MenuButton text="Plan to TU Screen" tooltip="Plan to TU Screen" class="sapUiSmallMarginEnd">
						<menu>
							<Menu>
								<MenuItem text="Plan to TU Screen" press="onPlantoTUScreenPress"/>
								<MenuItem text="TU Screen" press="onTUScreenPress"/>
								<MenuItem text="Vehicle Screen" press="onVehicleScreenPress"/>
							</Menu>
						</menu>
					</MenuButton>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<!-- DynamicPage Header -->
		<f:header>
			<f:DynamicPageHeader>
				<f:content>
					<core:Fragment fragmentName="com.erpis.shiperp.hr7.tuv.fragment.ODO.DynamicFilterODO" type="XML"/>
				</f:content>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<IconTabBar id="itbFreightUnit" select="onQuickFilter" class="border_lightblue_nobottom width_auto sapUiNoContentPadding "
				expandable="false">
				<content>
					<ScrollContainer horizontal="true" vertical="true">
						<smartTable:SmartTable entitySet="ODOHeaderSet" smartFilterId="DynamicFilter" tableType="ResponsiveTable" useExportToExcel="true"
							useVariantManagement="true" useTablePersonalisation="true" persistencyKey="SmartFilterPKey" enableAutoBinding="true" id="ODOsTable"
							header="{i18n>availableDeliveries}" showRowCount="true" showFullScreenButton="true" demandPopin="false" showOverlay="onShowOverlay"
							initialise="onTableInitialise" beforeRebindTable="onBeforeTableRebind" tableBindingPath="oModelODOTable>/" customData:useSmartToggle="true"
							customData:useSmartField="false">
							<Table growing="true" selectionChange="onSelectionChange" growingThreshold="100" showOverlay="false" growingScrollToLoad="false"
								mode="MultiSelect" fixedLayout="true">
								<columns>
									<!--Document No.-->
									<Column>
										<Text text="{i18n>tableCarrierIdColumnTitle}" wrapping="false" tooltip="{i18n>tableCarrierIdColumnTitle}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "DocumentNo", "columnIndex":"2", "leadingProperty": "DocumentNo"}'/>
										</customData>
									</Column>
									<!--Doc. Cat.-->
									<Column>
										<Text text="{i18n>tableCarrierServiceIdColumnTitle}" wrapping="false" tooltip="{i18n>tableCarrierServiceIdColumnTitle}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "Doccat", "columnIndex":"2", "leadingProperty": "Doccat"}'/>
										</customData>
									</Column>
									<!--Doc. Type-->
									<Column>
										<Text text="{i18n>tableTuIntColumnTitle}" wrapping="false" tooltip="{i18n>tableTuIntColumnTitle}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "DocumentType", "columnIndex":"3", "leadingProperty": "DocumentType"}'/>
										</customData>
									</Column>
									<!--ERP Document-->
									<Column>
										<Text text="{i18n>tableActivityNumberColumnTitle}" wrapping="false" tooltip="{i18n>tableActivityNumberColumnTitle}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "ERPDocument", "columnIndex":"4", "leadingProperty": "ERPDocument"}'/>
										</customData>
									</Column>
									<!--Warehouse No.-->
									<Column>
										<Text text="{i18n>tableAssignObjchangedColumnTitle}" wrapping="false" tooltip="{i18n>tableAssignObjchangedColumnTitle}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "WarehouseNumber", "columnIndex":"5", "leadingProperty": "WarehouseNumber"}'/>
										</customData>
									</Column>
									<!--Stage Area Group-->
									<Column>
										<Text text="{i18n>tableLoadingStartedColumnTitle}" wrapping="false" tooltip="{i18n>tableLoadingStartedColumnTitle}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "StagingAreaGroup", "columnIndex":"6", "leadingProperty": "StagingAreaGroup"}'/>
										</customData>
									</Column>
									<!--Stage Area-->
									<Column>
										<Text text="{i18n>tableLoadingCompletedColumnTitle}" wrapping="false" tooltip="{i18n>tableLoadingCompletedColumnTitle}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "StagingArea", "columnIndex":"7", "leadingProperty": "StagingArea"}'/>
										</customData>
									</Column>
									<!--Staging Bay-->
									<Column >
										<Text text="{i18n>tableArrivalAtCheckpointColumnTitle}" wrapping="false" tooltip="{i18n>tableArrivalAtCheckpointColumnTitle}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "Stabay", "columnIndex":"8", "leadingProperty": "Stabay"}'/>
										</customData>
									</Column>
									<!--Ship To-->
									<Column>
										<Text text="{i18n>tableDepartureFromPointColumnTitle}" wrapping="false" tooltip="{i18n>tableDepartureFromPointColumnTitle}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "ShipTo", "columnIndex":"9", "leadingProperty": "ShipTo"}'/>
										</customData>
									</Column>
									<!--Carrier-->
									<Column>
										<Text text="{i18n>tableGoodIssueStartedColumnTitle}" wrapping="false" tooltip="{i18n>tableGoodIssueStartedColumnTitle}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "Carrier", "columnIndex":"10", "leadingProperty": "Carrier"}'/>
										</customData>
									</Column>
									<!--Loading/Unloading status-->
									<Column>
										<Text text="{i18n>tableGoodIssuePostedColumnTitle}" wrapping="false" tooltip="{i18n>tableGoodIssuePostedColumnTitle}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "StatusLoad", "columnIndex":"11", "leadingProperty": "StatusLoad"}'/>
										</customData>
									</Column>
									<!--GI/GR status-->
									<Column>
										<Text text="{i18n>tableChangeIndicatorColumnTitle}" wrapping="false" tooltip="{i18n>tableChangeIndicatorColumnTitle}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "StatusGm", "columnIndex":"12", "leadingProperty": "StatusGm"}'/>
										</customData>
									</Column>
									<!--Bill Option-->
									<Column>
										<Text text="{i18n>tableActivityStateColumnTitle}" wrapping="false" tooltip="{i18n>tableActivityStateColumnTitle}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "BillingOption", "columnIndex":"13", "leadingProperty": "BillingOption"}'/>
										</customData>
									</Column>
									<!--Document ID-->
									<Column>
										<Text text="{i18n>tableStateOfSRActivityColumnTitle}" wrapping="false" tooltip="{i18n>tableStateOfSRActivityColumnTitle}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "Docid", "columnIndex":"14", "leadingProperty": "Docid"}'/>
										</customData>
									</Column>
									<!--ShipERP Carrier Service ID-->
									<Column>
										<Text text="{i18n>ShipERPCarrierServiceID}" wrapping="false" tooltip="{i18n>ShipERPCarrierServiceID}"/>
										<customData>
											<core:CustomData key="p13nData" value='\{"columnKey": "Service", "columnIndex":"15", "leadingProperty": "Service"}'/>
										</customData>
									</Column>
								</columns>
								<items>
									<ColumnListItem type="Navigation" press="onNavigateDeliveryOrderDetail" vAlign="Middle">
										<cells>
											<!--Document No.-->
											<Link text="{path: 'oModelODOTable>DocumentNo', formatter: '.formatter.validateDocNo'}" press="onDocumentNoPressed"
												tooltip="Document Number"/>
											<!--Doc. Cat.-->
											<Text text="{oModelODOTable>Doccat}"/>
											<!--Doc. Type-->
											<Text text="{oModelODOTable>DocumentType}"/>
											<!--ERP Document-->
											<Text text="{oModelODOTable>ERPDocument}"/>
											<!--Warehouse No.-->
											<Text text="{oModelODOTable>WarehouseNumber}"/>
											<!--Stage Area Group-->
											<Text text="{oModelODOTable>StagingAreaGroup}"/>
											<!--Stage Area-->
											<Text text="{oModelODOTable>StagingArea}"/>
											<!--Staging Bay-->
											<Text text="{oModelODOTable>Stabay}"/>
											<!--Ship To-->
											<Text text="{oModelODOTable>ShipTo}"/>
											<!--Carrier-->
											<Text text="{oModelODOTable>Carrier}"/>
											<!--Loading/Unloading status-->
											<ObjectStatus icon="{path: 'oModelODOTable>StatusLoad', formatter: '.formatter.validateLoadIcon'}"
												state="{path: 'oModelODOTable>StatusLoad', formatter: '.formatter.validateLoadState'}"
												tooltip="{path: 'oModelODOTable>StatusLoad', formatter: '.formatter.validateLoadTooltip'}"/>
											<!--GI/GR status-->
											<ObjectStatus icon="{path: 'oModelODOTable>StatusGm', formatter: '.formatter.validateGI'}"
												state="{path: 'oModelODOTable>StatusGm', formatter: '.formatter.validateGIState'}"
												tooltip="{path: 'oModelODOTable>StatusGm', formatter: '.formatter.validateGITooltip'}"/>
											<!--Bill Option-->
											<Text text="{oModelODOTable>BillingOption}"/>
											<!--Document ID-->
											<Text text="{oModelODOTable>Docid}"/>
											<!--ShipERP Carrier Service ID-->
											<Text text="{oModelODOTable>Service}"/>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</smartTable:SmartTable>
					</ScrollContainer>
				</content>
			</IconTabBar>
		</f:content>
		<f:footer>
			<OverflowToolbar id="otbFooter">
				<Button id="popoverButton" icon="sap-icon://message-popup" text="{messageModel>/messagesLength}" type="Emphasized"
					press="handleMessagePopoverPress"/>
				<ToolbarSpacer/>
				<Button text="{i18n>planButtonText}" id="btnPlanODO" enabled="false" press="onPlanButtonPressed" type="Emphasized"/>
			</OverflowToolbar>
		</f:footer>
	</f:DynamicPage>
</mvc:View>