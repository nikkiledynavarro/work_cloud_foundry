<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog contentWidth="400px" title="Export via Email">
		<content>
			<FlexBox justifyContent="Center" alignItems="Center" class="sapUiSmallMarginTopBottom">
				<MultiInput id="idEmailInput" submit="onSubmit" placeholder="Enter email addresses" showValueHelp="false" width="20rem">
					<core:Item key="{key}" text="{text}"/>
				</MultiInput>
			</FlexBox>
		</content>
		<beginButton>
			<Button text="Send Email" press="onSendEmail" type="Emphasized"/>
		</beginButton>
		<endButton>
			<Button text="Cancel" press="onCancel" type="Reject"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>