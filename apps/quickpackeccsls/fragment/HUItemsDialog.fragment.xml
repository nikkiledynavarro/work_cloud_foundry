<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:form="sap.ui.layout.form">
	<Dialog contentWidth="850px" title="Freight Unit Items" class="sapUiContentPadding">
		<content>
			<Table id="tableHUItem" items="{/HUItem}" class="border_lightgray_nobottom" mode="None">
				<columns>
					<Column width="5rem">
						<Text text="Freight Unit"/>
					</Column>
					<Column width="4.5rem">
						<Text text="Delivery" tooltip="Delivery"/>
					</Column>
					<Column hAlign="Center" width="2rem">
						<Text text="Item"/>
					</Column>
					<Column width="6rem">
						<Text text="Material"/>
					</Column>
					<Column width="6rem">
						<Text text="Description"/>
					</Column>
					<Column width="3rem" hAlign="Center">
						<Text text="Quant" tooltip="Quantity"/>
					</Column>
					<Column width="2.5rem" hAlign="Center">
						<Text text="UOM"/>
					</Column>
					<Column width="4.5rem">
						<Text text="HU No"/>
					</Column>
					<Column width="2rem" hAlign="Center">
						<Text text="Line"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{path:'FREIGHTUNITKEY', formatter:'.formatter.removeLeadingZero'}" wrapping="false" tooltip="{FREIGHTUNITKEY}"/>
							<Text text="{path:'DELIVERY', formatter:'.formatter.removeLeadingZero'}" wrapping="false" tooltip="{DELIVERY}"/>
							<Text text="{path:'DELIVERYITEM', formatter:'.formatter.removeLeadingZero'}" wrapping="false" tooltip="{DELIVERYITEM}"/>
							<Text text="{path:'MATERIAL', formatter:'.formatter.removeLeadingZero'}" wrapping="false" tooltip="{MATERIAL}"/>
							<Text text="{DESCRIPTION}" wrapping="false" tooltip="{DESCRIPTION}"/>
							<Text text="{= parseInt(${QUANTITY}) }"/>
							<Text text="{UOM}"/>
							<Text text="{path:'HU_ID', formatter:'.formatter.removeLeadingZero'}" wrapping="false" tooltip="{HU_ID}"/>
							<Text text="{path:'LINENUMBER', formatter:'.formatter.removeLeadingZero'}" wrapping="false"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<endButton>
			<Button text="{i18n>Close}" press="onCloseHUItemsDialog"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>