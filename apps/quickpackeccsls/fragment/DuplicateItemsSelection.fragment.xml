<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<TableSelectDialog noDataText="No Products Found" title="Quick Pack" search="handleItemSelectionSearch" confirm="onItemsSelectionConfirm"
		cancel="handleClose" items="{path: '/Items', sorter: { path: 'Item', descending: false }}">
		<ColumnListItem>
			<cells>
				<core:Icon src="{parts:['Quantity','Balance'], formatter: '.formatter.statusIcon'}"
					color="{parts:['Quantity','Balance'], formatter: '.formatter.statusColor'}"/>
				<Text text="{path: 'ContentDocumentID', formatter: '.formatter.removeLeadingZero'}" wrapping="false" tooltip="{ContentDocumentID}"/>
				<Text text="{path:'Item', formatter: '.formatter.removeLeadingZero'}" wrapping="false" tooltip="{Item}"/>
				<Text text="{path:'Material', formatter: '.formatter.removeLeadingZero'}" wrapping="false" tooltip="{Material}"/>
				<Text text="{MaterialText}" wrapping="false" tooltip="{MaterialText}"/>
				<Text text="{= parseInt(${Quantity}) }" wrapping="false" tooltip="{Quantity}"/>
				<Text text="{= parseInt(${Balance}) }" wrapping="false" tooltip="{Balance}"/>
				<Text text="{Unit}" wrapping="false" tooltip="{Unit}"/>
				<Text text="{= parseFloat(${UnitPrice}) }" wrapping="false" tooltip="{UnitPrice}"/>
				<Text text="{Currency}" wrapping="false" tooltip="{Currency}"/>
				<Text text="{path:'Weight', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}" wrapping="false"
					tooltip="{Weight}"/>
				<Text text="{path:'NetWeight', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 1}}" wrapping="false"
					tooltip="{NetWeight}"/>
				<Text text="{WeightUnit}" wrapping="false" tooltip="{WeightUnit}"/>
			</cells>
		</ColumnListItem>
		<columns>
			<Column width="2.7rem">
				<Text text="Icon"/>
			</Column>
			<Column width="auto">
				<Text text="Delivery"/>
			</Column>
			<Column width="3.5rem">
				<Text text="Item"/>
			</Column>
			<Column width="5.4rem">
				<Text text="Material"/>
			</Column>
			<Column width="6.5rem" hAlign="Center">
				<Text text="Description" tooltip="Description"/>
			</Column>
			<Column width="auto" hAlign="Center">
				<Text text="Delivery Quantity" tooltip="Delivery Quantity"/>
			</Column>
			<Column width="auto" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
				<Text text="Balance Quantity" tooltip="Balance Quantity"/>
			</Column>
			<Column width="auto" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
				<Text text="SU" tooltip="Sales Unit"/>
			</Column>
			<Column width="auto" hAlign="Left" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
				<Text text="Unit Price" tooltip="Unit Price"/>
			</Column>
			<Column width="auto" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
				<Text text="Currency" tooltip="Currency"/>
			</Column>
			<Column width="auto" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
				<Text text="Weight"/>
			</Column>
			<Column width="auto" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
				<Text text="Net Weight"/>
			</Column>
			<Column width="auto" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
				<Text text="UoM"/>
			</Column>
		</columns>
	</TableSelectDialog>
</core:FragmentDefinition>