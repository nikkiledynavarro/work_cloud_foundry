<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:form="sap.ui.layout.form">
	<Dialog contentWidth="850px" title="Freight Unit Items" class="sapUiContentPadding">
		<content>
			<Table id="tableShipment" fixedLayout="true"
				width="{= ${device>/system/desktop} || (${device>/system/tablet} &amp;&amp; ${device>/orientation/landscape} ) ? 'auto' : 'auto' }"
				items="{path: '/Items', sorter: { path: 'HandlingUnit', descending: false }}" mode="MultiSelect" growing="true" keyboardMode="Edit"
				growingThreshold="99999" class="border_lightgray_nobottom" updateFinished="onHUTableUpdateFinished">
				<columns>
					<Column width="6rem">
						<Text text="HU Unit"/>
					</Column>
					<Column width="auto" hAlign="Center">
						<Text text="Pack Mat." wrapping="false"/>
					</Column>
					<Column hAlign="Center" width="6rem">
						<Text text="Wgt"/>
					</Column>
					<Column hAlign="Center" width="3rem">
						<Text text="UoM"/>
					</Column>
					<Column hAlign="Center" width="6rem">
						<Text text="L"/>
					</Column>
					<Column hAlign="Center" width="6rem">
						<Text text="W"/>
					</Column>
					<Column hAlign="Center" width="6rem">
						<Text text="H"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text  id="idShipmentlink" text="{path:'HandlingUnit', formatter: '.formatter.removeLeadingZero'}" tooltip="{HandlingUnit}" wrapping="false"/>
							<Text text="{PackingMaterial}" tooltip="{PackingMaterial}" wrapping="false"/>
							<Input type="Number" value="{path: 'Weight'}" change="onGoToWidthColumn" submit="onGoNextLineItem"
								tooltip="{path: 'Weight', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 3}}"></Input>
							<Text text="{WeightUnit}"/>
							<Input type="Number" value="{path: 'Length'}" change="onGoToWidthColumn" submit="onGoNextLineItem"
								tooltip="{path: 'Length', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 3}}"></Input>
							<Input type="Number" value="{path: 'Width'}" change="onGoToWidthColumn" submit="onGoNextLineItem"
								tooltip="{path: 'Width', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 3}}"></Input>
							<Input type="Number" value="{path: 'Height'}" change="onGoToWidthColumn" submit="onGoNextLineItem"
								tooltip="{path: 'Height', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 3}}"></Input>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<buttons>
			<Button text="{i18n>Close}" press="onCloseShipmenttemsDialog"/>
			<Button text="{i18n>Continue}" press="onCreateShipmentPress"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>