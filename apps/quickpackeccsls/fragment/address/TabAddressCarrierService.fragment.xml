<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
		adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="3" columnsL="2" columnsM="2"
		singleContainerFullSize="false">
		<f:content>
			<core:Title text="CARRIER"></core:Title>
			<Label text="{i18n>Carrier}"/>
			<ComboBox id="cbCarrier" selectionChange="onCarrierChange" items="{local>/CarrierListSet}" selectedKey="{local>/Basic/Carrier}"
				enabled="{= !${local>/isAllTrackShipped} ? true : false}">
				<core:Item key="{local>Code}" text="{local>Description}"></core:Item>
			</ComboBox>
			<core:Title text="SERVICE"></core:Title>
			<Label text="{i18n>Service}"/>
			<ComboBox id="selectService" selectedKey="{local>/Basic/Service}" selectionChange="onServiceChange"
				enabled="{= !${local>/isAllTrackShipped} ? true : false}"></ComboBox>
		</f:content>
	</f:SimpleForm>
</core:FragmentDefinition>