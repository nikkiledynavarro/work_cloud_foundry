<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
		adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="3" columnsL="2" columnsM="2"
		singleContainerFullSize="false">
		<f:content>
			<core:Title text="Customer Info"></core:Title>
			<Label text="Name/Attention"/>
			<Input enabled="{= !${local>/isAllTrackShipped} ? true : false}" placeholder="Name" tooltip="Name" value="{local>/Address/SOLDTO/name1}"></Input>
			<Input enabled="{= !${local>/isAllTrackShipped} ? true : false}" placeholder="Attention" tooltip="Attention"
				value="{local>/Address/SOLDTO/name2}"></Input>
			<Label text="Address 1/2"/>
			<Input enabled="{= !${local>/isAllTrackShipped} ? true : false}" placeholder="Address 1" tooltip="Address 1"
				value="{local>/Address/SOLDTO/stras}"></Input>
			<Input enabled="{= !${local>/isAllTrackShipped} ? true : false}" placeholder="Address 2" tooltip="Address 2"
				value="{local>/Address/SOLDTO/stras}"></Input>
			<Label text="Address 3/4"/>
			<Input enabled="{= !${local>/isAllTrackShipped} ? true : false}" placeholder="Address 3" tooltip="Address 3"
				value="{local>/Address/SOLDTO/stras}"></Input>
			<Input enabled="{= !${local>/isAllTrackShipped} ? true : false}" placeholder="Address 4" tooltip="Address 4"
				value="{local>/Address/SOLDTO/stras}"></Input>
			<Label text="Phone/Fax"/>
			<Input enabled="{= !${local>/isAllTrackShipped} ? true : false}" placeholder="Phone" tooltip="Phone" value="{local>/Address/SOLDTO/telf1}"></Input>
			<Input enabled="{= !${local>/isAllTrackShipped} ? true : false}" placeholder="Fax" tooltip="Fax" value="{local>/Address/SOLDTO/telfx}"></Input>
			<core:Title text="Location"></core:Title>
			<Label text="Country"/>
			<ComboBox selectedKey="{local>/Address/SOLDTO/land1}" tooltip="Country" items="{path: '/xSERPERPxI_PCCNTR', length: 999}"
				enabled="{= !${local>/isAllTrackShipped} ? true : false}" app:nextUpdate="slSoldToState">
				<items>
					<core:Item text="{Name}" key="{Country}"/>
				</items>
			</ComboBox>
			<Label text="Region"></Label>
			<ComboBox id="slSoldToState" tooltip="State" change="onUpdateDomestic" selectedKey="{local>/Address/SOLDTO/regio}"
				enabled="{= !${local>/isAllTrackShipped} ? true : false}" items="{path: '/xSERPERPxI_PCSTATE', length: 999}">
				<items>
					<core:Item text="{Description}" key="{Region}"/>
				</items>
			</ComboBox>
			<Label text="City"/>
			<Input enabled="{= !${local>/isAllTrackShipped} ? true : false}" placeholder="City" value="{local>/Address/SOLDTO/ort01}"></Input>
			<Label text="Postal"/>
			<Input enabled="{= !${local>/isAllTrackShipped} ? true : false}" placeholder="Postal Code" value="{local>/Address/SOLDTO/pstlz}"/>
		</f:content>
	</f:SimpleForm>
</core:FragmentDefinition>