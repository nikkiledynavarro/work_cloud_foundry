<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:table="sap.ui.table">
	<Dialog title="Close" class="sapUiContentPadding" stretch="true">
		<content>
			<table:Table selectionMode="MultiToggle" enableCellFilter="true" rows="{local>/CloseSet}" id="idCloseTabDlg">
				<table:columns>
					<table:Column filterProperty="CarrierCode" sortProperty="CarrierCode">
						<Label text="{i18n>Carrier}"/>
						<table:template>
							<Text text="{local>CarrierCode}" wrapping="false" textAlign="Center"/>
						</table:template>
					</table:Column>
					<table:Column filterProperty="ShippingPoint" sortProperty="ShippingPoint">
						<Label text="{i18n>ShippingPoint}"/>
						<table:template>
							<Text text="{local>ShippingPoint}" wrapping="false" textAlign="Center"/>
						</table:template>
					</table:Column>
					<table:Column sortProperty="Trackingnum" filterProperty="Trackingnum">
						<Label text="{i18n>TrackNo}"/>
						<table:template>
							<Text text="{local>Trackingnum}" wrapping="false"/>
						</table:template>
					</table:Column>
					<table:Column filterProperty="Mastertrack" sortProperty="Mastertrack">
						<Label text="{i18n>MasterTrackNo}"/>
						<table:template>
							<Text text="{local>Mastertrack}" wrapping="false"/>
						</table:template>
					</table:Column>
					<table:Column filterProperty="ReferenceShipPoint" sortProperty="ReferenceShipPoint">
						<Label text="{i18n>RefShippingPoint}"/>
						<table:template>
							<Text text="{local>ReferenceShipPoint}" wrapping="false" textAlign="Center"/>
						</table:template>
					</table:Column>
					<table:Column sortProperty="AccountNo" filterProperty="AccountNo">
						<Label text="{i18n>Account}"/>
						<table:template>
							<Text text="{local>AccountNo}" wrapping="false" textAlign="Center"/>
						</table:template>
					</table:Column>
					<table:Column sortProperty="Hold" filterProperty="Hold">
						<Label text="{i18n>Hold}"/>
						<table:template>
							<core:Icon src="{= ${local>Hold} === true ? 'sap-icon://accept': 'sap-icon://decline' }"
								color="{= ${local>Hold} === true ? 'green': 'red' }"/>
						</table:template>
					</table:Column>
					<table:Column filterProperty="Shipdate" sortProperty="Shipdate">
						<Label text="{i18n>ShipDate}"/>
						<table:template>
							<Text text="{path: 'local>Shipdate', fomatter: '.formatter.formatDateString'}" wrapping="false"/>
						</table:template>
					</table:Column>
					<table:Column sortProperty="Service" filterProperty="Service">
						<Label text="{i18n>Service}"/>
						<table:template>
							<Text text="{local>Service}" wrapping="false" textAlign="Center"/>
						</table:template>
					</table:Column>
					<table:Column filterProperty="Breakbulk" sortProperty="Breakbulk">
						<Label text="{i18n>IsBreakBulk}"/>
						<table:template>
							<core:Icon src="{= ${local>Breakbulk} === true ? 'sap-icon://accept': 'sap-icon://decline' }"
								color="{= ${local>Breakbulk} === true ? 'green': 'red' }"/>
						</table:template>
					</table:Column>
				</table:columns>
			</table:Table>
		</content>
		<beginButton>
			<Button press="onConfirmCloseDialog" text="Confirm" type="Emphasized"/>
		</beginButton>
		<endButton>
			<Button press="onCloseCloseDialog" text="Close"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>