<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Dialog title="{i18n>naftaDialogTitle}" class="sapUiContentPadding" contentWidth="800px">
		<content>
			<VBox class="sapUiSmallMargin">
				<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="4"
					adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1"
					singleContainerFullSize="false">
					<f:content>
						<Label text="Blanket Period from/to"/>
						<DatePicker value="{local>/basic/international/forms/blanket_from}" valueFormat="yyyyMMdd" displayFormat="MM/dd/yyyy"></DatePicker>
						<DatePicker value="{local>/basic/international/forms/blanket_to}" valueFormat="yyyyMMdd" displayFormat="MM/dd/yyyy"></DatePicker>
						<Label text="Importer Specifiction"/>
						<ComboBox selectedKey="{local>/basic/international/forms/importer_spec}" showSecondaryValues="true"
							items="{path: '/DomainTextSet', filters: [ {path: 'Domain', operator: 'EQ', value1: '/ERPIS/DOM_NAFTA_IMPORTER_SP'} ]}">
							<core:ListItem key="{Key}" text="{Description}" additionalText="{Key}"/>
						</ComboBox>
						<Label text="Producer Specification"/>
						<ComboBox selectedKey="{local>/basic/international/forms/producer_spec}" showSecondaryValues="true"
							items="{path: '/DomainTextSet', filters: [ {path: 'Domain', operator: 'EQ', value1: '/ERPIS/DOM_NAFTA_PRODUCER_SP'} ]}">
							<core:ListItem key="{Key}" text="{Description}" additionalText="{Key}"/>
						</ComboBox>
						<core:Title text="Signatory"/>
						<Label text="Contact ID"/>
						<Input value="{local>/basic/international/forms/contact_id}"/>
						<Label text="Name"/>
						<Input value="{local>/basic/international/forms/person_name}"/>
						<Label text="Title"/>
						<Input value="{local>/basic/international/forms/title}"/>
						<Label text="Company Name"/>
						<Input value="{local>/basic/international/forms/company_name}"/>
						<Label text="Telephone no./Ext"/>
						<Input value="{local>/basic/international/forms/phone_number}" type="Tel"/>
						<Input value="{local>/basic/international/forms/phone_extension}" type="Tel">
							<layoutData>
								<l:GridData span="XL2 L1 M3 S4"/>
							</layoutData>
						</Input>
						<Label text="Fax Number"/>
						<Input value="{local>/basic/international/forms/fax_number}" type="Tel"/>
						<Label text="E-Mail Address"/>
						<Input value="{local>/basic/international/forms/email_address}" type="Email"/>
					</f:content>
				</f:SimpleForm>
			</VBox>
			<Table mode="None" class="border_lightgray_nobottom" showSeparators="All" growing="false" items="{local>/NaftaDetailSet}">
				<headerToolbar>
					<Toolbar>
						<content>
							<Title text="{i18n>naftaTabTitle}" level="H2"/>
							<ToolbarSpacer/>
							<SearchField placeholder="Search..." width="10rem"/>
						</content>
					</Toolbar>
				</headerToolbar>
				<columns>
					<Column>
						<Text text="{i18n>Code}"/>
					</Column>
					<Column>
						<Text text="{i18n>Criterion}" tooltip="{i18n>naftaCriterion}"/>
					</Column>
					<Column>
						<Text text="{i18n>Producer}" tooltip="{i18n>producerDet}"/>
					</Column>
					<Column>
						<Text text="{i18n>prodid}" tooltip="{i18n>producerid}"/>
					</Column>
					<Column>
						<Text text="{i18n>netcost}"/>
					</Column>
				</columns>
				<items >
					<ColumnListItem type="Active">
						<cells>
							<Input value="{local>Stawn}" editable="true"/>
							<ComboBox showSecondaryValues="true" selectedKey="{local>Criterion}"
								items="{path: '/DomainTextSet', filters: [ {path: 'Domain', operator: 'EQ', value1: '/ERPIS/DOM_CRITERION'} ], length:999}">
								<items>
									<core:ListItem key="{Key}" text="{Key}" additionalText="{Description}"/>
								</items>
							</ComboBox>
							<ComboBox showSecondaryValues="true" selectedKey="{local>ProducerDet}"
								items="{path: '/DomainTextSet', filters: [ {path: 'Domain', operator: 'EQ', value1: '/ERPIS/DOM_PRODUCER_DET'} ], length:999}">
								<items>
									<core:ListItem key="{Key}" text="{Key}" additionalText="{Description}"/>
								</items>
							</ComboBox>
							<Input value="{local>ProducerId}" editable="true"/>
							<ComboBox showSecondaryValues="true" selectedKey="{local>NetcostMethod}"
								items="{path: '/DomainTextSet', filters: [ {path: 'Domain', operator: 'EQ', value1: '/ERPIS/DOM_NETCOST_METHOD'} ], length:999}">
								<items>
									<core:ListItem key="{Key}" text="{Key}" additionalText="{Description}"/>
								</items>
							</ComboBox>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<endButton>
			<Button press="onCloseNAFTAialog" text="Close"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>