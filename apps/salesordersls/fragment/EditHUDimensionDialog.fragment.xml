<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:form="sap.ui.layout.form">
	<Dialog title="Update Dimension" state="Success">
		<content>
			<form:Form width="100%" editable="true" visible="true">
				<form:formContainers>
					<form:FormContainer visible="true">
						<form:formElements>
							<form:FormElement visible="true">
								<form:label>
									<Label text="{i18n>HU}"/>
								</form:label>
								<form:fields>
									<Input value="{global>Exidv}" editable="false"/>
								</form:fields>
							</form:FormElement>
							<form:FormElement visible="true">
								<form:label>
									<Label text="{i18n>Length}"/>
								</form:label>
								<form:fields>
									<Input value="{global>Laeng}"/>
								</form:fields>
							</form:FormElement>
							<form:FormElement visible="true">
								<form:label>
									<Label text="{i18n>Width}"/>
								</form:label>
								<form:fields>
									<Input value="{global>Breit}"/>
								</form:fields>
							</form:FormElement>
							<form:FormElement visible="true">
								<form:label>
									<Label text="{i18n>Height}"/>
								</form:label>
								<form:fields>
									<Input value="{global>Hoehe}"/>
								</form:fields>
							</form:FormElement>
							<form:FormElement visible="true">
								<form:label>
									<Label text="Dim Unit"/>
								</form:label>
								<form:fields>
									<Input value="{global>Meabm}"/>
								</form:fields>
							</form:FormElement>
							<form:FormElement visible="true">
								<form:label>
									<Label text="Weight"/>
								</form:label>
								<form:fields>
									<Input value="{global>Brgew}"/>
								</form:fields>
							</form:FormElement>
							<form:FormElement visible="true">
								<form:label>
									<Label text="Weight Unit"/>
								</form:label>
								<form:fields>
									<Input value="{global>Gewei}"/>
								</form:fields>
							</form:FormElement>
						</form:formElements>
						<form:title/>
					</form:FormContainer>
				</form:formContainers>
				<form:layout>
					<form:ResponsiveGridLayout adjustLabelSpan="false" columnsL="2" labelSpanL="3" columnsM="1" labelSpanM="2" labelSpanS="12"/>
				</form:layout>
			</form:Form>
		</content>
		<beginButton>
			<Button text="{i18n>OK}" type="Emphasized" press="onConfirmUpdateHUDimension"/>
		</beginButton>
	</Dialog>
</core:FragmentDefinition>