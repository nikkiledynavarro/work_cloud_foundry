<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Dialog title="{i18n>validateSmtpAddrDialogTitle}" class="sapUiContentPadding" contentWidth="800px">
		<content>
			<FlexBox width="100%">
				<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
					adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="3" columnsL="2" columnsM="2"
					singleContainerFullSize="false">
					<f:content>
						<core:Title text="{i18n>originalAddress}" level="H2"/>
						<Label text="Name/Attention"/>
						<Input placeholder="Name" tooltip="Name" value="{global>/AddressOriginal/Name1}" editable="false"/>
						<Input placeholder="Attention" tooltip="Attention" value="{global>/AddressOriginal/Name2}" editable="false"></Input>
						<Label text="Address 1/2"/>
						<Input placeholder="Address 1" tooltip="Address 1" value="{global>/AddressOriginal/Stras}" editable="false"></Input>
						<Input placeholder="Address 2" tooltip="Address 2" value="{global>/AddressOriginal/Strs2}" editable="false"></Input>
						<Label text="Address 3/4"/>
						<Input placeholder="Address 3" tooltip="Address 3" value="{global>/AddressOriginal/StrSuppl2}" editable="false"></Input>
						<Input placeholder="Address 4" tooltip="Address 4" value="{global>/AddressOriginal/StrSuppl3}" editable="false"></Input>
						<Label text="Customer"/>
						<Input placeholder="Customer ID" tooltip="Customer ID" value="{global>/basic/partners/shipto/Customerid}" editable="false"></Input>
						<Input placeholder="ESmtpAddr" tooltip="ESmtpAddr" value="{global>/AddressOriginal/eSmtpAddr}" editable="false"></Input>
						<Label text="Phone/Fax"></Label>
						<Input placeholder="Phone" tooltip="Phone" value="{global>/AddressOriginal/Telf1}" editable="false"></Input>
						<Input placeholder="Fax" tooltip="Fax" value="{global>/AddressOriginal/Telfx}" editable="false"></Input>
						<Label text="Fed/State TaxID"/>
						<Input placeholder="Fed TaxID" tooltip="Fed TaxID" value="{global>/basic/partners/shipto/FedTaxId}" editable="false"></Input>
						<Input placeholder="State TaxID" tooltip="State TaxID" value="{global>/basic/partners/shipto/StateTaxId}" editable="false"></Input>
						<Label text="Country"/>
						<Input placeholder="Country" value="{global>/AddressOriginal/Land1}" editable="false"></Input>
						<Label text="Region"></Label>
						<Input placeholder="State" value="{global>/AddressOriginal/Regio}" editable="false"></Input>
						<Label text="City"/>
						<Input placeholder="City" value="{global>/AddressOriginal/Ort01}" editable="false"></Input>
						<Label text="Postal"/>
						<Input placeholder="Postal Code" value="{global>/AddressOriginal/Pstlz}" editable="false"/>
						<Label></Label>
						<CheckBox text="Related Party" selected="{global>/basic/partners/shipto/related_party}" editable="false"/>
						<Label></Label>
					</f:content>
				</f:SimpleForm>
				<!--second form-->
				<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
					adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="3" columnsL="2" columnsM="2"
					singleContainerFullSize="false">
					<f:content>
						<core:Title text="{i18n>newAddressFormTitle}" level="H2"/>
						<Label text="Name/Attention"/>
						<Input placeholder="Name" tooltip="Name" value="{global>/NewAddress/Name1}" editable="false"></Input>
						<Input placeholder="Attention" tooltip="Attention" value="{global>/NewAddress/Name2}" editable="false"></Input>
						<Label text="Address 1/2"/>
						<Input placeholder="Address 1" tooltip="Address 1" value="{global>/NewAddress/Stras}" editable="false"></Input>
						<Input placeholder="Address 2" tooltip="Address 2" value="{global>/NewAddress/Strs2}" editable="false"></Input>
						<Label text="Address 3/4"/>
						<Input placeholder="Address 3" tooltip="Address 3" value="{global>/NewAddress/StrSuppl2}" editable="false"></Input>
						<Input placeholder="Address 4" tooltip="Address 4" value="{global>/NewAddress/StrSuppl3}" editable="false"></Input>
						<Label text="Customer"/>
						<Input placeholder="Customer ID" tooltip="Customer ID" value="{global>/NewAddress/Customerid}" editable="false"></Input>
						<Input placeholder="ESmtpAddr" tooltip="ESmtpAddr" value="{global>/NewAddress/eSmtpAddr}" editable="false"></Input>
						<Label text="Phone/Fax"></Label>
						<Input placeholder="Phone" tooltip="Phone" value="{global>/NewAddress/Telf1}" editable="false"></Input>
						<Input placeholder="Fax" tooltip="Fax" value="{global>/NewAddress/Telfx}" editable="false"></Input>
						<Label text="Fed/State TaxID"/>
						<Input placeholder="Fed TaxID" tooltip="Fed TaxID" value="{global>/NewAddress/FedTaxId}" editable="false"></Input>
						<Input placeholder="State TaxID" tooltip="State TaxID" value="{global>/NewAddress/StateTaxId}" editable="false"></Input>
						<Label text="Country"/>
						<Input value="{global>/NewAddress/Land1}" editable="false"/>
						<Label text="Region"></Label>
						<Input value="{global>/NewAddress/Regio}" editable="false"/>
						<Label text="City"/>
						<Input placeholder="City" value="{global>/NewAddress/Ort01}" editable="false"></Input>
						<Label text="Postal"/>
						<Input placeholder="Postal Code" value="{global>/NewAddress/Pstlz}" editable="false"/>
						<Label></Label>
						<CheckBox text="Related Party" selected="{global>/NewAddress/related_party}" editable="false"/>
					</f:content>
				</f:SimpleForm>
			</FlexBox>
		</content>
		<beginButton>
			<Button text="Confirm" press="onValidateAddressConfirmPress" type="Emphasized"/>
		</beginButton>
		<endButton>
			<Button press="onValidateEmailDialogClose" text="Close"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>