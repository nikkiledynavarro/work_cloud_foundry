<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns:layout="sap.ui.layout" xmlns:forms="sap.ui.layout.form"
	xmlns="sap.m" xmlns:l="sap.ui.layout">
	<FlexBox width="100%" justifyContent="SpaceBetween" wrap="Wrap">
		<forms:SimpleForm class="border_lightgray sapUiSmallMarginBottom" width="auto" editable="true">
			<forms:layoutData>
				<FlexItemData growFactor="1"></FlexItemData>
			</forms:layoutData>
			<forms:toolbar>
				<Toolbar>
					<Title text="Carrier"/>
					<ToolbarSpacer/>
					<Button icon="sap-icon://restart" tooltip="Analysis" press="onShowCarrierAnalysisDetail" type="Ghost" enabled="{=${global>Delivery} === ''}"/>
					<Button icon="sap-icon://action" tooltip="More Options" press="onMoreOption" type="Ghost" enabled="{=${global>Delivery} === ''}"/>
					<ToolbarSeparator/>
					<Button icon="sap-icon://reset" tooltip="Reset" press="onReset" type="Ghost" enabled="{=${global>Delivery} === ''}"/>
				</Toolbar>
			</forms:toolbar>
			<Label text="Carrier / Service"/>
			<ComboBox id="idCarrierCombo" selectedKey="{global>Carrier}" items="{global>/CarrierListSet}" showSecondaryValues="true"
				selectionChange="onCarrierSelectionChange" enabled="{=${global>Delivery} === ''}">
				<core:ListItem key="{global>Code}" text="{global>Description}" additionalText="{global>Code}"/>
			</ComboBox>
			<ComboBox id="idServiceCombo" selectedKey="{global>Service}" items="{global>/ServiceListSet}" showSecondaryValues="true"
				selectionChange="onChangeService" enabled="{=${global>Delivery} === ''}">
				<core:ListItem key="{global>Service}" text="{global>Description}" additionalText="{global>Service}"/>
			</ComboBox>
			<Label text="Payment Type"/>
			<ComboBox selectedKey="{global>Billoption}" items="{/xSERPERPxCDS_BILLOPT}" showSecondaryValues="true"
				selectionChange="onBillOptDeterminationChange" enabled="{=${global>Delivery} === ''}">
				<core:ListItem key="{Code}" text="{Description}" additionalText="{Code}"/>
			</ComboBox>
			<CheckBox text="PPaid &amp; Add" selected="{global>Ppaidadd}"
				enabled="{= (${global>Billoption} === 'PPAID' &amp;&amp; ${global>Delivery} === '') ? true : false }" select="onChangePrepaidIndicator"/>
			<Label text="3PD/COL Acc No"/>
			<Input value="{global>Tpacct}" submit="on3PartyChange" enabled="{=${global>Delivery} === ''}"
				editable="{= (${global>Billoption} === '3PRTY' || ${global>Billoption} === 'COLL') ? true : false }"/>
			<Label text="3PD/COL Zip/Ctry"/>
			<Input value="{global>Tpzip}" submit="on3PartyChange" enabled="{=${global>Delivery} === ''}"
				editable="{= (${global>Billoption} === '3PRTY' || ${global>Billoption} === 'COLL') ? true : false }"/>
			<ComboBox selectedKey="{global>Tpctry}" editable="{= (${global>Billoption} === '3PRTY' || ${global>Billoption} === 'COLL') ? true : false }"
				tooltip="Country" items="{path: '/xSERPERPxI_PCCNTR', length: 999}" selectionChange="on3PartyChange" enabled="{=${global>Delivery} === ''}">
				<items>
					<core:Item text="{Name}" key="{Country}"/>
				</items>
			</ComboBox>
			<Label text="Insurance Type"/>
			<ComboBox selectedKey="{global>Instype}" items="{/xSERPERPxI_INSRN}" showSecondaryValues="true" selectionChange="onInsuranceTypeChange"
				enabled="{=${global>Delivery} === ''}">
				<core:ListItem key="{InsuranceType}" text="{Description}" additionalText="{InsuranceType}"/>
			</ComboBox>
			<Label text="Insurance Value/Curr"/>
			<Input value="{global>Insvalue}" submit="onInsuranceValueChange" editable="{= ${global>Instype} !== '01' ? true : false }"
				enabled="{=${global>Delivery} === ''}"/>
			<Input value="{global>Inscurr}" submit="onInsuranceValueChange" editable="{= ${global>Instype} !== '01' ? true : false }"
				enabled="{=${global>Delivery} === ''}"/>
		</forms:SimpleForm>
		<List width="auto" backgroundDesign="Transparent" headerText="Indicators" class="border_lightgray_nobottom">
			<layoutData>
				<FlexItemData growFactor="1"></FlexItemData>
			</layoutData>
			<InputListItem label="Manual Selection">
				<Switch enabled="false" state="{global>Manupd}"/>
			</InputListItem>
			<InputListItem label="Manual Selection (3PD/Col)">
				<Switch enabled="false" state="{global>ManupdA}"/>
			</InputListItem>
			<InputListItem label="Manual Selection Bill Option">
				<Switch enabled="false" state="{global>ManupdBopt}"/>
			</InputListItem>
			<InputListItem label="Manual Selection PPaid">
				<Switch enabled="false" state="{global>ManupdP}"/>
			</InputListItem>
			<InputListItem label="Rate Quote Selection">
				<Switch enabled="false" state="{global>Rqupd}"/>
			</InputListItem>
			<InputListItem label="Saturday Delivery">
				<Switch enabled="false" state="{global>Satdeliv}"/>
			</InputListItem>
			<InputListItem label="Allow Consignee Biling">
				<Switch enabled="false" state="{global>Allowcons}"/>
			</InputListItem>
			<InputListItem label="Residential Delivery">
				<Switch enabled="false" state="{global>Resident}"/>
			</InputListItem>
			<InputListItem label="Drop Ship">
				<Switch enabled="false" state="{global>Dropship}"/>
			</InputListItem>
			<InputListItem label="Insurance Manual Update">
				<Switch enabled="false" state="{global>Insmanupd}"/>
			</InputListItem>
			<InputListItem label="Freight Forwarder">
				<Switch enabled="{=${global>Delivery} === ''}" state="{global>Frtfwd}"/>
			</InputListItem>
		</List>
	</FlexBox>
</core:FragmentDefinition>