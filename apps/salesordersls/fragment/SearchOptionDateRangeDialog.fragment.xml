<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form"
	xmlns:table="sap.ui.table">
	<Dialog title="Input DateRange for Select Search Option" showHeader="true" state="Success">
		<FlexBox height="auto" alignItems="Start" justifyContent="Center">
			<items>
				<DateRangeSelection width="auto" displayFormat="MM/dd/yyyy" change="onInputDateRangeSearchOptDlgChange" id="idInputDateRangeSearchOptDlg"
					enabled="true" class="sapUiTinyMarginBottom sapUiTinyMarginTop"/>
			</items>
		</FlexBox>
		<beginButton>
			<Button text="OK" press="onFillInputDateRangeSearchOptDlg" type="Emphasized"/>
		</beginButton>
		<!--<endButton>-->
		<!--	<Button text="Close" press="onFilterOptionClose"/>-->
		<!--</endButton>-->
	</Dialog>
</core:FragmentDefinition>