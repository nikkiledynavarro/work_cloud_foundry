<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form"
	xmlns:table="sap.ui.table">
	<Dialog title="Select Sales Area" contentWidth="400px" showHeader="true" state="Success">
		<SearchField width="auto" liveChange="onSalesOrderTypeSearch" id="salesAreaSearch" placeholder="Enter Sales Order Type"
			class="sapUiTinyMargin"/>
		<table:Table id="salesAreaTable" rows="{ path : '/xSERPERPxI_AUART', sorter : { path : 'SalesDocType', descending : false } }"
			selectionMode="Single" selectionBehavior="RowOnly" rowSelectionChange="onSalesAreaConfirm">
			<table:columns>
				<table:Column sortProperty="SalesDocType" filterProperty="SalesDocType" filterOperator="EQ" width="5rem" hAlign="Center">
					<Label text="Doc Type"/>
					<table:template>
						<Text text="{SalesDocType}" wrapping="true"/>
					</table:template>
				</table:Column>
				<table:Column sortProperty="SalesOrg" filterProperty="SalesOrg" hAlign="Center">
					<Label text="Sales Org"/>
					<table:template>
						<Text text="{SalesOrg}" wrapping="true"/>
					</table:template>
				</table:Column>
				<table:Column sortProperty="DistChannel" filterProperty="DistChannel" width="7rem" hAlign="Center">
					<Label text="Dist. Channel"/>
					<table:template>
						<Text text="{DistChannel}" wrapping="true"/>
					</table:template>
				</table:Column>
				<table:Column sortProperty="Division" filterProperty="Division" width="5rem" hAlign="Center">
					<Label text="Division"/>
					<table:template>
						<Text text="{Division}" wrapping="true"/>
					</table:template>
				</table:Column>
			</table:columns>
		</table:Table>
		<endButton>
			<Button text="Close" press="onSalesAreaClose"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>