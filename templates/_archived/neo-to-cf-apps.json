{
  "mtaId": "shiperp-fiori-neo-migration",
  "mtaDescription": "Migrated ShipERP Neo HTML5 applications for SAP BTP Cloud Foundry.",
  "ui5Version": "1.125.1",
  "defaultDestination": "virtual-hr7-destination",
  "apps": [
    {
      "enabled": true,
      "neoZip": "acesubmitfiling.zip",
      "appName": "submitacefiling",
      "title": "Submit ACE Filing",
      "description": "ShipERP - Submit ACE Filing",
      "oldNamespace": "com.erpis.shiperp.ACESubmitFiling",
      "newNamespace": "com.erpis.shiperp.submitacefiling",
      "sapCloudService": "comerpisshiperpsubmitacefiling",
      "semanticObject": "SubmitACEFiling",
      "action": "display",
      "subTitle": "ShipERP",
      "icon": "sap-icon://task",
      "destinationName": "virtual-hr7-destination",
      "odataPath": "/sap/opu/odata/serperp/ace_srv/",
      "routes": [
        {
          "source": "^/?sap/opu/odata/(.*)$",
          "target": "/sap/opu/odata/$1",
          "destination": "virtual-hr7-destination"
        }
      ]
    }
  ]
}
